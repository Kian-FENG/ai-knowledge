<script>

function submitsearch(){
  var result = $("#textfield").val();
  result = $.trim(result); 
  var reg = /[`~!@#$%^&*_+<>{}\/'[\]]/im;
 
  if (result == "请输入搜索内容" || result == "" || result == null) {
    window.wxc.xcConfirm('请输入检索条件!', window.wxc.xcConfirm.typeEnum.info)
    return false;
  } else {
    result = result.replace("-", "\-");
    result = result.replace("(", "\(");
    result = result.replace(")", "\)");
  }


window.location.href=  "//dsjj.cq.gov.cn/cqs/searchResultPC.html?tenantId=52&configTenantId=52&areaCode=500000147&searchWord=" + encodeURI(result);

  //window.location.href="//dsjj.cq.gov.cn/cq/index.html?sitecode=6fb334585cc44a40b2829f8a6ae3b75b&siteid=82&keyWork=" + encodeURI(result);
}
</script>
