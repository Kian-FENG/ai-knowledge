initAft()</script><script class="ds:0" nonce="wrk17PnNnbD0bvtz7dqgXw">AF_initDataCallback({key: 'ds:0', hash: '1', data:[["Using BigQuery’s generative AI cost management features","Token-based cost management for BigQuery generative AI functions lets you set daily quotas on AI token consumption so you can keep within your budget.",[1792018800],"https://storage.googleapis.com/gweb-cloudblog-publish/images/09_-_Data_Analytics_tFH57V6.max-2600x2600.jpg","https://cloud.google.com/blog/products/data-analytics/using-bigquerys-generative-ai-cost-management-features",[1792018807,740526000],"blog.articlepage",null,"/api/w_v2/pages/59756/","using-bigquerys-generative-ai-cost-management-features",59756],[["Tushar Jaiswal","Software Engineer"],["Alicia Williams","Developer Advocate"]],[null,"\u003cscript type\u003d\"application/ld+json\"\u003e{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"@id\":\"https://cloud.google.com/blog/products/data-analytics/using-bigquerys-generative-ai-cost-management-features\",\"headline\":\"Using BigQuery’s generative AI cost management features\",\"description\":\"Token-based cost management for BigQuery generative AI functions lets you set daily quotas on AI token consumption so you can keep within your budget.\",\"image\":\"https://storage.googleapis.com/gweb-cloudblog-publish/images/09_-_Data_Analytics_tFH57V6.max-2600x2600.jpg\",\"author\":[{\"@type\":\"Person\",\"name\":\"Tushar Jaiswal\",\"url\":\"\"},{\"@type\":\"Person\",\"name\":\"Alicia Williams\",\"url\":\"\"}],\"datePublished\":\"2026-10-14\",\"publisher\":{\"@type\":\"Organization\",\"name\":\"Google Cloud\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.gstatic.com/cgc/google-cloud-logo.svg\"}},\"url\":\"https://cloud.google.com/blog/products/data-analytics/using-bigquerys-generative-ai-cost-management-features\",\"keywords\":[\"Data Analytics\",\"AI \\u0026 Machine Learning\",\"BigQuery\"],\"timeRequired\":\"PT9M\"}\u003c/script\u003e"],["Predictable AI spend in BigQuery: Introducing cost management for generative AI functions"],null,null,[[null,null,[null,[null,"\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eThe \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/generative-ai-overview\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003egenerative AI functions in BigQuery\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e (\u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eAI.GENERATE\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eAI.IF\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eAI.CLASSIFY\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eAI.SCORE\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, and more) bring large language models (LLMs) directly into your SQL, so a single query can classify millions of support tickets or score each product review for sentiment. However, because these functions are billed by the token, scaling them across massive datasets highlights the importance of managing your budget proactively. \u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eWe recently announced the general availability (GA) of \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003etoken-based \u003c/strong\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/control-genai-costs\"\u003e\u003cstrong style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003ecost management\u003c/strong\u003e\u003c/a\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e for BigQuery generative AI functions\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e: daily quotas that let administrators set self-serve guardrails on AI token consumption, so teams can innovate while staying within your budget. In this blog, we provide an overview of cost management for BigQuery generative AI functions, walk through a few practical examples, and share resources to help you get started. Let’s jump in.  \u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eQuotas for managing costs\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eFour daily quotas, managed through the Google Cloud Identity and Access Management (IAM) quota system, provide controls at the \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eproject\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e level and the \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eper-user\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e level. Per-user limits apply to each user within a project, not across your organization.\u003cbr\u003e\u003cbr\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cdiv align\u003d\"left\"\u003e\n\u003cdiv style\u003d\"color:#5f6368;overflow-x:auto;overflow-y:hidden;width:100%\"\u003e\n\u003cdiv style\u003d\"color:#5f6368;overflow-x:auto;overflow-y:hidden;width:100%\"\u003e\n\u003cdiv style\u003d\"color:#5f6368;overflow-x:auto;overflow-y:hidden;width:100%\"\u003e\n\u003cdiv style\u003d\"color:#5f6368;overflow-x:auto;overflow-y:hidden;width:100%\"\u003e\n\u003cdiv style\u003d\"color:#5f6368;overflow-x:auto;overflow-y:hidden;width:100%\"\u003e\n\u003cdiv style\u003d\"color:#5f6368;overflow-x:auto;overflow-y:hidden;width:100%\"\u003e\u003ctable\u003e\u003ccolgroup\u003e\u003ccol\u003e\u003ccol\u003e\u003ccol\u003e\u003ccol\u003e\u003c/colgroup\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eQuota name\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eMetric\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eScope\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003cth style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eDefault value\u003c/strong\u003e\u003c/p\u003e\n\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eAI input tokens per day\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eInput tokens used by the LLM\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003ePer day, per project\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e200 billion\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eAI input tokens per day per user\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eInput tokens used by the LLM\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003ePer day, per project, per user\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e150 billion\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eAI output tokens per day\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eOutput and thinking tokens used by the LLM\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003ePer day, per project, per project\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e20 billion\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eAI output tokens per day per user\u003c/strong\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eOutput and thinking tokens used by the LLM\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003ePer day, per project, per user\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003ctd style\u003d\"vertical-align:top;border:1px solid #000000;padding:16px\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e15 billion\u003c/span\u003e\u003c/p\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eKey details:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eThe quotas are global.\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e Usage is summed across all regions, so costs can't pile up unnoticed in a region you weren't watching.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eOutput quotas include \"thinking\" tokens.\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e Reasoning tokens count toward your output quota, just as they count toward your Gemini platform bill.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eWhich functions are covered?\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eThe quotas apply to these BigQuery functions that perform LLM-backed generation:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-ai-generate\"\u003e\u003ccode style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eAI.GENERATE\u003c/code\u003e\u003c/a\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-generate-table\"\u003e\u003ccode style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eAI.GENERATE_TABLE\u003c/code\u003e\u003c/a\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-ai-generate-text\"\u003e\u003ccode style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eAI.GENERATE_TEXT\u003c/code\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e (and its alias \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-generate-text\"\u003e\u003ccode style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eML.GENERATE_TEXT\u003c/code\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e)\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-ai-classify\"\u003e\u003ccode style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eAI.CLASSIFY\u003c/code\u003e\u003c/a\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-ai-if\"\u003e\u003ccode style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eAI.IF\u003c/code\u003e\u003c/a\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-ai-score\"\u003e\u003ccode style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eAI.SCORE\u003c/code\u003e\u003c/a\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-ai-agg\"\u003e\u003ccode style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eAI.AGG\u003c/code\u003e\u003c/a\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eWhat's not covered:\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e Embedding functions such as \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-generate-text\"\u003e\u003ccode style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eAI.GENERATE_EMBEDDING\u003c/code\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e (also available as \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-generate-embedding\"\u003e\u003ccode style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eML.GENERATE_EMBEDDING\u003c/code\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e) and \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-ai-embed\"\u003e\u003ccode style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eAI.EMBED\u003c/code\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e are \u003c/span\u003e\u003cspan style\u003d\"font-style:italic;vertical-align:baseline\"\u003enot\u003c/span\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e subject to these quotas, because they run on different, substantially cheaper models.\u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eManaging your quotas\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eAdministrators can view and adjust the quotas directly in the \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/control-genai-costs\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eGoogle Cloud console\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e as workloads change, with no support case required.\u003c/span\u003e\u003c/p\u003e\n\u003col\u003e\n\u003cli style\u003d\"list-style-type:decimal;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eNavigate to \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eIAM \u0026amp; Admin → \u003c/strong\u003e\u003ca href\u003d\"https://console.cloud.google.com/iam-admin/quotas/list\"\u003e\u003cstrong style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eQuotas \u0026amp; System Limits\u003c/strong\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:decimal;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eFilter by service and select \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eBigQuery API\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:decimal;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eSort by the \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eName\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e column to bring the four AI quotas to the top.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ol\u003e"]]],[null,null,null,null,null,null,null,null,[[[null,"\u003cp\u003eLocating the gen AI token quotas in IAM \u0026amp; Admin → Quotas \u0026amp; System Limits.\u003c/p\u003e"],["https://storage.googleapis.com/gweb-cloudblog-publish/images/1_dxxy8WS.max-2000x2000.png","https://storage.googleapis.com/gweb-cloudblog-publish/images/1_dxxy8WS.max-1100x1100.png 1060w, https://storage.googleapis.com/gweb-cloudblog-publish/images/1_dxxy8WS.max-2000x2000.png 1999w"," 1060px,  1999px","https://storage.googleapis.com/gweb-cloudblog-publish/images/1_dxxy8WS.max-2000x2000.png"],null,3]]],[null,null,[null,[null,"\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e4. Find the quota, for example \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eAI input tokens per day\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e5. Open the three-dot menu and choose \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eEdit quota\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eFrom there:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eTo tighten cost control,\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e lower a quota. This takes effect immediately with no approval needed.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eTo support higher usage,\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e request an increase from the same page. Many requests are auto-approved; larger increases may go through a quick review.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e"]]],[null,null,null,null,null,null,null,null,[[[null,"\u003cp\u003eEditing a gen AI token quota in IAM \u0026amp; Admin → Quotas \u0026amp; System Limits.\u003c/p\u003e"],["https://storage.googleapis.com/gweb-cloudblog-publish/images/2_7NmvWbT.max-2000x2000.png","https://storage.googleapis.com/gweb-cloudblog-publish/images/2_7NmvWbT.max-1100x1100.png 1060w, https://storage.googleapis.com/gweb-cloudblog-publish/images/2_7NmvWbT.max-2000x2000.png 1954w"," 1060px,  1954px","https://storage.googleapis.com/gweb-cloudblog-publish/images/2_7NmvWbT.max-2000x2000.png"],null,3]]],[null,null,[null,[null,"\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eYou'll need the right permissions.\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e You need one of: \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eOwner\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eEditor, \u003c/strong\u003e\u003ca href\u003d\"https://docs.cloud.google.com/iam/docs/roles-permissions/servicemanagement#servicemanagement.quotaAdmin\"\u003e\u003cstrong style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eQuota Administrator\u003c/strong\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003e \u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e(\u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eroles/servicemanagement.quotaAdmin\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e), or \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/iam/docs/roles-permissions/serviceusage#serviceusage.serviceUsageAdmin\"\u003e\u003cstrong style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eService Usage Admin\u003c/strong\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e (\u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eroles/serviceusage.serviceUsageAdmin\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e).\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003ePrefer automation?\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e You can also \u003c/span\u003e\u003ca href\u003d\"https://medium.com/google-cloud/bigquery-ai-cost-guardrails-how-to-set-daily-token-limits-programmatically-02d7a35f843a\" rel\u003d\"noopener\" target\u003d\"_blank\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003emanage these quotas programmatically\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e through the \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/docs/quotas\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eCloud Quotas API\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, the \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003egcloud\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e CLI, and Terraform to apply consistent guardrails across projects.\u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eMonitoring usage\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eBeyond setting limits, the \u003c/span\u003e\u003ca href\u003d\"https://console.cloud.google.com/iam-admin/quotas/list\"\u003e\u003cstrong style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eQuotas \u0026amp; System Limits\u003c/strong\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e page displays your historical token consumption so you can quickly detect spikes and right-size your budgets. Use these trends to see how new generative AI workloads and data pipelines affect your overall token usage.\u003c/span\u003e\u003c/p\u003e"]]],[null,null,null,null,null,null,null,null,[[[null,"\u003cp\u003eDaily project-level token usage for a gen AI token quota in IAM \u0026amp; Admin → Quotas \u0026amp; System Limits.\u003c/p\u003e"],["https://storage.googleapis.com/gweb-cloudblog-publish/images/3_sSNHw57.max-2000x2000.png","https://storage.googleapis.com/gweb-cloudblog-publish/images/3_sSNHw57.max-1100x1100.png 1060w, https://storage.googleapis.com/gweb-cloudblog-publish/images/3_sSNHw57.max-2000x2000.png 1999w"," 1060px,  1999px","https://storage.googleapis.com/gweb-cloudblog-publish/images/3_sSNHw57.max-2000x2000.png"],null,3]]],[null,null,null,null,null,null,null,null,[[[null,"\u003cp\u003eLonger-term usage graph with selectable 7-day, 14-day, 30-day, and custom ranges.\u003c/p\u003e"],["https://storage.googleapis.com/gweb-cloudblog-publish/images/4_iYgfR4l.max-2000x2000.png","https://storage.googleapis.com/gweb-cloudblog-publish/images/4_iYgfR4l.max-1100x1100.png 1060w, https://storage.googleapis.com/gweb-cloudblog-publish/images/4_iYgfR4l.max-2000x2000.png 1999w"," 1060px,  1999px","https://storage.googleapis.com/gweb-cloudblog-publish/images/4_iYgfR4l.max-2000x2000.png"],null,3]]],[null,null,[null,[null,"\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eFor a step-by-step walkthrough, see the BigQuery documentation on \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/control-genai-costs\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003econtrolling costs with token quotas\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e.\u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eToken quotas vs. billing spend caps\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eToken quotas aren't the only cost guardrail in Google Cloud.\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/control-genai-costs\"\u003e\u003cstrong style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eToken quotas (this feature)\u003c/strong\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e are \u003c/span\u003e\u003cspan style\u003d\"font-style:italic;vertical-align:baseline\"\u003epreventive\u003c/span\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e and \u003c/span\u003e\u003cspan style\u003d\"font-style:italic;vertical-align:baseline\"\u003eAI-specific\u003c/span\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e. BigQuery tracks token usage during query execution and stops work close to the limit, with separate limits per project and per user.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eCloud Billing \u003c/strong\u003e\u003ca href\u003d\"https://docs.cloud.google.com/billing/docs/how-to/budgets-spend-caps#eligible-services\"\u003e\u003cstrong style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003espend caps\u003c/strong\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e operate on \u003c/span\u003e\u003cspan style\u003d\"font-style:italic;vertical-align:baseline\"\u003edollars\u003c/span\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e at the project and service level and can automatically block usage when a threshold is reached. They're a broad, financial backstop rather than a precise usage control, and because enforcement is not instant, some overages are incurred.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eUse token quotas as your first line of defense for AI spend, and a spend cap as a project-wide safety net.\u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eHow enforcement works\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eQuotas are enforced by stopping work rather than letting a query run past your limit. A query is rejected up front with a \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eQuotaExceeded\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e error only if a quota it needs is already exhausted. Otherwise, it starts, and if a quota runs out mid-query, BigQuery stops sending new LLM calls:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eFunctions that support \u003c/strong\u003e\u003ccode\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003emax_error_ratio\u003c/strong\u003e\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e (such as \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eAI.IF\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e) return partial results if unprocessed rows stay within the ratio, and otherwise fail.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eGeneral-purpose functions\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e (such as \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eAI.GENERATE\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e) still succeed. Skipped rows have no generated value, and their \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003estatus\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e field contains the quota-exceeded error.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eFor details, see \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/control-genai-costs#quota_enforcement_behavior\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003equota enforcement behavior\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e in the documentation.\u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eSizing your input data: \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eAI.COUNT_TOKENS\u003c/code\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eTo choose quota values, it helps to know how much text your workloads send to a model. The \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-ai-count-tokens\"\u003e\u003ccode style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eAI.COUNT_TOKENS\u003c/code\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e function helps with this.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eAI.COUNT_TOKENS\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e returns the number of tokens a model's tokenizer produces for a text string, without making a billable generation call. Run it over a column to measure your input data:\u003c/span\u003e\u003c/p\u003e"]]],[["-- Count the input text tokens for each product review\r\nSELECT\r\n  SUM(\r\n    AI.COUNT_TOKENS(\r\n      CONCAT('Classify the sentiment of this review as positive, negative, or neutral: ', review_text),\r\n\r\n      endpoint \u003d\u003e 'gemini-3.1-flash-lite').result) AS total_input_tokens\r\nFROM\r\n  `my_project.my_dataset.product_reviews`;",null,[null,""]]],[null,null,[null,[null,"\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eThe count is a lower bound on input tokens. It doesn't include output or thinking tokens, the instructions each AI function adds around your input, or non-text inputs such as images. Use it to:\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eGauge the input side of a workload\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e before you launch it.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eRight-size your quotas\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e together with a small sample run that measures actual input and output usage.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eTranslate tokens into dollars\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e using the published \u003c/span\u003e\u003ca href\u003d\"https://cloud.google.com/vertex-ai/generative-ai/pricing\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eGemini platform pricing\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e for your model.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eFrom tokens to budget: a worked example\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eSuppose you want to keep a project's daily AI spend around \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e$100\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e with the \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/gemini-enterprise-agent-platform/models/gemini/3-1-flash-lite\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eGemini 3.1 Flash-Lite\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e model. As of today's published pricing (BigQuery processes in batch which provides a 50% discount):\u003c/span\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eInput tokens:\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e $0.125 per 1 million tokens\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eOutput tokens (response + reasoning):\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e $0.75 per 1 million tokens\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eIf a small sample run shows an average \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e100:1 input-to-output token ratio\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, you can solve for a daily budget:\u003c/span\u003e\u003c/p\u003e"]]],[["Cost:   0.125 × I + 0.75 × O \u003d 100     (I, O in millions of tokens)\r\nRatio:  I \u003d 100 × O",null,[null,""]]],[null,null,[null,[null,"\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eSolving gives about \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e754 million input tokens\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e and \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003e7.54 million output tokens\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e per day. Set \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eAI input tokens per day\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e and \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eAI output tokens per day\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e to these values to hold the project near $100/day. If a project uses models with different prices, budget per model or blend the rates.\u003c/span\u003e\u003c/p\u003e\n\u003ch3\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eBest practices for managing AI cost\u003c/span\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eStart with per-user quotas.\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e They stop one user or runaway experiment from draining the project's budget.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eMeasure before you scale.\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e Use \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003eAI.COUNT_TOKENS\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e to size your input, then check a small sample run in the usage chart before setting limits.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eMind the output side.\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e Output tokens cost more. Where a function accepts \u003c/span\u003e\u003ccode style\u003d\"vertical-align:baseline\"\u003emax_output_tokens\u003c/code\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e, set it to bound generation length.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:disc;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eMonitor and iterate.\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e Adjust limits as real usage and budgets change.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch3\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eGet started\u003c/span\u003e\u003c/h3\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eToken-based cost management is available now. To begin:\u003c/span\u003e\u003c/p\u003e\n\u003col\u003e\n\u003cli style\u003d\"list-style-type:decimal;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eOpen \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eIAM \u0026amp; Admin → \u003c/strong\u003e\u003ca href\u003d\"https://console.cloud.google.com/iam-admin/quotas/list\"\u003e\u003cstrong style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eQuotas \u0026amp; System Limits\u003c/strong\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e in the Google Cloud Console and filter by \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eBigQuery API\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:decimal;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eReview the four \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003eAI-related\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e \u003c/span\u003e\u003cstrong style\u003d\"vertical-align:baseline\"\u003etoken quotas\u003c/strong\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e and set limits that match your budget.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli style\u003d\"list-style-type:decimal;vertical-align:baseline\"\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eUse \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/reference/standard-sql/bigqueryml-syntax-ai-count-tokens\"\u003e\u003ccode style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003eAI.COUNT_TOKENS\u003c/code\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e to size your input data.\u003c/span\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eFor the full details, see the documentation on \u003c/span\u003e\u003ca href\u003d\"https://docs.cloud.google.com/bigquery/docs/control-genai-costs\"\u003e\u003cspan style\u003d\"text-decoration:underline;vertical-align:baseline\"\u003econtrolling generative AI costs\u003c/span\u003e\u003c/a\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003e.\u003c/span\u003e\u003c/p\u003e\n\u003cp\u003e\u003cspan style\u003d\"vertical-align:baseline\"\u003eWith token-based guardrails in place, your teams can use generative AI in BigQuery with the cost predictability your organization needs.\u003c/span\u003e\u003c/p\u003e"]]]],[["Data Analytics","Cross-cloud conversational analytics made simple with open standards","Learn how borderless Lakehouse federates queries across Databricks, Snowflake, and AWS Glue with Apache Iceberg for in-place conversational analytics.",["https://storage.googleapis.com/gweb-cloudblog-publish/images/09_-_Data_Analytics_tFH57V6.max-700x700.jpg","https://storage.googleapis.com/gweb-cloudblog-publish/images/09_-_Data_Analytics_tFH57V6.max-400x400.jpg 324w, https://storage.googleapis.com/gweb-cloudblog-publish/images/09_-_Data_Analytics_tFH57V6.max-700x700.jpg 648w"," 324px,  648px","https://storage.googleapis.com/gweb-cloudblog-publish/images/09_-_Data_Analytics_tFH57V6.max-700x700.jpg"],null,8,null,"https://cloud.google.com/blog/products/data-analytics/cross-cloud-conversational-analytics-with-borderless-lakehouse",null,1,[["Praveen Kumar","Customer Engineer, Data \u0026 AI"]],null,"59745"],["Business Intelligence","Trusted Data Apps for the Agentic Data Cloud, powered by Looker","With new Looker Data Apps, describe your BI dashboard in plain language, and an agent builds a production-grade application natively inside Looker.",["https://storage.googleapis.com/gweb-cloudblog-publish/images/50_-_Business_Intelligence_lw8zsjF.max-700x700.jpg","https://storage.googleapis.com/gweb-cloudblog-publish/images/50_-_Business_Intelligence_lw8zsjF.max-400x400.jpg 324w, https://storage.googleapis.com/gweb-cloudblog-publish/images/50_-_Business_Intelligence_lw8zsjF.max-700x700.jpg 648w"," 324px,  648px","https://storage.googleapis.com/gweb-cloudblog-publish/images/50_-_Business_Intelligence_lw8zsjF.max-700x700.jpg"],null,4,null,"https://cloud.google.com/blog/products/business-intelligence/introducing-looker-data-apps",null,1,[["Ani Jain","Group Product Manager, Google Cloud"],["Sharon Zhang","Product Manager, Google Cloud"]],null,"59729"],["Data Analytics","Introducing TimesFM 3.0 with multivariate time-series forecasting in BigQuery","Google Research’s TimesFM 3.0 is a 330-million parameter foundation model that unlocks native multivariate time-series forecasting in BigQuery SQL.",["https://storage.googleapis.com/gweb-cloudblog-publish/images/09_-_Data_Analytics_tFH57V6.max-700x700.jpg","https://storage.googleapis.com/gweb-cloudblog-publish/images/09_-_Data_Analytics_tFH57V6.max-400x400.jpg 324w, https://storage.googleapis.com/gweb-cloudblog-publish/images/09_-_Data_Analytics_tFH57V6.max-700x700.jpg 648w"," 324px,  648px","https://storage.googleapis.com/gweb-cloudblog-publish/images/09_-_Data_Analytics_tFH57V6.max-700x700.jpg"],null,11,null,"https://cloud.google.com/blog/products/data-analytics/bigquery-timesfm-3-0-with-multivariate-time-series-forecasting",null,1,[["Haiyang Qi","Software Engineer"],["Haoming Chen","Engineering Manager"]],null,"59730"],["Data Analytics","Agentic data science with the Data Agent Kit","Learn how to use the Data Agent Kit inside the Antigravity IDE. Data Agent Kit helps you work with Google Cloud data through a plugin for coding agents or an extension for Visual Studio Code-based IDEs.",["https://storage.googleapis.com/gweb-cloudblog-publish/images/0_banner_image.max-700x700.png","https://storage.googleapis.com/gweb-cloudblog-publish/images/0_banner_image.max-400x400.png 324w, htt