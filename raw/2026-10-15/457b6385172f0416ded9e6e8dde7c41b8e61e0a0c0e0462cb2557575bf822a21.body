bgdp4b11wn2&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;yb-mpa-mark&quot;:&quot;mark-main-text&quot;,&quot;style&quot;:&quot;font-size: 14px;color: #000000;line-height: 25px;word-break: break-word;&quot;,&quot;data-mid&quot;:&quot;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]"><span style="color: #888888;font-weight: normal;font-family: Arial, Helvetica, sans-serif;" mpa-font-style="mm0fhbt510oy"><span leaf="">&nbsp; &nbsp; 编辑丨岑峰</span></span></span></p><p yb-mpa-mark="mark-main-text" style="font-size: 14px;color: rgb(0, 0, 0);line-height: 25px;word-break: break-word;text-align: right;margin: 0px 16px;" data-mid=""><strong style="-webkit-tap-highlight-color: transparent;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;font-family: Optima-Regular, PingFangTC-light;box-sizing: border-box !important;overflow-wrap: break-word !important;" mpa-from-tpl="t" data-mpa-action-id="mc1ad7ht254l"><strong style="-webkit-tap-highlight-color: transparent;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;" mpa-from-tpl="t"><span data-pm-slice="2 2 [&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 16px;padding: 0px;outline: 0px;max-width: 100%;clear: both;min-height: 1em;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);line-height: normal;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;node&quot;,{&quot;tagName&quot;:&quot;strong&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin-top: 0px;margin-bottom: 0px;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" style="-webkit-tap-highlight-color: transparent;padding: 0px;outline: 0px;max-width: 100%;letter-spacing: 0.5px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;"><span leaf="">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;</span></span></strong></strong></p></section></section></section></section><section data-mpa-action-id="mv0jusblk9h" data-pm-slice="0 0 []"><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">在机械臂的实机测试中，不少团队都遇到过类似的困扰：为了让机器人学会抓取某个马克杯，往往需要人类抓着机械臂录入上百条示范轨迹。然而只要把杯子换成未见过的款式，或者稍微改变物体的摆放位置，策略的成功率就会急剧下降。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这种靠海量遥操作数据硬堆技能的方式，很难让机器人真正具备应对新环境的泛化能力。更棘手的是，即便当前的视频预测模型已经能准确画出合理的未来画面，但一旦接入动作模块驱动实机，机械臂依然频频出错。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">在 IROS 2026 大会上，来自 UPenn、MIT 与 Stanford 联合团队的茅佳源分享了他们的思考。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;5a9273fd-8cca-47f6-a0e3-7080b40c76ce&quot;,&quot;height&quot;:3072,&quot;width&quot;:4080,&quot;currHeight&quot;:3072,&quot;currWidth&quot;:4080,&quot;natrualHeight&quot;:3072,&quot;natrualWidth&quot;:4080,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FFNXnbJRYWolPQqx5ke6c0St5nGg%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;FNXnbJRYWolPQqx5ke6c0St5nGg&quot;,&quot;image_type&quot;:&quot;image/jpeg&quot;,&quot;size&quot;:2118911,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a4c812d.jpg" class="rich_pages wxw-img" data-ratio="0.7527777777777778" data-type="jpeg" data-w="1080" style="background-color:transparent;width:100%;" data-width="4080" data-height="3072" data-backw="546" data-backh="411" data-imgfileid="100263111" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a4c812d.jpg?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">她不仅介绍了只需一次人类演示就能泛化执行多种非抓取任务的 RAPID 闭环框架，还首次提出了诊断“视觉会了、手却做不对”这一机制脱节的 TR 指标。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">借由基于 TR 的自适应引导机制，团队最终将双臂机器人在复杂组合任务上的真机泛化成功率提升到了 83%。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">以下是茅佳源的演讲分享，AI科技评论在不改变原意的情况下，进行了编辑和整理：</span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mv0jyihp1t7c"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mba8mvlk1t2b"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section nodeleaf="" style="width: 38px;height: 38px;display: flex;justify-content: center;align-items: center;margin-bottom: -38px;margin-left: -20px;" data-mid="" mpa-from-tpl="t"><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a507757.jpg" alt="图片" class="rich_pages wxw-img __bg_gif" data-ratio="1.0075757575757576" data-type="gif" data-w="132" style="display: block;height: auto !important;visibility: visible !important;width: 38px !important;background-color: transparent;" data-imgfileid="100241584" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a507757.jpg?imageMogr2/quality/90"/></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><p style="font-size: 36px;color: #333333;line-height: 50px;" data-mid=""><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><span leaf="">01</span><span leaf=""><br/></span></strong></p><h2 data-pm-slice="0 0 []"><span leaf=""><br/></span><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">百条轨迹换一项技能，</span></strong></strong></strong></h2></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><h2 data-pm-slice="0 0 []"><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">纯数据拟合为何难做物理泛化？</span><span leaf=""><br/></span></strong></strong></strong></h2></section></section></section></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">过去几年，构建通用物理智能的主流思路是“数据拟合”，试图通过端到端学习，实现从视觉观察到控制动作的直接映射。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这一路径虽推动了大量研究，但在面对真实复杂的物理交互时，瓶颈迅速显现。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">以 Actor Labs 的挖掘机实验为例，其团队将 Physical Intelligence 的 π0.5部署至挖掘机，结合工业操作员的大规模真实数据训练策略。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">尽管展示中仅用200 条轨迹成功完成了一项任务，但这恰恰暴露出纯数据驱动路线的缺点：数据效率极低，且多任务能力受限。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;3bd0b954-3e2e-47d3-8846-d8de4186d950&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FR6bnbHlzwoz0Y3xVVVVccCMpnpc%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;R6bnbHlzwoz0Y3xVVVVccCMpnpc&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:1046398,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a54ae54.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color:transparent;width:100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100263109" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a54ae54.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">如果掌握每一项单一技能都需要百小时级或数百条轨迹的数据积累，这种依靠堆叠数据推动的范式，其规模化扩展的可行性显然存疑。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;e5453bc0-a69b-4035-bb97-f8d9aaed1bc9&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FTbm4bD2BnoPiy4xOW8JclK66n8c%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;Tbm4bD2BnoPiy4xOW8JclK66n8c&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:145321,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a577575.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color:transparent;width:100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100263107" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a577575.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">相比之下，人类仅凭单次演示就能理解动作背后的物理逻辑，并轻松迁移至不同尺寸、材质的物体甚至全新任务中。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;099d1fae-5c73-49ab-8633-f576478cae2b&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FKhk4bANkKoPkaCxrmQ3cpG8SnHb%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;Khk4bANkKoPkaCxrmQ3cpG8SnHb&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:1789124,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a5c7c13.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color:transparent;width:100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100263110" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a5c7c13.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">当端到端模型在分布外（OOD）场景中频频失灵，研究者们不得不重新审视：在盲目堆砌数据量之外，是否存在更根本的智能构建路径？</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这便引出了第二条路线：将智能视为世界建模与规划（Intelligence as World Modeling and Planning）。其核心在于将机器学习与物理规划相结合，使智能体通过小样本理解物理规律，进而实现真正的分布外泛化。</span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mv0jzt66sl1"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mba8mvlk1t2b"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section nodeleaf="" style="width: 38px;height: 38px;display: flex;justify-content: center;align-items: center;margin-bottom: -38px;margin-left: -20px;" data-mid="" mpa-from-tpl="t"><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a5f4052.jpg" alt="图片" class="rich_pages wxw-img __bg_gif" data-ratio="1.0075757575757576" data-type="gif" data-w="132" style="display: block;height: auto !important;visibility: visible !important;width: 38px !important;background-color: transparent;" data-imgfileid="100241584" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a5f4052.jpg?imageMogr2/quality/90"/></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><p style="font-size: 36px;color: #333333;line-height: 50px;" data-mid=""><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><span leaf="">02</span><span leaf=""><br/></span></strong></p><h2 data-pm-slice="0 0 []"><span leaf=""><br/></span><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">告别像素级预测，</span></strong></strong></strong></h2></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><h2 data-pm-slice="0 0 []"><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">用“神经+符号”构建可推理的世界模型</span><span leaf=""><br/></span></strong></strong></strong></h2></section></section></section></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">要实现基于规划的智能，首先需构建“世界模型”，即让智能体在内部建立物理世界表征，并基于该表征演推后续动作。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">然而，物理环境极其复杂，若直接在像素级预测未来状态与细节，计算代价会非常高，难以支持长序列动作的实时规划。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">破解这一难题的关键在于引入组合式抽象表示。智能体无需记忆所有像素细节，而是提炼形状、姿态、材质等抽象属性，并用状态转移图显式建立“动作-状态”演变机制。</span></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;5fe5793d-c1cf-409f-9860-8c184d84a7e2&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FCzpsboJ0CoFB00xx2oDcU5W5nag%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;CzpsboJ0CoFB00xx2oDcU5W5nag&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:524728,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a63a003.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color: transparent;width: 100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100263108" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a63a003.png?imageMogr2/quality/90"/></section><section style="text-align: center;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 14px;font-family: Arial, Helvetica, sans-serif;" mpa-font-style="mv0kd7b1bu3" data-mpa-action-id="mv0kd7be13y1" data-pm-slice="0 0 []"><span textstyle="" style="color: #888888;">图：神经符号概念将物体抽象为形状、姿态、材质等属性，并用状态转移图描述动作导致的 state 演变。图中 s0→s1 表示 push(glass)，s1→s3 表示 flip(cap)。</span></span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这就是神经符号概念的核心：</span></section><ul class=" list-paddingleft-2"><li><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">“神经”层：利用神经网络进行视觉感知，提取物体的几何与物理属性；</span></section></li><li><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">“符号”层：利用符号逻辑对这些属性进行组合，并定义动作与状态之间的转移规则。</span></section></li></ul><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">两者结合，智能体摆脱端到端黑盒映射，转而学习物理世界运行规律的结构化模型。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">有了这种抽象表示，机器人即可在执行前内部推演（如推动杯子或翻转瓶盖后的状态演变），自主规划动作序列。这正是“从单次演示中学习并强泛化”的基础。</span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mv0k14mc1n7m"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mba8mvlk1t2b"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section nodeleaf="" style="width: 38px;height: 38px;display: flex;justify-content: center;align-items: center;margin-bottom: -38px;margin-left: -20px;" data-mid="" mpa-from-tpl="t"><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a667cc1.jpg" alt="图片" class="rich_pages wxw-img __bg_gif" data-ratio="1.0075757575757576" data-type="gif" data-w="132" style="display: block;height: auto !important;visibility: visible !important;width: 38px !important;background-color: transparent;" data-imgfileid="100241584" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a667cc1.jpg?imageMogr2/quality/90"/></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><p style="font-size: 36px;color: #333333;line-height: 50px;" data-mid=""><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><span leaf="">03</span><span leaf=""><br/></span></strong></p><h2 data-pm-slice="0 0 []"><span leaf=""><br/></span><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">破解策略网络不可拼接困局：</span></strong></strong></strong></h2></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><h2 data-pm-slice="0 0 []"><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">将动作生成转化为“约束求解”</span><span leaf=""><br/></span></strong></strong></strong></h2></section></section></section></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">具备可组合的世界模型后，下一个问题是：如何将高层逻辑规划转化为物理世界中可执行的具体动作？</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">传统强化学习与端到端范式中，策略网络（π）普遍无法直接拼接。例如分别训练抓取（π1）、移动（π2）、放置（π3）三个网络，因观测空间、动作空间及中间状态难以对齐，极难直接串联完成长序列任务。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;27e3b909-5dde-4068-9f21-ca0d6cff99b2&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FWPBPbiatLo0Bu8xQyjBcKbRXnee%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;WPBPbiatLo0Bu8xQyjBcKbRXnee&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:1013936,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a6a822c.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color:transparent;width:100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100263113" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a6a822c.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">针对策略不可组合的困境，替代方案并非训练更大的端到端网络，而是将动作生成重新定义为约束优化问题。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">在此框架下，智能体需在给定初始状态 s0 下，求解使动作代价（如轨迹长度）最小化的轨迹，同时满足两类关键约束：</span></section><ul class=" list-paddingleft-2"><li><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">路径约束</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">：包含动力学约束 dynamics（轨迹必须符合物理定律）与无碰撞约束 collision-free（机器人与环境无干涉）；</span></section></li></ul><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;0b07fcce-c280-42a6-a340-accef27e91e2&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FPTDhbxAUMojvRaxTKIEc1UWUnnb%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;PTDhbxAUMojvRaxTKIEc1UWUnnb&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:1731382,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a6ebacb.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color:transparent;width:100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100263115" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a6ebacb.png?imageMogr2/quality/90"/></section><section style="text-align: center;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 14px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888;">图：约束优化生成动作。路径约束包括关节限制与无碰撞；子目标约束包括抓取目标与放置目标。</span></span></section><ul class=" list-paddingleft-2"><li><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">子目标约束</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">：包含阶段性接触目标 holding-target（如稳妥抓取物体）与最终任务目标 target-on-rack（如将物体精准放置至指定架子）。</span></section></li></ul><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;37b1c3ae-1fdb-4610-a48b-60a7c1668ab2&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FQu4zbxs9VolCQ6xzScsc44shnwd%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;Qu4zbxs9VolCQ6xzScsc44shnwd&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:1768428,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a73fcae.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color:transparent;width:100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100263114" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a73fcae.png?imageMogr2/quality/90"/></section><section style="text-align: center;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 14px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888;">图 ：约束优化组合动作。目标是最小化轨迹长度 |t1|+|t2|，同时满足 dynamics、collision-free、holding-target、target-on-rack 等约束。</span></span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这种设计将学习显式解耦为约束集与约束值两个层面。机器人无需从零学习物理法则（交由已知物理模型与优化求解器处理），神经网络只需聚焦与任务相关的关键约束。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;f6d1c34e-cc28-44bb-bbe1-f1a43ea86043&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FAvikbHovLorTKSxu0BjccJ1pnBh%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;AvikbHovLorTKSxu0BjccJ1pnBh&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:1475064,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a783db8.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color:transparent;width:100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100263116" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a783db8.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这种解耦大幅减轻数据负担，使模型能以极低数据量捕捉关键约束，实现跨物体与跨场景的精准求解。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">以团队 MAGIC 项目中的“物品悬挂”任务为例，这类操作需要同时兼顾抓取、悬挂姿态与运动轨迹三重联合约束。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">面对这一挑战，传统模型规划因搜索空间过大，单次求解动辄超过 5 分钟；而基于无监督特征学习与策略学习的代表性方法，哪怕在 10 万个合成水杯数据上训练，单次演示泛化成功率也仅有 42%。”</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;eb4bcefa-c528-4742-b5a9-46f2b8dc384a&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FLQd7bQSmBoJN92xjyN9cbvMDnfb%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;LQd7bQSmBoJN92xjyN9cbvMDnfb&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:150657,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a7ab180.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color:transparent;width:100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100263112" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a7ab180.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">相比之下，该框架通过视觉对应关系引导约束优化，仅凭单次演示就将成功率大幅提升到了 93%。</span></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;01085071-e059-4dd1-aa5c-e9395e688b8c&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FCbymbZBMzoJ4mYxRZTpcADqanZb%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;CbymbZBMzoJ4mYxRZTpcADqanZb&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:562707,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a7dffca.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color:transparent;width:100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100263120" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a7dffca.png?imageMogr2/quality/90"/></section><section style="text-align: center;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 14px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888;">图：悬挂任务中，传统模型规划单次求解超 5 分钟；纯数据驱动方法在 10 万合成 mug 上单例成功率 42%。本方法通过视觉对应将成功率提升至 93%。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mv0k25osbby"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mba8mvlk1t2b"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section nodeleaf="" style="width: 38px;height: 38px;display: flex;justify-content: center;align-items: center;margin-bottom: -38px;margin-left: -20px;" data-mid="" mpa-from-tpl="t"><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a82232b.jpg" alt="图片" class="rich_pages wxw-img __bg_gif" data-ratio="1.0075757575757576" data-type="gif" data-w="132" style="display: block;height: auto !important;visibility: visible !important;width: 38px !important;background-color: transparent;" data-imgfileid="100241584" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a82232b.jpg?imageMogr2/quality/90"/></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><p style="font-size: 36px;color: #333333;line-height: 50px;" data-mid=""><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><span leaf="">04</span><span leaf=""><br/></span></strong></p><h2 data-pm-slice="0 0 []"><span leaf=""><br/></span><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">RAPID 架构：</span></strong></strong></strong></h2></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><h2 data-pm-slice="0 0 []"><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">1 次人类演示+代码智能体，</span></strong></strong></strong></h2></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><h2 data-pm-slice="0 0 []"><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">搞定复杂非抓取交互</span><span leaf=""><br/></span></strong></strong></strong></h2></section></section></section></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">如果将上述“约束+接触序列”的思路进一步推演，就能构建出面向更复杂物理交互的通用架构：</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">RAPID</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;fb791ccc-93e0-4b57-b2ac-add466d73a0d&quot;,&quot;height&quot;:226,&quot;width&quot;:1086,&quot;currHeight&quot;:226,&quot;currWidth&quot;:1086,&quot;natrualHeight&quot;:226,&quot;natrualWidth&quot;:1086,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FB56Dbl7QJohO7exLCgocsfLQnfb%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;B56Dbl7QJohO7exLCgocsfLQnfb&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:45264,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a842e3f.png" class="rich_pages wxw-img" data-ratio="0.20833333333333334" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1086" data-height="226" data-backw="546" data-backh="114" data-imgfileid="100263117" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a842e3f.png?imageMogr2/quality/90"/></section><section style="text-align: center;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 14px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888;">注：RAPID源于此篇论文。点击查看：https://arxiv.org/pdf/2609.30249</span></span></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;13a5355d-470c-4fc6-9206-4b56a431ea3e&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FA5vzbPYc2o6P2uxX4P5csTGwnFT%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;A5vzbPYc2o6P2uxX4P5csTGwnFT&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:913443,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a883f67.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color:transparent;width:100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100263121" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a883f67.png?imageMogr2/quality/90"/></section><section style="text-align: center;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 14px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888;">图：RAPID 面向接触丰富、非抓取操作，仅需单次人类演示即可学习。</span></span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">在 RAPID 架构中，技能学习被转化为由编程智能体与物理校验器构成的闭环编程循环：</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;3e038ade-b9cd-4f91-8896-5a79fc2b79fb&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FRpdybdldtoBfjNx4rZIcIsIenUb%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;RpdybdldtoBfjNx4rZIcIsIenUb&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:828000,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a8ba800.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color:transparent;width:100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100263119" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a8ba800.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">1.演示解析与原语拆解</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">：从单次演示中提取动作，自动切分为推、翻转、支点旋转、抓取等基础操作原语；</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;f4145e9c-d6e3-46d1-969a-cc87f837fb80&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FXFNxbdpUIoBOovxmTgbcFa3AnTb%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;XFNxbdpUIoBOovxmTgbcFa3AnTb&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:415998,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a8ee363.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color:transparent;width:100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100263118" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a8ee363.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">2.以物体为中心的程序生成</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">：Coding Agent 将原语转化为以物体为中心的约束程序，脱离特定的几何参数，使其天然具备可复用性与组合性；</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;f082cf0f-5305-479f-b3b6-8ed1ecb34832&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FW5UubLi98oUJxgxiytQcuUcVnsd%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;W5UubLi98oUJxgxiytQcuUcVnsd&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:533693,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a931a93.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color:transparent;width:100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100263122" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a931a93.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">3.仿真校验与闭环迭代：</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">校验器在 Real2Sim 仿真环境中验证程序，将碰撞、物理可行性等反馈传给 Coding Agent 进行修正，可在部署前筛除大量物理不可行程序。</span></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;add1f080-75ca-464d-b8c7-bd9119e79472&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FZiw1boi3zomaLBxslEfc4PmWnSf%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;Ziw1boi3zomaLBxslEfc4PmWnSf&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:248630,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a95d9dc.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color:transparent;width:100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100263123" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a95d9dc.png?imageMogr2/quality/90"/></section><section style="text-align: center;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 14px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888;">图：RAPID 的智能体编程循环。Coding Agent 生成行为程序 Π，Evaluator 在 Real2Sim 仿真中校验并反馈，迭代修正。</span></span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">在涵盖书架、隔板等场景的 8 个复杂非抓取真机任务中（灵活组合了推、翻、压移、支点、倾倒、抓取等原语），RAPID 仅凭</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">单次人类演示</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">，便展现出极高的鲁棒性与泛化求解能力。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;9595ba71-1e56-40dc-ac53-4b1c9542ff5a&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FSSeIbtPiKo7I8mxH9iUcmX7Ynwg%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;SSeIbtPiKo7I8mxH9iUcmX7Ynwg&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:990004,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a99f422.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color: transparent;" data-width="960" data-height="540" data-imgfileid="100263126" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9a99f422.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这说明，将 Coding Agent 的代码生成能力与物理模型校验相结合，能以符号化约束优化实现强泛化的单示例学习。 &nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;80d60088-1526-432d-aea7-60db383564b0&quot;,&quot;height&quot;:540,&quot;width&quot;:960,&quot;currHeight&quot;:540,&quot;currWidth&quot;:960,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FFuPyblhWao4EMPxcVOvcShWJnef%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;FuPyblhWao4EMPxcVOvcShWJnef&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:444690,&quot;comments&quot;:[]}]}" nodeleaf="">雷峰网</section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mv0k3dv1205c"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mba8mvlk1t2b"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section nodeleaf="" style="width: 38px;height: 38px;display: flex;justify-content: center;align-items: center;margin-bottom: -38px;margin-left: -20px;" data-mid="" mpa-from-tpl="t"><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9aa1b83a.jpg" alt="图片" class="rich_pages wxw-img __bg_gif" data-ratio="1.0075757575757576" data-type="gif" data-w="132" style="display: block;height: auto !important;visibility: visible !important;width: 38px !important;background-color: transparent;" data-imgfileid="100241584" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9aa1b83a.jpg?imageMogr2/quality/90"/></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><p style="font-size: 36px;color: #333333;line-height: 50px;" data-mid=""><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><span leaf="">05</span><span leaf=""><br/></span></strong></p><h2 data-pm-slice="0 0 []"><span leaf=""><br/></span><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">大模型盲区：</span></strong></strong></strong></h2></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><h2 data-pm-slice="0 0 []"><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">为何视频-动作模型无法自动“涌现”组合力？</span><span leaf=""><br/></span></strong></strong></strong></h2></section></section></section></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">RAPID 框架展示了 Coding Agent 在复杂物理操作任务中的能力：通过结合物理验证器、约束求解等模块，系统能够仅凭单次人类演示规划并执行复杂的非抓取操作。RAPID 本身也是一个模块化系统，其能力来自 Coding Agent 与不同功能模块之间的协作。这说明，组合性不仅体现在运动技能的组合上，也体现在系统如何组织和调用不同的能力模块。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">由此引出了一个更一般的问题：面向实际任务，我们应该如何设计这样的模块化系统？哪些能力应该被拆分为独立模块，模块之间又应该通过什么接口协作？与完全端到端的神经网络相比，模块化系统能够引入显式结构，使各个环节更易于解释、验证和替换，但也可能受到人工划分和接口设计的限制；端到端模型则能够联合学习感知到动作的映射，却更难对中间过程进行独立检查与干预。理解这两种范式在泛化能力、数据效率和系统鲁棒性上的优势与局限，是将智能体应用于真实物理世界的重要问题。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">在探索组合性的另一条路上，模块化系统展现出了独特优势。例如，系统可以先用开放词汇检测器提取“马克杯”的视觉掩码，再交由特定策略完成抓取，这就是模块化组合的直观体现。</span></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;e2c6bdbb-6832-408c-8b44-1b6d6baf1a0d&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FLGESbNflKoPWfFxpwPHcLXUcnef%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;LGESbNflKoPWfFxpwPHcLXUcnef&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:615321,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9aa5d18e.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263125" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9aa5d18e.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">以团队此前发表的 Retriever 框架为例，它将感知、推理与控制拆分为独立模块，并显式建模触发器与缓冲区，巧妙解决了多频率异步（如腕部相机 30Hz、机器人状态 60Hz、低阶技能 2Hz）下的闭环控制难题，在双臂机器人“给牛排撒调料”等长时程任务中验证了模块组合的高效性。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;6cfb5eff-10f0-4c96-bae2-26c8c26201e5&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FK9YWbRwReoJsK9x3TLLc5q7VnDb%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;K9YWbRwReoJsK9x3TLLc5q7VnDb&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:258746,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9aa905d0.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263127" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9aa905d0.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">但是，各模块之间受限的信息流动，使其难以充分吸收不同任务之间的协同效应。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这就引发了一个更深度的思考：神经网络能否直接将感知、记忆、规划与控制融为一体？如果放弃人工预定义的原语与模块划分，转向端到端统一的多模态大模型，将包含丰富物理规律的视频预测与动作生成联合训练，组合能力能否在模型中自动“涌现”？</span></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;f96fbb3d-d07a-4523-84f4-724206330427&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FF7Ifbw2xPoUIpCxINaOch7pbnwb%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;F7Ifbw2xPoUIpCxINaOch7pbnwb&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:1001333,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9aaea010.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263131" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9aaea010.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">围绕这一课题，团队展开了两次尝试。第一次是视频生成预测+动作控制器；第二次是视频-动作联合训练模型。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">然而，随后的实机与仿真实验表明，问题的复杂程度远超预想。</span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mv0k66351uw0"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mqggjy08r8x"><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span style="font-family:等线"><strong mpa-from-tpl="t"><span leaf="" data-pm-slice="1 1 [&quot;heading&quot;,{&quot;tagName&quot;:&quot;h3&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;text-align: justify; margin: 16px 16px 24px; line-height: 1.75em;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;level&quot;:3}]"><span textstyle="" style="letter-spacing: 1px;color: #4499E7;font-weight: bold;">▎</span></span><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="letter-spacing: 1px;color: #4499E7;">试错一：视觉预测转动作指令，难以胜任富接触操作</span></span></strong></span></p></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">为了吸收跨任务的协同效应，研究团队展开了第一次尝试：利用通用的视频生成模型预测未来画面，再将视觉预测翻译为机器人的具体动作。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这一路线对应团队发表于 ICLR 2024 (Spotlight) 的 AVDC 框架。</span></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;7daf0630-f74d-401e-b6f1-aa669462ffff&quot;,&quot;height&quot;:358,&quot;width&quot;:1156,&quot;currHeight&quot;:358,&quot;currWidth&quot;:1156,&quot;natrualHeight&quot;:358,&quot;natrualWidth&quot;:1156,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FGZQPbu58noBMt4xUKRycgLuCnYe%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;GZQPbu58noBMt4xUKRycgLuCnYe&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:62286,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ab1bca3.png" class="rich_pages wxw-img" data-ratio="0.30925925925925923" data-type="png" data-w="1080" style="background-color: transparent;" data-width="1156" data-height="358" data-imgfileid="100263128" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ab1bca3.png?imageMogr2/quality/90"/></section><section style="text-align: left;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 14px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888;font-style: italic;">原文链接：https://arxiv.org/pdf/2310.08576</span></span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">其动作提取流程分为三个核心阶段： &nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">1.视频预测</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">：输入语言指令与当前 RGB-D 观察，利用预训练视频预测模型生成未来数帧的视频； &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">2.稠密运动估计</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">：从合成的未来视频帧中计算光流，结合深度信息进行 SE(3) 空间位姿估计，恢复出物体的三维运动轨迹； &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">3.笛卡尔控制映射</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">：根据物体的 3D 轨迹反推机器人末端执行器的移动方向，生成笛卡尔空间下的控制指令。&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;df34df26-7ee7-4f10-86e0-cb10d4681496&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FXvvrbdYXFoPC2QxNFKIcD9Khns5%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;XvvrbdYXFoPC2QxNFKIcD9Khns5&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:516800,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ab682e4.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263129" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ab682e4.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">该架构最大的优势在于摆脱了对显式动作标签的依赖。模型可以直接利用无动作标签的视频数据进行预训练，并迁移至机器人任务中。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">同时，由于它提取的是物体本身的三维运动而非特定机械臂的关节点位，因而具备出色的跨本体泛化能力。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;7925c5ce-8712-421b-b725-cceccfc46875&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FIhEGbKv1yokrDOxI41EcTxNYnud%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;IhEGbKv1yokrDOxI41EcTxNYnud&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:856649,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9abaa6c6.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263130" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9abaa6c6.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">然而，真机测试揭示了这一解耦范式的明显局限：它主要支持基础的抓取、移动与放置技能。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">面对翻转、按压、支点旋转等复杂的富接触操作，单纯依靠像素层面的视频预测，难以捕捉真实的物理受力与精准的接触作用点。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这表明，“视频</span><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;font-family: Arial, Helvetica, sans-serif;">生成</span><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;font-family: Arial, Helvetica, sans-serif;">→</span><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;font-family: Arial, Helvetica, sans-serif;">动</span><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">作翻译”这种串联管线无法自动涌现出复杂的组合行为。必须打破解耦，将视频预测与动作生成深度结合进行联合训练——这便引出了第二次尝试：视频-动作联合模型。&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;ef49d667-8e23-47c5-baa7-5051f9520209&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FRw8ubsdrEoAyF9xxx5fcO5Q2nRb%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;Rw8ubsdrEoAyF9xxx5fcO5Q2nRb&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:256651,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9abd9f85.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263133" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9abd9f85.png?imageMogr2/quality/90"/></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mv0kaa0f1h10"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mqggjy08r8x"><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span style="font-family:等线"><strong mpa-from-tpl="t"><span leaf="" data-pm-slice="1 1 [&quot;heading&quot;,{&quot;tagName&quot;:&quot;h3&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;text-align: justify; margin: 16px 16px 24px; line-height: 1.75em;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;level&quot;:3}]"><span textstyle="" style="letter-spacing: 1px;color: #4499E7;font-weight: bold;">▎</span></span><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="letter-spacing: 1px;color: #4499E7;">试错二：看懂了未来画面，Action Head却还在“盲开”</span></span></strong></span></p></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">为了克服单一视频驱动无法处理复杂接触动作的痛点，研究团队展开了第二次尝试：构建视频-动作联合模型。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这一架构的初衷，是让负责动作生成的网络能够直接“看到”并利用视频模型对未来的物理预测。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">在具体设计上，团队采用预训练视频预测模型 Cosmos Predict 2.5-2B（基于 Flow Matching 架构）作为骨干网络。在视频生成的去噪过程中，提取中间噪声水平σ_v下的潜特征，经由特征投影层后，与机器人的本体状态以及含噪动作 Token 一同送入 Gemma Action Head，最终通过 Flow Matching 联合生成去噪后的动作控制 Token。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;d43a375c-9aa1-4085-b55d-a725acb9d1fc&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FQZiEbI6raoI3qKxrNcgceaE6n0M%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;QZiEbI6raoI3qKxrNcgceaE6n0M&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:326930,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ac1a4d8.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263135" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ac1a4d8.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">然而，实机与仿真实验给出了出乎意料的结论：统一的视频-动作联合模型，并不会自动“涌现”出组合泛化能力。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">团队观察到了两个棘手的问题：</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">1.视觉能泛化，执行却失效</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">：视频预测模型本身具备优秀的泛化能力，面对未见过的指令时，能生成合理的视觉未来帧。然而，一旦接入 Action Head 驱动机械臂实际执行，策略在组合式分布外任务上的成功率便急剧下跌。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;1c9157b4-2b42-4999-9c3f-a9659745692b&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FDYFfbjVxaoi1Enxbz1QcIMEUnhd%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;DYFfbjVxaoi1Enxbz1QcIMEUnhd&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:619260,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ac5544b.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263136" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ac5544b.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;d3eec2e5-dc05-4101-ac1b-254be50bc15d&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FMXJrb0aNEo4ukNx3HZSc9EvXnlf%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;MXJrb0aNEo4ukNx3HZSc9EvXnlf&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:543757,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ac939b1.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263132" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ac939b1.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">2.极高的超参数敏感度与 ID-OOD 权衡：</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">训练配方对性能有决定性影响。例如，LoRA 联合训练能在 ID（分布内）与组合 OOD 之间达成某种权衡，而全参数微调则更容易偏向 ID 性能，牺牲泛化。 &nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;40a35f39-dbb5-4458-a51a-69f9e45c16e3&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FVWyUbErjWoFDqyxYDzmczZr5nnc%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;VWyUbErjWoFDqyxYDzmczZr5nnc&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:189022,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9acbc85b.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263134" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9acbc85b.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">深入分析“泛化鸿沟”后，团队发现，Action Head 在生成控制动作时，常常倾向于直接“忽略”视频模型预测出的未来特征。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">在对比实验中，哪怕视频模型预测出了完全错误的未来画面，Action Head 依然可能偶然完成动作；反之，当视频模型生成了完美正确的未来画面时，Action Head 却反而给出了错误的动作控制。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这证实了动作生成与未来预测之间存在严重的“机制脱节”，视频预测中蕴含的物理知识，未能有效地转化为控制端的泛化能力。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;f74c14e2-23da-401c-996d-562688ade5e7&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FBLRBbX2SdoGcjtxggI6chTDInse%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;BLRBbX2SdoGcjtxggI6chTDInse&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:535934,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ad0becc.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263140" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ad0becc.png?imageMogr2/quality/90"/></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mv0kawyp1bx2"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mqggjy08r8x"><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span style="font-family:等线"><strong mpa-from-tpl="t"><span leaf="" data-pm-slice="1 1 [&quot;heading&quot;,{&quot;tagName&quot;:&quot;h3&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;text-align: justify; margin: 16px 16px 24px; line-height: 1.75em;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;level&quot;:3}]"><span textstyle="" style="letter-spacing: 1px;color: #4499E7;font-weight: bold;">▎</span></span><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="letter-spacing: 1px;color: #4499E7;">诊断：引入时间比率，看穿动作头有没有“偷懒”</span></span></strong></span></p></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">为了精准量化 Action Head 在决策时到底有多依赖视频模型的未来预测，研究团队提出了一个直观且量化的诊断指标：时间比率（Temporal Ratio，TR）</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">TR = 未来帧的注意力权重 / 当前帧的注意力权重 &nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;28409788-f388-4620-864a-c4984859a9dd&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FCeQMb9qq3oAAHcxMUb3cpcXjnzb%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;CeQMb9qq3oAAHcxMUb3cpcXjnzb&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:196962,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ad3df1c.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263137" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ad3df1c.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;7abf5729-dc1a-4e16-8351-1018fd17cff6&quot;,&quot;height&quot;:294,&quot;width&quot;:946,&quot;currHeight&quot;:294,&quot;currWidth&quot;:946,&quot;natrualHeight&quot;:294,&quot;natrualWidth&quot;:946,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FUWgubgFstoQxYAxoqPvcHZCbnWb%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;UWgubgFstoQxYAxoqPvcHZCbnWb&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:48499,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ad6d151.png" class="rich_pages wxw-img" data-ratio="0.3107822410147992" data-type="png" data-w="946" style="background-color:transparent;width:100%;" data-width="946" data-height="294" data-backw="546" data-backh="170" data-imgfileid="100263138" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ad6d151.png?imageMogr2/quality/90"/></section><section style="text-align: center;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 14px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888;">注：此篇论文提出的TR这一诊断指标，点击查看原文：https://arxiv.org/pdf/2607.08127</span></span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">该指标直接反映了动作头的决策偏好。TR 越高，说明 Action Head 越认真地“看”视频模型预测出的未来画面并据此导向动作；TR 越低，则说明动作头几乎在“盲开”，完全忽视未来的预测信息。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">通过分析不同模型与超参数配置下的 TR 曲线，团队发现了一个关键规律：峰值 TR（Peak TR）精准预测了模型的组合泛化能力。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">TR 越高的模型，其在分布外任务上的成功率就越强；而那些 TR 极低的模型，泛化成功率几乎为零。研究人员通过调整视频噪声水平σ_v来人工抬升 TR，同一个模型的 OOD 成功率也随之呈现出明确的攀升趋势。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">此外，TR 并非静态常数，而是在任务执行过程中动态演变。通常在执行前几步 TR 会升至峰值，模型积极参考未来规划；随后随 Replanning Step 推进而回落。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;3981157b-4a32-4a7a-bd66-662212efd1b7&quot;,&quot;height&quot;:2262,&quot;width&quot;:3600,&quot;currHeight&quot;:2262,&quot;currWidth&quot;:3600,&quot;natrualHeight&quot;:2262,&quot;natrualWidth&quot;:3600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FRkCWbfUWbo0cirxaCTacPZFhn4e%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;RkCWbfUWbo0cirxaCTacPZFhn4e&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:1568211,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ada955b.png" class="rich_pages wxw-img" data-ratio="0.6277777777777778" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="3600" data-height="2262" data-backw="546" data-backh="343" data-imgfileid="100263141" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ada955b.png?imageMogr2/quality/90"/></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mv0kbbnb1afv"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mqggjy08r8x"><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span style="font-family:等线"><strong mpa-from-tpl="t"><span leaf="" data-pm-slice="1 1 [&quot;heading&quot;,{&quot;tagName&quot;:&quot;h3&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;text-align: justify; margin: 16px 16px 24px; line-height: 1.75em;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;level&quot;:3}]"><span textstyle="" style="letter-spacing: 1px;color: #4499E7;font-weight: bold;">▎</span></span><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="letter-spacing: 1px;color: #4499E7;">免重训修复方案：TR 自适应强引导，真机 OOD 成功率提升至 83%</span></span></strong></span></p></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">找到了“机制脱节”的病灶后，研究团队提出了一种无需重新训练模型即可弥合泛化鸿沟的方案：</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">自适应引导。 &nbsp;&nbsp;</span></strong></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">团队将无分类器引导（CFG）拓展为两个维度的强引导：语言引导与计划引导。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;4eb57d73-0615-4677-9780-2004082c4b81&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FQXtwbAxVroS1wIxrpDvc7A4TnTh%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;QXtwbAxVroS1wIxrpDvc7A4TnTh&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:160672,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9add2522.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263139" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9add2522.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;cc50f32e-43e2-4897-8a7f-92650809b4fb&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FL5pjbyvaQoAu1HxeZW7cJoOwnYg%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;L5pjbyvaQoAu1HxeZW7cJoOwnYg&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:156107,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ae09bcb.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263143" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ae09bcb.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">与固定权重的传统引导不同，自适应引导会实时监测 TR 指标：当检测到 TR 出现峰值、动作头正积极参考未来规划时，系统会自动调大计划与语言引导的权重，强化未来物理约束；而在 TR 处于低位的平稳阶段则不叠加额外引导。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这种“在关键决策点精准发力”的机制，既避免了过度引导对分布内（ID）性能的损伤，又大幅提升了模型在空间、物体和目标分布外（OOD）任务上的组合泛化能力。</span></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;6f2cdd6c-15c9-4a6c-9d72-b160dbd6deb7&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FTA8LbeG0nos3OJxSzQOcIBrgnA1%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;TA8LbeG0nos3OJxSzQOcIBrgnA1&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:335329,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ae38b4f.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263144" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ae38b4f.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">在 LIBERO 仿真基准上的测试证明了该机制的优越性。传统的“平坦引导”（Flat Guidance，即固定权重的引导）虽然能提升分布外（OOD）的成功率，但会严重损害分布内（ID）的性能；而自适应引导通过 TR 的动态调节，在保持分布内较高成功率的同时，大幅提升了在空间、物体和目标分布外任务上的组合泛化表现，实现了更好的 ID 与 OOD 性能权衡。 &nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;00af8fb2-f38d-4a01-8d76-6945ed9b9738&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FLITpb0CAVoX63SxZF4AcBshKnYb%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;LITpb0CAVoX63SxZF4AcBshKnYb&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:1034739,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ae84176.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263146" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9ae84176.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">随后，团队在搭载双臂机器人的真实物理环境（基于 YAM 硬件与 abc.bot 数据集）中评估了 8 项复杂任务，涵盖从纸袋中取出瓶子、整理零食到货架、折叠 T 恤等。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;00b89fb3-ed2e-409b-bf4b-90ce00cfc84b&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FJVc0b74xxo7BQWxnfYzcQlymnDh%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;JVc0b74xxo7BQWxnfYzcQlymnDh&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:930724,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9aec7c69.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263145" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9aec7c69.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">在未见过的组合式分布外任务（如“把水果放进纸袋”）中，对比模型 Cosmos-Policy 的平均成功率仅约 12%，而团队自己的模型在未引导前平均成功率为 71.8%，引入基于 TR 的自适应引导后，真机泛化成功率进一步提升至 83%，验证了该方案在真实物理场景中的有效性。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;3937807a-7319-4277-bdd0-33622c3178b0&quot;,&quot;height&quot;:900,&quot;width&quot;:1600,&quot;currHeight&quot;:900,&quot;currWidth&quot;:1600,&quot;natrualHeight&quot;:900,&quot;natrualWidth&quot;:1600,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FHIdEb2KBAoWml7x5z2ecy8rUn2f%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;HIdEb2KBAoWml7x5z2ecy8rUn2f&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:168971,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9aef3ec8.png" class="rich_pages wxw-img" data-ratio="0.562962962962963" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1600" data-height="900" data-backw="546" data-backh="307" data-imgfileid="100263142" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9aef3ec8.png?imageMogr2/quality/90"/></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mv0kbriy8km"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mba8mvlk1t2b"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section nodeleaf="" style="width: 38px;height: 38px;display: flex;justify-content: center;align-items: center;margin-bottom: -38px;margin-left: -20px;" data-mid="" mpa-from-tpl="t"><img  data-src="https://static.leiphone.com/uploads/new/images/20261014/6acee9af36d18.jpg" alt="图片" class="rich_pages wxw-img __bg_gif" data-ratio="1.0075757575757576" data-type="gif" data-w="132" style="display: block;height: auto !important;visibility: visible !important;width: 38px !important;background-color: transparent;" data-imgfileid="100241584" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261014/6acee9af36d18.jpg?imageMogr2/quality/90"/></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><p style="font-size: 36px;color: #333333;line-height: 50px;" data-mid=""><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><span leaf="">06</span><span leaf=""><br/></span></strong></p><h2 data-pm-slice="0 0 []"><span leaf=""><br/></span><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">结语：走向通用物理智能，</span></strong></strong></strong></h2></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><h2 data-pm-slice="0 0 []"><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">核心不在于盲目堆叠数据</span><span leaf=""><br/></span></strong></strong></strong></h2></section></section></section></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">视频预测与动作控制之间的协同效应，并不会在联合训练中自动“涌现”出来。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">我们看到，不同的模型架构与训练配方会带来不同水平的组合泛化能力，且往往伴随着分布内（ID）与分布外（OOD）性能之间的权衡。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">虽然我们提出的时间比率（TR）提供了一个精准的诊断工具，但要真正弥合泛化鸿沟，我们必须重新审视“组合性”本身：从架构、优化目标到数据定义的根本层面进行重构。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">回到最本质的范式选择上，模块化系统依然非常强大。它天生具备显式的结构化组合性、较高的数据效率，以及对实时机器人系统至关重要的异步控制能力。但它的局限在于，无法充分吸收不同任务之间的深层协同效应。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">因此，如何将模块化系统“强组合性与高数据效率”的优势，与统一大模型“全局吸收协同”的潜力有机结合，是我们接下来最核心的研究方向。 &nbsp;&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这背后依然有一系列深层的科学问题等待我们去解答：</span></section><ul class=" list-paddingleft-2"><li><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">前馈神经网络究竟能否涌现出组合性？</span></section></li><li><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这种涌现出的组合性，能否实现高数据效率的学习？ &nbsp;&nbsp;</span></section></li><li><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">我们该如何形式化真实物理世界中的复杂噪声与多模态数据？ &nbsp;&nbsp;</span></section></li><li><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">我们又该如何形式化泛化标准？究竟是以最坏情况还是平均情况来评估？ &nbsp;&nbsp;</span></section></li></ul><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">把这些底层逻辑厘清，我们才能真正走向通用物理智能。</span></section></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mr0e93q7lzy"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-data-temp-type="image" mpa-from-tpl="t" data-mpa-action-id="mmix4tgk1t7p" data-pm-slice="5 10 []" style="padding-left: 16px;padding-right: 16px;"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;padding-left: 0px;padding-right: 0px;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;background: rgb(246, 248, 255);padding: 20px 0px 12px;margin-top: 0px;margin-bottom: 0px;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mm0fhbur236d" data-pm-slice="0 0 []"><section style="width: 100%;padding: 0 10px;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;display: flex;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;align-self: flex-start;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;background: rgb(246, 248, 255);text-align: center;padding: 7px 10px 11px 11px;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;text-align: left;" data-mid="" mpa-from-tpl="t" data-pm-slice="3 4 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-template&quot;:&quot;t&quot;,&quot;mpa-data-temp-power-by&quot;:&quot;yiban.io&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;,&quot;data-mpa-action-id&quot;:&quot;mr0e7o1n1ckt&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-template&quot;:&quot;t&quot;,&quot;mpa-data-temp-power-by&quot;:&quot;yiban.io&quot;,&quot;mpa-data-temp-type&quot;:&quot;body&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;,&quot;data-mpa-action-id&quot;:&quot;mmykzm77ala&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;width: 100%;padding: 0 10px;&quot;,&quot;data-mid&quot;:&quot;&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;width: 100%;display: flex;flex-direction: column;&quot;,&quot;data-mid&quot;:&quot;&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;width: 100%;align-self: flex-start;&quot;,&quot;data-mid&quot;: