&lt;li&gt;&lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/caihuali95/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/caihuali95&quot;&gt;@caihuali95&lt;/a&gt; made their first contribution in &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5133368726&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/sgl-project/sglang/issues/34602&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/sgl-project/sglang/pull/34602/hovercard&quot; href=&quot;https://github.com/sgl-project/sglang/pull/34602&quot;&gt;#34602&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/ainergiz/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/ainergiz&quot;&gt;@ainergiz&lt;/a&gt; made their first contribution in &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5286613410&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/sgl-project/sglang/issues/37035&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/sgl-project/sglang/pull/37035/hovercard&quot; href=&quot;https://github.com/sgl-project/sglang/pull/37035&quot;&gt;#37035&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/TarangKhanna/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/TarangKhanna&quot;&gt;@TarangKhanna&lt;/a&gt; made their first contribution in &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5228084495&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/sgl-project/sglang/issues/36101&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/sgl-project/sglang/pull/36101/hovercard&quot; href=&quot;https://github.com/sgl-project/sglang/pull/36101&quot;&gt;#36101&lt;/a&gt;&lt;/li&gt;
