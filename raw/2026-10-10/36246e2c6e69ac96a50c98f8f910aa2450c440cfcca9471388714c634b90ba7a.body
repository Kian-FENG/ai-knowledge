&lt;li&gt;&lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/IzacharyI/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/IzacharyI&quot;&gt;@IzacharyI&lt;/a&gt; made their first contribution in &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;4558109586&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/sgl-project/sglang/issues/26852&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/sgl-project/sglang/pull/26852/hovercard&quot; href=&quot;https://github.com/sgl-project/sglang/pull/26852&quot;&gt;#26852&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/jojoakm/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/jojoakm&quot;&gt;@jojoakm&lt;/a&gt; made their first contribution in &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;4837861639&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/sgl-project/sglang/issues/30535&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/sgl-project/sglang/pull/30535/hovercard&quot; href=&quot;https://github.com/sgl-project/sglang/pull/30535&quot;&gt;#30535&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/beef9999/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/beef9999&quot;&gt;@beef9999&lt;/a&gt; made their first contribution in &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;3987919124&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/sgl-project/sglang/issues/19320&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/sgl-project/sglang/pull/19320/hovercard&quot; href=&quot;https://github.com/sgl-project/sglang/pull/19320&quot;&gt;#19320&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/nzr-niu/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/nzr-niu&quot;&gt;@nzr-niu&lt;/a&gt; made their first contribution in &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;4881459899&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/sgl-project/sglang/issues/31174&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/sgl-project/sglang/pull/31174/hovercard&quot; href=&quot;https://github.com/sgl-project/sglang/pull/31174&quot;&gt;#31174&lt;/a&gt;&lt;/li&gt;
