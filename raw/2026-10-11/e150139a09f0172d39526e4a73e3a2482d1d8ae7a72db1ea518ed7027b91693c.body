&lt;th align=&quot;left&quot;&gt;&lt;strong&gt;&lt;a href=&quot;https://github.com/ai-dynamo/aiperf&quot;&gt;AIPerf&lt;/a&gt;&lt;/strong&gt;&lt;/th&gt;
&lt;th align=&quot;left&quot;&gt;&lt;strong&gt;&lt;a href=&quot;https://github.com/ai-dynamo/modelexpress&quot;&gt;ModelExpress&lt;/a&gt;&lt;/strong&gt;&lt;/th&gt;
