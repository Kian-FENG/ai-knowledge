attributes&quot;:{&quot;style&quot;:&quot;width: 100%;background: #F6F8FF;padding: 20px 12px 12px 12px;&quot;,&quot;data-mid&quot;:&quot;&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;,&quot;data-mpa-action-id&quot;:&quot;mbgdp4b11wn2&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;yb-mpa-mark&quot;:&quot;mark-main-text&quot;,&quot;style&quot;:&quot;font-size: 14px;color: #000000;line-height: 25px;word-break: break-word;&quot;,&quot;data-mid&quot;:&quot;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]"><span style="color: #888888;font-weight: normal;font-family: Arial, Helvetica, sans-serif;" mpa-font-style="mm0fhbt510oy"><span leaf="">&nbsp; &nbsp; 编辑丨岑 &nbsp; 峰</span></span></span></p><p yb-mpa-mark="mark-main-text" style="font-size: 14px;color: rgb(0, 0, 0);line-height: 25px;word-break: break-word;text-align: right;margin: 0px 16px;" data-mid=""><strong style="-webkit-tap-highlight-color: transparent;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;font-family: Optima-Regular, PingFangTC-light;box-sizing: border-box !important;overflow-wrap: break-word !important;" mpa-from-tpl="t" data-mpa-action-id="mc1ad7ht254l"><strong style="-webkit-tap-highlight-color: transparent;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;" mpa-from-tpl="t"><span data-pm-slice="2 2 [&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 16px;padding: 0px;outline: 0px;max-width: 100%;clear: both;min-height: 1em;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);line-height: normal;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;node&quot;,{&quot;tagName&quot;:&quot;strong&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin-top: 0px;margin-bottom: 0px;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" style="-webkit-tap-highlight-color: transparent;padding: 0px;outline: 0px;max-width: 100%;letter-spacing: 0.5px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;"><span leaf="">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;</span></span></strong></strong></p></section></section></section></section><section data-mpa-action-id="muklj6t717n" data-pm-slice="0 0 []"><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">9 月 27 日到 10 月 1 日，全球机器人领域最顶级的国际会议之一 IROS 2026 将在美国匹兹堡开幕。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">如果你前两年也在关注这个会，你会发现那时候大家都在 “卷概念”。谁家用了更大的 LLM，谁家机器人跳了一段更炫的舞，听起来很猛，但细一想，大多还停在实验室的 Demo 里。今年不一样。从目前放出的主会论文和 Workshop 名单，我们的感受很直接： 顶会上关于具身传递出的信号，变了。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">整个会场的风向出奇地一致，技术路线明显在收敛。雷峰网把它总结成四个趋势： 基础模型开始内化物理规律；“大小脑” 架构从小众路线变成了行业标准；触觉不再是锦上添花，而是精细操作的核心变量；数据采集彻底撕掉了 “天价” 的标签。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">下面一个一个说。</span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muklge6f13ud"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mba8mvlk1t2b"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section nodeleaf="" style="width: 38px;height: 38px;display: flex;justify-content: center;align-items: center;margin-bottom: -38px;margin-left: -20px;" data-mid="" mpa-from-tpl="t"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b3270bf97.jpg" alt="图片" class="rich_pages wxw-img __bg_gif" data-ratio="1.0075757575757576" data-type="gif" data-w="132" style="display: block;height: auto !important;visibility: visible !important;width: 38px !important;background-color: transparent;" data-imgfileid="100241584" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b3270bf97.jpg?imageMogr2/quality/90"/></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><p style="font-size: 36px;color: #333333;line-height: 50px;" data-mid=""><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><span leaf="">01</span><span leaf=""><br/></span></strong></p><h2 data-pm-slice="0 0 []"><span leaf=""><br/></span><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">具身基模：别再 “语义拟合” 了，得懂物理</span><span leaf=""><br/></span></strong></strong></strong></h2></section></section></section></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">前两年给机器人塞大模型，主流做法其实很简单粗暴：让 LLM/VLM 去理解任务语义，然后翻译成动作。看上去机器人能听懂人话了，但一放到真实环境里，问题立马暴露：它知道 “杯子” 是什么，却不知道杯子从桌边滑下去会碎；知道 “推门”，但不知道门把手有摩擦力。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">说白了，语言模型懂语义，但不懂物理。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">今年 IROS 的核心共识就是：别再教机器人 “认东西” 了，得教它 “懂规矩”，摩擦力、重力、形变、不确定性，这些物理规律必须内化成模型的本能。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">最标志性的信号是 10 月 1 号的 Workshop：</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">Physical World Models for Scaling Embodied AI</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">。斯坦福大学计算机科学助理教授吴佳俊（Jiajun Wu）等六位顶尖学者，将会依次带来关于物理规律如何融入具身智能的主题分享。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;5dba34c1-3aef-457d-9e64-4b3d72b00d0c&quot;,&quot;height&quot;:952,&quot;width&quot;:1890,&quot;currHeight&quot;:952,&quot;currWidth&quot;:1890,&quot;natrualHeight&quot;:952,&quot;natrualWidth&quot;:1890,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FRvMtbj59UoDTMsxRRc6coIEWnKE%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;RvMtbj59UoDTMsxRRc6coIEWnKE&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:876309,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b327475c6.png" class="rich_pages wxw-img" data-ratio="0.5037037037037037" data-type="png" data-w="1890" style="background-color:transparent;width:100%;" data-width="1890" data-height="952" data-backw="546" data-backh="275" data-imgfileid="100262619" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b327475c6.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;efb6ccf9-44a6-41a7-b7f3-5023a3ceda6e&quot;,&quot;height&quot;:1146,&quot;width&quot;:2048,&quot;currHeight&quot;:1146,&quot;currWidth&quot;:2048,&quot;natrualHeight&quot;:1146,&quot;natrualWidth&quot;:2048,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FNeohb23tFoSKtnxPHekcNI0Un4f%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;Neohb23tFoSKtnxPHekcNI0Un4f&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:359385,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b3277962c.png" class="rich_pages wxw-img" data-ratio="0.5595703125" data-type="png" data-w="2048" style="background-color:transparent;width:100%;" data-width="2048" data-height="1146" data-backw="546" data-backh="306" data-imgfileid="100262621" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b3277962c.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">它配套的 WorldArena 2.0 挑战赛，首次将视触觉感知、强化学习效用与真实物理操作三大赛道纳入统一评测体系，全面检验模型在真实物理交互中的泛化能力。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;34e1af5e-b06e-4b22-8f3c-9090247bd9f1&quot;,&quot;height&quot;:1040,&quot;width&quot;:2020,&quot;currHeight&quot;:1040,&quot;currWidth&quot;:2020,&quot;natrualHeight&quot;:1040,&quot;natrualWidth&quot;:2020,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FHEqMbTowvob4YBxhQaxcAXWtn1f%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;HEqMbTowvob4YBxhQaxcAXWtn1f&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:215575,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b327b13e3.png" class="rich_pages wxw-img" data-ratio="0.5148514851485149" data-type="png" data-w="2020" style="background-color:transparent;width:100%;" data-width="2020" data-height="1040" data-backw="546" data-backh="281" data-imgfileid="100262620" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b327b13e3.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">翻译成人话：以前考试考的是刷题，现在考的是实战。这意味着行业对具身模型的评价，正式从 “语义正确” 转向了 “物理正确”。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">针对物理世界建模的核心难题：不确定性，</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">Rethinking Uncertainty for Modern Robotics Paradigms</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">Workshop 在 9 月 27 日专门展开研讨。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;3370ca59-46ae-4abc-bee1-273dee92b4a5&quot;,&quot;height&quot;:424,&quot;width&quot;:1744,&quot;currHeight&quot;:424,&quot;currWidth&quot;:1744,&quot;natrualHeight&quot;:424,&quot;natrualWidth&quot;:1744,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FT9Mdb1waCoWcE3xzFuQcnqAUnyc%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;T9Mdb1waCoWcE3xzFuQcnqAUnyc&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:120614,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b327dff3f.png" class="rich_pages wxw-img" data-ratio="0.24311926605504589" data-type="png" data-w="1744" style="background-color:transparent;width:100%;" data-width="1744" data-height="424" data-backw="546" data-backh="133" data-imgfileid="100262622" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b327dff3f.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">该 Workshop 收录的自适应滚动截断方法，专门优化离线世界模型在不确定环境下的训练效率。这说明具身模型的竞争，已经从 “能不能建模物理” 升级到了 “物理环境乱七八糟时，你还能不能稳得住”。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">同期雷峰网观察到， 10 月 1 日举办的</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">第三届 AI Meets Autonomy</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">Workshop，也将基础模型与机器人系统的融合作为核心议题，覆盖数据集、软件基建、视觉语言导航等方向，进一步推动具身模型从语义理解向物理交互落地。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;0f78bb31-9e9e-43c1-a515-5e72eadd4035&quot;,&quot;height&quot;:1326,&quot;width&quot;:2522,&quot;currHeight&quot;:1326,&quot;currWidth&quot;:2522,&quot;natrualHeight&quot;:1326,&quot;natrualWidth&quot;:2522,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FX69BbnLBaoV9zbxaQV4cC15Fnbe%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;X69BbnLBaoV9zbxaQV4cC15Fnbe&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:2593891,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32843518.png" class="rich_pages wxw-img" data-ratio="0.5257731958762887" data-type="png" data-w="2522" style="background-color:transparent;width:100%;" data-width="2522" data-height="1326" data-backw="546" data-backh="287" data-imgfileid="100262626" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32843518.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">主会收录的多篇论文，也在从不同角度验证这个转向。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">比如UIUC 计算机科学博士生何夏麟和徐思睿此次中稿的</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">ULTRA</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">，获得了（最佳移动操作论文候选。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">ULTRA的全称是Unified Multimodal Control for Autonomous Humanoid Whole-Body Loco-Manipulation，是一个统一多模态全身控制框架，没有走 “LLM 外挂控制器” 的老路，而是将物理驱动的神经重目标算法与统一多模态控制器结合。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;9d9a26e9-0737-4d3e-a2d7-70922bfbe3a6&quot;,&quot;height&quot;:830,&quot;width&quot;:1410,&quot;currHeight&quot;:830,&quot;currWidth&quot;:1410,&quot;natrualHeight&quot;:830,&quot;natrualWidth&quot;:1410,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FPqAJbQyM8omyByxFkvwcPTJEnh0%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;PqAJbQyM8omyByxFkvwcPTJEnh0&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:863116,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32894b30.png" class="rich_pages wxw-img" data-ratio="0.5886524822695035" data-type="png" data-w="1410" style="background-color:transparent;width:100%;" data-width="1410" data-height="830" data-backw="546" data-backh="321" data-imgfileid="100262627" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32894b30.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">在接触密集型交互中保留物理合理性，仅用稀疏任务指令就能生成全身运动行为。该工作还入围了本届 IROS 最佳移动操作论文奖。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 14px;font-family: Arial, Helvetica, sans-serif;" mpa-font-style="muklj6s81b84"><span textstyle="" style="color: #888888;font-style: italic;">论文链接:&nbsp;</span></span><span mpa-font-style="muklj6s8dg6" style="font-size: 14px;"><span leaf="" style="font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888;font-style: italic;">https://arxiv.org/abs/2603.03279</span></span></span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span mpa-font-style="muklj6s84ef" style="font-size: 14px;"><span leaf="" style="font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888;font-style: italic;">项目主页:&nbsp;</span></span></span><span leaf="" style="font-size: 14px;font-family: Arial, Helvetica, sans-serif;" mpa-font-style="muklj6s8gld"><span textstyle="" style="color: #888888;font-style: italic;">https://ultra-humanoid.github.io/</span></span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">同工作方向的代表性工作 HALO 框架，也提到了重载人形机器人的敏捷动作场景，能感受到近期的热点，都放在了重载场景下仿真到现实的迁移空白，让模型在真实物理负载下依然能保持动作精度。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这就像一个真正理解力学的学生，不用题海战术也能考高分。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">此外，这次大会也有很多探讨数据效率方向的工作，利用 2D 特征蒸馏 + 3D 几何对齐方案，跨越不同本体的形态差异，让人类示范能高效迁移到机器人身上，大幅降低下游任务的数据需求量。</span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mukljeiotn0"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mba8mvlk1t2b"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section nodeleaf="" style="width: 38px;height: 38px;display: flex;justify-content: center;align-items: center;margin-bottom: -38px;margin-left: -20px;" data-mid="" mpa-from-tpl="t"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b328cc673.jpg" alt="图片" class="rich_pages wxw-img __bg_gif" data-ratio="1.0075757575757576" data-type="gif" data-w="132" style="display: block;height: auto !important;visibility: visible !important;width: 38px !important;background-color: transparent;" data-imgfileid="100241584" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b328cc673.jpg?imageMogr2/quality/90"/></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><p style="font-size: 36px;color: #333333;line-height: 50px;" data-mid=""><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><span leaf="">02</span><span leaf=""><br/></span></strong></p><h2 data-pm-slice="0 0 []"><span leaf=""><br/></span><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">“大小脑” 架构：</span></strong></strong></strong></h2></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><h2 data-pm-slice="0 0 []"><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">今年终于成了机器人顶会标配</span><span leaf=""><br/></span></strong></strong></strong></h2></section></section></section></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">如果说基模解决的是 “智能够不够”，那 “实时性” 就是落地的最后一公里。大模型推理慢，动辄几百毫秒，机器人控制却要千赫兹级别，这根本对不上频。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">怎么破？今年的答案出奇地一致：分层。大脑负责慢思考，小脑负责快控制。这思路以前也有，但今年不再是某支团队的小众路线，而是学术领域在工程范式上的某种收敛。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">软件层面，这次 IROS 2026 主会的</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">LITHE</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这篇论文，干了一件特别实在的事。&nbsp;</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;38db54c1-6f00-4151-8eff-d4c9c78993a6&quot;,&quot;height&quot;:912,&quot;width&quot;:1412,&quot;currHeight&quot;:912,&quot;currWidth&quot;:1412,&quot;natrualHeight&quot;:912,&quot;natrualWidth&quot;:1412,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FUXb1bsMg2owBOqxzFuYc3aRgndb%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;UXb1bsMg2owBOqxzFuYc3aRgndb&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:397475,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b3293069e.png" class="rich_pages wxw-img" data-ratio="0.6458923512747875" data-type="png" data-w="1412" style="background-color:transparent;width:100%;" data-width="1412" data-height="912" data-backw="546" data-backh="353" data-imgfileid="100262635" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b3293069e.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;" data-mpa-action-id="muklk0v219p7" data-pm-slice="0 0 []"><span mpa-font-style="muklk0uo1ys8" style="font-size: 14px;"><span leaf=""><span textstyle="" style="color: #888888;font-style: italic;">论文地址：</span></span><span leaf=""><span textstyle="" style="color: #888888;font-style: italic;">https://arxiv.org/pdf/2603.07442</span></span></span></span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">它把 Python 层当 “大脑”，跑 LLM、VLM 和任务规划；把 C++ 层当 “小脑”，跑 1kHz 的实时控制律。最关键的突破是实现了动态热切换，大脑可以一边观察，一边在线给小脑更新控制策略，最坏执行时间不到 100 微秒。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">100 微秒什么概念？机器人不用停机，不用重启，大脑直接给它 “换脑子”。以前大家都担心分层架构通信延迟高、大脑升级小脑得停机，LITHE 直接把这块绊脚石搬走了，甚至支持 LLM 在线进化控制器。这套方案让大小脑在低成本硬件上也能跑得通，整套方案跑在 250 美元的树莓派 4B 上就能实现。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">在操作场景，</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">VOFA</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">展示了这套架构的性能：大脑负责视觉感知、规划推物路径，小脑负责实时调接触力和全身姿态。人形机器人稳稳推动 17 公斤的重物，真实场景成功率超过 80%。放在以前的单一架构里，这几乎不敢想。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">作为小脑的感知底座，本体感知这次也被重点讨论。&nbsp;</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">Beyond Exteroception</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这个 Workshop 专门聊 IMU、关节编码器、力矩传感器这些 “内部感知”。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;ace8986f-fea8-4a2c-bbe0-8d2ea66bfd3c&quot;,&quot;height&quot;:1034,&quot;width&quot;:2454,&quot;currHeight&quot;:1034,&quot;currWidth&quot;:2454,&quot;natrualHeight&quot;:1034,&quot;natrualWidth&quot;:2454,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FJlIbbH6bXof9KDxYjdBcMUYtnRd%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;JlIbbH6bXof9KDxYjdBcMUYtnRd&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:2924565,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b329892e4.png" class="rich_pages wxw-img" data-ratio="0.4213528932355338" data-type="png" data-w="2454" style="background-color:transparent;width:100%;" data-width="2454" data-height="1034" data-backw="546" data-backh="230" data-imgfileid="100262628" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b329892e4.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">感知路线上，最彻底的是</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">Blind Dexterity</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">的工作：机器人完全不用摄像头，光靠关节编码器和柔顺驱动构成的本体感知系统，照样完成全身灵巧操作。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;5617b7d0-561a-4a55-8ce0-e4f57ad43f3d&quot;,&quot;height&quot;:1138,&quot;width&quot;:1418,&quot;currHeight&quot;:1138,&quot;currWidth&quot;:1418,&quot;natrualHeight&quot;:1138,&quot;natrualWidth&quot;:1418,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FR4fxb3MbhoBueNx8iNFc9c2dnWg%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;R4fxb3MbhoBueNx8iNFc9c2dnWg&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:1124775,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b329e762d.png" class="rich_pages wxw-img" data-ratio="0.8025387870239774" data-type="png" data-w="1418" style="background-color:transparent;width:100%;" data-width="1418" data-height="1138" data-backw="546" data-backh="438" data-imgfileid="100262630" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b329e762d.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这说明什么？小脑本身就有独立闭环的能力。视觉和大模型只是给它锦上添花，而不是离开就活不下去。这给大小脑架构的合理性，又加了一块很硬的筹码。</span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muklkdz31myj"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mba8mvlk1t2b"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section nodeleaf="" style="width: 38px;height: 38px;display: flex;justify-content: center;align-items: center;margin-bottom: -38px;margin-left: -20px;" data-mid="" mpa-from-tpl="t"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32a23cae.jpg" alt="图片" class="rich_pages wxw-img __bg_gif" data-ratio="1.0075757575757576" data-type="gif" data-w="132" style="display: block;height: auto !important;visibility: visible !important;width: 38px !important;background-color: transparent;" data-imgfileid="100241584" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32a23cae.jpg?imageMogr2/quality/90"/></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><p style="font-size: 36px;color: #333333;line-height: 50px;" data-mid=""><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><span leaf="">03</span><span leaf=""><br/></span></strong></p><h2 data-pm-slice="0 0 []"><span leaf=""><br/></span><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">触觉，终于坐上顶会正桌了</span><span leaf=""><br/></span></strong></strong></strong></h2></section></section></section></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">视觉一直是机器人感知的老大，但精细操作场景里，视觉的瓶颈越来越明显。手一挡，物体姿态追踪丢了；劲儿大了，物体捏坏了；遇到光滑、透明的物体，摄像头直接失效。灵巧操作的行业趋势，是触觉从 “替补” 变成了 “核心”。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">同样的信号，在今年 IROS 也出现了：光靠眼睛不够，得上手（触觉）。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">标志性事件是两场 Workshop：9 月 27 日的</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">Sensors and Actuators for Dexterous Manipulation</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">，从硬件层面探讨执行器和感知器的协同设计；10 月 1 日的</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">Touch-to-Action</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">专题 Workshop，则系统性讨论如何把触觉从传感器设计、仿真学习到真机操作整条链路打通。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这不是单点讨论，而是全链条关注。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">主会论文里，韩国团队提出的</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">KineFuse</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">解决了一个经典难题：手里操作时物体被手挡住，视觉完全失效，怎么办？它的解法是运动学感知的触觉融合，靠触觉 + 运动学模型解算 6D 姿态。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;c7e6cb0b-8636-4653-b096-592208076191&quot;,&quot;height&quot;:570,&quot;width&quot;:2168,&quot;currHeight&quot;:570,&quot;currWidth&quot;:2168,&quot;natrualHeight&quot;:570,&quot;natrualWidth&quot;:2168,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FUAU1bmBhNouOHbxEucWcOMggnFf%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;UAU1bmBhNouOHbxEucWcOMggnFf&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:290744,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32a60b91.png" class="rich_pages wxw-img" data-ratio="0.2629151291512915" data-type="png" data-w="2168" style="background-color:transparent;width:100%;" data-width="2168" data-height="570" data-backw="546" data-backh="144" data-imgfileid="100262631" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32a60b91.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 14px;font-family: Arial, Helvetica, sans-serif;" mpa-font-style="muklkysu1alr" data-mpa-action-id="muklkyta1ffv" data-pm-slice="0 0 []"><span textstyle="" style="color: #888888;font-style: italic;">https://arxiv.org/pdf/2607.14842</span></span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">最巧妙的是它的 “自动门控” 机制：看得见的时候以视觉为主，被遮挡时无缝切换到触觉主导，全程不用人工干预。这就像给机器人装了个自动切换的夜视仪。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">硬件层面，本届会议收录的</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">VTAP Gripper</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">提出了指尖感知 + 视触觉主动手掌的协同设计，将触觉传感器与视觉感知深度整合，大幅提升在手部操作中的感知精度。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;ae93614b-12a8-4024-ad42-6cd949c508cc&quot;,&quot;height&quot;:874,&quot;width&quot;:1420,&quot;currHeight&quot;:874,&quot;currWidth&quot;:1420,&quot;natrualHeight&quot;:874,&quot;natrualWidth&quot;:1420,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FLvv7bI6wCoKplAxqiGacKqtknIe%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;Lvv7bI6wCoKplAxqiGacKqtknIe&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:666943,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32ab64f0.png" class="rich_pages wxw-img" data-ratio="0.6154929577464788" data-type="png" data-w="1420" style="background-color:transparent;width:100%;" data-width="1420" data-height="874" data-backw="546" data-backh="336" data-imgfileid="100262629" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32ab64f0.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">ViHaTeleop</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">则证明了触觉对操作的直接加成。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;62309bed-e390-4135-b4e3-7a124e321c95&quot;,&quot;height&quot;:668,&quot;width&quot;:1386,&quot;currHeight&quot;:668,&quot;currWidth&quot;:1386,&quot;natrualHeight&quot;:668,&quot;natrualWidth&quot;:1386,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FYIjkbCGjEoIyBJxzdQGcuK96njh%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;YIjkbCGjEoIyBJxzdQGcuK96njh&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:455810,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32b0ae81.png" class="rich_pages wxw-img" data-ratio="0.481962481962482" data-type="png" data-w="1386" style="background-color:transparent;width:100%;" data-width="1386" data-height="668" data-backw="546" data-backh="263" data-imgfileid="100262632" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32b0ae81.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">它做了一套只有 0.7 公斤的轻量化视触觉遥操作系统，加入触觉反馈后，接触关键任务的成功率提升了 2.2 到 15.6 个百分点。而且这套低成本设备采集回来的数据，能直接用于训练灵巧操作策略。以前触觉数据贵得离谱，现在轻量化方案一出，触觉数据也能规模化了。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">双臂协同也成了热点。</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">MOMA.v5</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">第 5 届移动操作与具身智能 Workshop，则把移动操作和具身智能结合，推动灵巧操作从实验室桌面走向真实移动场景。而北大董豪团队主办的</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">Scaling vs. Structure</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">专题 Workshop，专门讨论双手机器人怎么超越单臂策略，平衡规模化能力与结构化设计。</span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mukll91r1hux"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mba8mvlk1t2b"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section nodeleaf="" style="width: 38px;height: 38px;display: flex;justify-content: center;align-items: center;margin-bottom: -38px;margin-left: -20px;" data-mid="" mpa-from-tpl="t"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32b44435.jpg" alt="图片" class="rich_pages wxw-img __bg_gif" data-ratio="1.0075757575757576" data-type="gif" data-w="132" style="display: block;height: auto !important;visibility: visible !important;width: 38px !important;background-color: transparent;" data-imgfileid="100241584" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32b44435.jpg?imageMogr2/quality/90"/></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><p style="font-size: 36px;color: #333333;line-height: 50px;" data-mid=""><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><span leaf="">04</span><span leaf=""><br/></span></strong></p><h2 data-pm-slice="0 0 []"><span leaf=""><br/></span><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">&nbsp; 顶会不仅在关注数据采集，</span></strong></strong></strong></h2></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><h2 data-pm-slice="0 0 []"><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">并且找到了 “新平替”</span><span leaf=""><br/></span></strong></strong></strong></h2></section></section></section></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">数据一直是具身智能的卡脖子环节。过去采数据依赖专业动捕房、昂贵设备和真机损耗，单条轨迹成本高得吓人，而且换个场景就废了。业内戏称为 “重资产样板间模式”—— 只有头部公司玩得起，小公司只能干瞪眼。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">今年 IROS 上，两条 “平替” 路线同时成熟。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">第一条路线是 Sim2Real，仿真数据规模化。 本届会议收录的</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">HALO</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">框架，针对重载人形机器人这一难采集场景，通过高保真仿真环境合成对抗式轨迹，再配合少量真实数据协同训练，实现了 80% 以上的仿真到现实迁移率，大幅降低了重载动作的数据采集成本。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">第二条路线是轻量化真机采集。&nbsp;</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">ViHaTeleop</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">开发出了 0.7 公斤的轻量化遥采设备，背着就能走，成本大幅下降。它采集的视触觉演示数据，可以直接用于下游灵巧操作策略训练，相当于用十分之一的成本，产出同样可用的操作数据。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这两条路线一结合，中小团队的打法变得非常清晰：仿真里做预训练，少量真实数据做微调。数据不再是少数巨头的护城河，具身智能的训练门槛被实实在在地打了下来。</span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mukllu7614ds"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mba8mvlk1t2b"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section nodeleaf="" style="width: 38px;height: 38px;display: flex;justify-content: center;align-items: center;margin-bottom: -38px;margin-left: -20px;" data-mid="" mpa-from-tpl="t"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32b79e4b.jpg" alt="图片" class="rich_pages wxw-img __bg_gif" data-ratio="1.0075757575757576" data-type="gif" data-w="132" style="display: block;height: auto !important;visibility: visible !important;width: 38px !important;background-color: transparent;" data-imgfileid="100241584" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32b79e4b.jpg?imageMogr2/quality/90"/></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><p style="font-size: 36px;color: #333333;line-height: 50px;" data-mid=""><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><span leaf="">05</span><span leaf=""><br/></span></strong></p><h2 data-pm-slice="0 0 []"><span leaf=""><br/></span><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">总结：</span></strong></strong></strong></h2></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><h2 data-pm-slice="0 0 []"><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">工程落地，已经成为顶会新风向</span><span leaf=""><br/></span></strong></strong></strong></h2></section></section></section></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">IROS 2026 的这些论文和 Workshop，我们的感受很强烈：虽然具身智能在外界看来已经稍显停滞，或者投资人已经有些倦怠，但从学术角度，具身 “概念泡沫期” 才刚刚过去。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">今年的顶会没有人再空谈 “通用机器人” 的宏大叙事，大家讨论的都是具体工程问题：怎么让模型懂物理、怎么让大小脑不打架、怎么让手有触觉、怎么把数据成本砍下来。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这四个技术方向同时收敛，不是偶然。它说明具身智能的技术骨架已经基本搭好了，接下来要长的是血肉：工程优化、成本压缩、场景落地。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">还有一个值得留意的细节：</span><strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">中国团队的存在感越来越强。</span></strong><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">大连理工大学的 MIWA 力矩辅助方法、和酷哇科技合作的 DeLM 双轮足移动操作框架，以及北大董豪团队主办的双臂操作 Workshop，中国学术界和产业界正在深度嵌入全球具身智能的技术网络。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;d8df108c-4dc4-43bd-9d5f-c9baee51e59f&quot;,&quot;height&quot;:1452,&quot;width&quot;:2658,&quot;currHeight&quot;:1452,&quot;currWidth&quot;:2658,&quot;natrualHeight&quot;:1452,&quot;natrualWidth&quot;:2658,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FE0fabMwR8oOV3QxdWhscQUL2nQc%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;E0fabMwR8oOV3QxdWhscQUL2nQc&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:2660525,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32bbdb0a.png" class="rich_pages wxw-img" data-ratio="0.54627539503386" data-type="png" data-w="2658" style="background-color:transparent;width:100%;" data-width="2658" data-height="1452" data-backw="546" data-backh="298" data-imgfileid="100262633" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32bbdb0a.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">这个探讨会上，被邀请嘉宾中，也出现了专注灵巧手的sharpa团队技术同事zhangkaifeng，以及最近刚刚创立SeeAct AI的穆尧等。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;ac919d44-76f6-47af-8b41-4a11a6ef81ad&quot;,&quot;height&quot;:1466,&quot;width&quot;:2044,&quot;currHeight&quot;:1466,&quot;currWidth&quot;:2044,&quot;natrualHeight&quot;:1466,&quot;natrualWidth&quot;:2044,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FIztCbx5VhoU2Z6xvQSacrJ7onSc%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;IztCbx5VhoU2Z6xvQSacrJ7onSc&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:1134293,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32c115be.png" class="rich_pages wxw-img" data-ratio="0.7172211350293543" data-type="png" data-w="2044" style="background-color:transparent;width:100%;" data-width="2044" data-height="1466" data-backw="546" data-backh="392" data-imgfileid="100262634" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9b32c115be.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">IROS 2026 释放的信号很明确：具身机器人不再是 “未来科技”，而是 “正在发生”。谁能把这些学术成果最快地搬进产线、仓库和家庭，谁就能在下一波浪潮里抢到身位。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="font-size: 15px;font-family: Arial, Helvetica, sans-serif;">匹兹堡见。</span></section></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mr0e93q7lzy"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-data-temp-type="image" mpa-from-tpl="t" data-mpa-action-id="mmix4tgk1t7p" data-pm-slice="5 10 []" style="padding-left: 16px;padding-right: 16px;"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;padding-left: 0px;padding-right: 0px;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;background: rgb(246, 248, 255);padding: 20px 0px 12px;margin-top: 0px;margin-bottom: 0px;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mm0fhbur236d" data-pm-slice="0 0 []"><section style="width: 100%;padding: 0 10px;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;display: flex;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;align-self: flex-start;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;background: rgb(246, 248, 255);text-align: center;padding: 7px 10px 11px 11px;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;text-align: left;" data-mid="" mpa-from-tpl="t" data-pm-slice="3 4 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-template&quot;:&quot;t&quot;,&quot;mpa-data-temp-power-by&quot;:&quot;yiban.io&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;,&quot;data-mpa-action-id&quot;:&quot;mr0e7o1n1ckt&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-template&quot;:&quot;t&quot;,&quot;mpa-data-temp-power-by&quot;:&quot;yiban.io&quot;,&quot;mpa-data-temp-type&quot;:&quot;body&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;,&quot;data-mpa-action-id&quot;:&quot;mmykzm77ala&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;width: 100%;padding: 0 10px;&quot;,&quot;data-mid&quot;:&quot;&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;width: 100%;display: flex;flex-direction: column;&quot;,&quot;data-mid&quot;:&quot;&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;width: 100%;align-self: flex-start;&quot;,&quot;data-mid&quot;:&quot;&quot;,&quot;mpa-from-tpl&quot;:&q