xt&quot;:{&quot;0&quot;:&quot;26年之于具身智能，就是23年之于大语言模型。&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+n&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7066985350417170460&quot;]},&quot;nextNum&quot;:1}},&quot;type&quot;:&quot;text&quot;,&quot;referenceRecordMap&quot;:{},&quot;extra&quot;:{&quot;channel&quot;:&quot;saas&quot;,&quot;isEqualBlockSelection&quot;:false,&quot;pasteRandomId&quot;:&quot;223a8d9b-7e7d-40d4-b910-244b8b09367a&quot;,&quot;mention_page_title&quot;:{},&quot;external_mention_url&quot;:{}},&quot;isKeepQuoteContainer&quot;:false,&quot;isFromCode&quot;:false,&quot;selection&quot;:[{&quot;id&quot;:2,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:4,&quot;end&quot;:27},&quot;recordId&quot;:&quot;JtD7dqrTZoMV7dxZYXYcEJOSn9e&quot;}],&quot;payloadMap&quot;:{},&quot;isCut&quot;:false}" data-lark-record-format="docx/text"></span><span data-mpa-action-id="mkwc1mygyhi"></span><span data-mpa-action-id="mkqn0kmf15uo"></span><p yb-mpa-mark="mark-main-text" style="font-size: 14px;color: rgb(0, 0, 0);line-height: 25px;word-break: break-word;margin-bottom: 0px;margin-top: 0px;" data-mid=""><span leaf="" style="font-family: Arial, Helvetica, sans-serif;" mpa-font-style="mm0fhbt51zfy"><span textstyle="" style="color: #888888; font-weight: normal">&nbsp; &nbsp; 作者丨</span></span><span leaf="" style="justify-content: center;align-items: center;background: #F6F8FF;font-size: 14px;line-height: 25px;word-break: break-word;color: #888888;font-weight: normal;font-family: Arial, Helvetica, sans-serif;">向欣</span><strong style="-webkit-tap-highlight-color: transparent;margin-right: 0px;margin-left: 0px;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;font-family: Optima-Regular, PingFangTC-light;box-sizing: border-box !important;overflow-wrap: break-word !important;" mpa-from-tpl="t"><span style="-webkit-tap-highlight-color: transpa