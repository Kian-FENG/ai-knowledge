&lt;li&gt;feat(cake_nvfp4_svdquant): add NVFP4 SVDQuant GEMM SM100 and SM103 backend by &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/yyihuang/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/yyihuang&quot;&gt;@yyihuang&lt;/a&gt; in &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5407656931&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/flashinfer-ai/flashinfer/issues/5076&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/flashinfer-ai/flashinfer/pull/5076/hovercard&quot; href=&quot;https://github.com/flashinfer-ai/flashinfer/pull/5076&quot;&gt;#5076&lt;/a&gt;&lt;/li&gt;
