ata-hovercard-url=&quot;/vllm-project/vllm/pull/53014/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/53014&quot;&gt;#53014&lt;/a&gt;), NVFP4 in the torch linear backend (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5218120554&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/53319&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/53319/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/53319&quot;&gt;#53319&lt;/a&gt;), per-quantization linear backend overrides (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5075635072&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/51204&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/51204/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/51204&quot;&gt;#51204&lt;/a&gt;), AutoRound 2/3/5/6/7-bit on CUDA (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5189593949&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/52890&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/52890/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/52890&quot;&gt;#52890&lt;/a&gt;), and DeepSelect top-k for the DSA sparse indexer (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5424999483&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56464&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56464/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56464&quot;&gt;#56464&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Breaking changes&lt;/strong&gt;: scale-out endpoints are opt-in on plain &lt;code&gt;vllm serve&lt;/code&gt; via &lt;code&gt;--enable-scale-out&lt;/code&gt;, replacing &lt;code&gt;VLLM_ENABLE_SCALE_OUT_ENDPOINTS&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5301316142&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/54579&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/54579/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/54579&quot;&gt;#54579&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5339007444&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55176&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55176/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55176&quot;&gt;#55176&lt;/a&gt;); GPTQ activation ordering (&lt;code&gt;g_idx&lt;/code&gt;) removed (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5314643386&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/54809&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/54809/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/54809&quot;&gt;#54809&lt;/a&gt;); items deprecated for 0.29 removed, including the &lt;code&gt;VLLM_PREFIX_CACHE_RETENTION_INTERVAL&lt;/code&gt; and &lt;code&gt;VLLM_MM_HASHER_ALGORITHM&lt;/code&gt; env vars (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5349776813&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55353&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55353/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55353&quot;&gt;#55353&lt;/a&gt;); the &lt;code&gt;all&lt;/code&gt; Mamba cache mode deprecated (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5330671982&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55041&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55041/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55041&quot;&gt;#55041&lt;/a&gt;); &lt;code&gt;python -m vllm.entrypoints.grpc_server&lt;/code&gt; deprecated in favor of &lt;code&gt;vllm serve --grpc&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5444544395&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56746&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56746/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56746&quot;&gt;#56746&lt;/a&gt;); YaRN aligned with Transformers so vendor YaRN aliases no longer re-scale &lt;code&gt;max_model_len&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5423551846&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56446&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56446/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56446&quot;&gt;#56446&lt;/a&gt;).&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;Release Artifacts&lt;/h2&gt;
&lt;h3&gt;Python Wheels&lt;/h3&gt;
&lt;table&gt;
&lt;thead&gt;
&lt;tr&gt;
&lt;th&gt;Platform&lt;/th&gt;
&lt;th&gt;Install&lt;/th&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td&gt;PyPI (CUDA 13.0)&lt;/td&gt;
&lt;td&gt;&lt;code&gt;pip install vllm&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;PyPI (CUDA 13.0, uv)&lt;/td&gt;
&lt;td&gt;&lt;code&gt;uv pip install vllm --torch-backend=auto&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;ROCm&lt;/td&gt;
&lt;td&gt;&lt;code&gt;pip install vllm --extra-index-url https://wheels.vllm.ai/rocm/0.30.0/rocm723&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;XPU&lt;/td&gt;
&lt;td&gt;&lt;code&gt;uv pip install vllm --extra-index-url https://wheels.vllm.ai/0.30.0/xpu --extra-index-url https://download.pytorch.org/whl/xpu --index-strategy unsafe-best-match&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;h3&gt;Docker Images&lt;/h3&gt;
&lt;table&gt;
&lt;thead&gt;
&lt;tr&gt;
&lt;th&gt;Platform&lt;/th&gt;
&lt;th&gt;Docker Image&lt;/th&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td&gt;CUDA 13.0 (Default)&lt;/td&gt;
&lt;td&gt;&lt;code&gt;docker pull vllm/vllm-openai:v0.30.0&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;CUDA 12.9&lt;/td&gt;
&lt;td&gt;&lt;code&gt;docker pull vllm/vllm-openai:v0.30.0-cu129&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;CUDA 13.0 + Ubuntu 24.04&lt;/td&gt;
&lt;td&gt;&lt;code&gt;docker pull vllm/vllm-openai:v0.30.0-ubuntu2404&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;CUDA 12.9 + Ubuntu 24.04&lt;/td&gt;
&lt;td&gt;&lt;code&gt;docker pull vllm/vllm-openai:v0.30.0-cu129-ubuntu2404&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;ROCm&lt;/td&gt;
&lt;td&gt;&lt;code&gt;docker pull vllm/vllm-openai-rocm:v0.30.0&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;CPU&lt;/td&gt;
&lt;td&gt;&lt;code&gt;docker pull vllm/vllm-openai-cpu:v0.30.0&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;XPU&lt;/td&gt;
&lt;td&gt;&lt;code&gt;docker pull vllm/vllm-openai-xpu:v0.30.0&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;h3&gt;Other Artifacts&lt;/h3&gt;
&lt;p&gt;Pre-built release artifacts are available in the &lt;strong&gt;Assets&lt;/strong&gt; section at the bottom of this page, including:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Source distribution tarball&lt;/li&gt;
&lt;li&gt;CUDA 12.9 Python wheels for x86_64 and arm64&lt;/li&gt;
&lt;li&gt;CUDA 13.0 Python wheels for x86_64 and arm64&lt;/li&gt;
&lt;li&gt;CPU Python wheels for x86_64, arm64, and macOS&lt;/li&gt;
&lt;li&gt;XPU Python wheel for x86_64&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;Model Support&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;New models&lt;/strong&gt;: DeepSeek-V4.1-Flash (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5409122751&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56214&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56214/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56214&quot;&gt;#56214&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5409365356&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56228&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56228/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56228&quot;&gt;#56228&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5408920204&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56208&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56208/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56208&quot;&gt;#56208&lt;/a&gt;), DeepSeek-V4-Flash-Vision-Exp (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5300261368&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/54566&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/54566/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/54566&quot;&gt;#54566&lt;/a&gt;) with ROCm support (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5333912209&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55107&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55107/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55107&quot;&gt;#55107&lt;/a&gt;) and LoRA (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5386859426&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55897&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55897/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55897&quot;&gt;#55897&lt;/a&gt;), GLM-5.3-Flash (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5258035817&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/53906&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/53906/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/53906&quot;&gt;#53906&lt;/a&gt;), K2-Horizon with its reasoning and tool parsers (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5331522440&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55063&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55063/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55063&quot;&gt;#55063&lt;/a&gt;), Cohere Compass (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5312291842&quot; data-permission-text=&quot;Title is priva