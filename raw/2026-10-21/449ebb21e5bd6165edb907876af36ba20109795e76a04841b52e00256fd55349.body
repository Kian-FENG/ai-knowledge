09 93 378T250 448Q340 448 405 380T471 215Q471 120 407 55T250 -10Q153 -10 91 57T28 214ZM250 30Q372 30 372 193V225V250Q372 272 371 288T364 326T348 362T317 390T268 410Q263 411 252 411Q222 411 195 399Q152 377 139 338T126 246V226Q126 130 145 91Q177 30 250 30Z" transform="translate(306,0)"></path><path data-c="69" d="M69 609Q69 637 87 653T131 669Q154 667 171 652T188 609Q188 579 171 564T129 549Q104 549 87 564T69 609ZM247 0Q232 3 143 3Q132 3 106 3T56 1L34 0H26V46H42Q70 46 91 49Q100 53 102 60T104 102V205V293Q104 345 102 359T88 378Q74 385 41 385H30V408Q30 431 32 431L42 432Q52 433 70 434T106 436Q123 437 142 438T171 441T182 442H185V62Q190 52 197 50T232 46H255V0H247Z" transform="translate(806,0)"></path><path data-c="6E" d="M41 46H55Q94 46 102 60V68Q102 77 102 91T102 122T103 161T103 203Q103 234 103 269T102 328V351Q99 370 88 376T43 385H25V408Q25 431 27 431L37 432Q47 433 65 434T102 436Q119 437 138 438T167 441T178 442H181V402Q181 364 182 364T187 369T199 384T218 402T247 421T285 437Q305 442 336 442Q450 438 463 329Q464 322 464 190V104Q464 66 466 59T477 49Q498 46 526 46H542V0H534L510 1Q487 2 460 2T422 3Q319 3 310 0H302V46H318Q379 46 379 62Q380 64 380 200Q379 335 378 343Q372 371 358 385T334 402T308 404Q263 404 229 370Q202 343 195 315T187 232V168V108Q187 78 188 68T191 55T200 49Q221 46 249 46H265V0H257L234 1Q210 2 183 2T145 3Q42 3 33 0H25V46H41Z" transform="translate(1084,0)"></path><path data-c="74" d="M27 422Q80 426 109 478T141 600V615H181V431H316V385H181V241Q182 116 182 100T189 68Q203 29 238 29Q282 29 292 100Q293 108 293 146V181H333V146V134Q333 57 291 17Q264 -10 221 -10Q187 -10 162 2T124 33T105 68T98 100Q97 107 97 248V385H18V422H27Z" transform="translate(1640,0)"></path></g></g></g></g></g></g></g></g></g></svg></section></span></section><section style="font-size: 16px;color: rgb(161, 109, 81);padding-top: 8px;"><span leaf="">式(8)对称跨模态注意力融合</span></section></section></section></section></section></section></section><section data-section-id="conclusion" data-template-split-unit="paper-conclusion" style="box-sizing: border-box;margin: 10px 14px 36px;background: rgb(255, 255, 255);border: 1px solid rgb(243, 195, 113);border-radius: 10px;padding: 18px 17px;font-size: 16px;line-height: 1.9;color: rgb(51, 51, 51);text-align: justify;"><section style="font-size: 19px;font-weight: 600;color: rgb(185, 83, 31);margin-bottom: 9px;"><span leaf="">实验的结果和边界：怎么去读呢？</span></section><section><strong data-emphasis-role="result" style="color: rgb(73, 139, 87);"><span leaf="">在EPVS上</span></strong><span leaf="">Ours(Med)DSC=0.7326、HD95=7.35，好于对比中的MedNeXt的0.7085、8.17；</span><strong data-emphasis-role="result" style="color: rgb(73, 139, 87);"><span leaf="">在 BraTS 上</span></strong><span leaf="">DSC=0.8528、HD95=4.43，比MedNeXt的0.8314、7.59要好一些。</span><strong data-emphasis-role="result" style="color: rgb(73, 139, 87);"><span leaf="">在 WMH 上</span></strong><span leaf="">DSC=0.80，HD95=6.22，IAVD=0.171，参数量只有2.665M。</span></section><section nodeleaf="" style="text-align: center;"><img  data-src="https://static.leiphone.com/uploads/new/images/20261019/6ad5eef4392d2.png" class="rich_pages wxw-img" data-ratio="0.4424778761061947" data-s="300,640" data-type="png" data-w="565" type="block" data-imgfileid="100009621" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261019/6ad5eef4392d2.png?imageMogr2/quality/90"/></section><section style="margin-top: 12px;"><span leaf="">论文还对BraTS中20%和30%轴向切片的保留情况进行考察，并且分别重新训练了每个模型，在两种不同的设置下取得了最好的DSC/HD95；但</span><strong data-emphasis-role="warning" style="color: rgb(230, 112, 76);"><span leaf="">这不是同一个权重直接跨退化等级测试</span></strong><span leaf="">。额外的高斯噪声是作为补充来验证的。</span></section><section nodeleaf="" style="text-align: center;"><img  data-src="https://static.leiphone.com/uploads/new/images/20261019/6ad5eef45a930.png" class="rich_pages wxw-img" data-ratio="0.3344887348353553" data-s="300,640" data-type="png" data-w="577" type="block" data-imgfileid="100009622" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261019/6ad5eef45a930.png?imageMogr2/quality/90"/></section><section style="margin-top: 12px;"><strong data-emphasis-role="technical" style="color: rgb(60, 112, 198);"><span leaf="">消融实验：</span></strong><span leaf="">在EPVS中，BaselineDSC为0.7146；组合LACE+IMSH+MBCF之后的Ours(Base)为0.7322，表示这三个模块之间存在互相补充的作用。在EPVS上已经严重退化的地区，模型主要是防止污染破坏T1，并不是“凭空恢复”T2/FLAIR已经丢失的信息。</span></section><section style="margin-top: 12px;"><strong data-emphasis-role="warning" style="color: rgb(230, 112, 76);"><span leaf="">研究边界：</span></strong><span leaf="">主要问题就是空间对齐之后的分辨率下降，并不是所有的模态都缺失了，也没有解决所有的强噪声场景。未来的方向是动态模态缺失以及更多的采集伪影。</span></section></section></section><section class="mp_profile_iframe_wrp" nodeleaf=""><mp-common-profile class="js_uneditable custom_select_card mp_profile_iframe" data-pluginname="mpprofile" data-nickname="多模态信息融合" data-alias="MMIFusion" data-from="0" data-headimg="http://mmbiz.qpic.cn/mmbiz_png/ib4sMSrGcHAvVia4JEc0MgA4gsDe5TKs6RC6nDZWlFk5OA9dUs53hlsbXuBAGAXdJjMJucNxeVW6iaN8sd0rZYI4Q/0?wx_fmt=png" data-signature="多模态图像融合｜智能感知｜论文解读、科研思考" data-id="MzYzMzIzOTk3MA==" data-is_biz_ban="0" data-service_type="1" data-verify_status="1"></mp-common-profile></section><p data-mid="" data-mpa-module-spacer="true" data-mpa-spacer="true" style="line-height: 23px;"><span leaf=""><br/></span></p><p data-mid="" data-mpa-module-spacer="true" data-mpa-spacer="true" style="line-height: 22px;"><span leaf=""><br/></span></p><p data-mid="" data-mpa-module-spacer="true" data-mpa-spacer="true" style="line-height: 22px;"><span leaf=""><br/></span></p><section data-mid="" data-mpa-category="模板" data-mpa-internal-spacing="paragraphs" data-mpa-template="t" style="box-sizing: border-box;width: 100%;min-width: 0px;display: flex;flex-direction: column;"><section data-mid="" data-mpa-category="模板" data-mpa-spacer-mode="line-height" data-mpa-template="t" data-template-split-unit="ending-divider" style="box-sizing: border-box;width: 100%;min-width: 0px;font-family: system-ui;"><section data-mid="" style="box-sizing: border-box;padding: 0px 14px;"><section data-ignore-width="" data-mid="" data-mpa-anchor="413:415" data-mpa-attachment="module-overlay" data-mpa-role="decoration" nodeleaf="" style="box-sizing: border-box;font-size: 0px;line-height: 0;max-width: 100%;flex-shrink: 0;width: 100%;"></section></section></section><section data-mid="" data-mpa-category="模板" data-mpa-spacer-mode="line-height" data-mpa-template="t" data-template-split-unit="recommendations" yb-mpa-mark="mark-main" style="box-sizing: border-box;width: 100%;min-width: 0px;font-family: system-ui;padding: 0px 12.89px;"><section data-mid="" data-mpa-internal-spacing="paragraphs" style="box-sizing: border-box;"><section data-mid="" style="box-sizing: border-box;display: flex;justify-content: center;"><section data-mid="" data-mpa-anchor="413:410" data-mpa-attachment="module-background" data-mpa-containment="label" data-mpa-containment-base="" data-mpa-stretch="" data-no-dark="" style="background-image: url(&quot;https://mmbiz.qpic.cn/sz_mmbiz_png/F11prZlXXxQwKLXuIibeCBaiaXUURUtx30eqvTNLUpTAZjUBygTVcmHxCKrfBCftFTBnoSWGX8rcuGRibF8JCsefyHHtPZstUAC8ibjgRvYddl8/640?from=appmsg&quot;);background-repeat: no-repeat;background-size: 142.33px 14px;box-sizing: border-box;display: flex;align-items: center;column-gap: 18px;width: fit-content;max-width: 100%;background-position: center bottom;"><section data-ignore-width="" data-mid="" data-mpa-anchor="413:410" data-mpa-attachment="module-overlay" data-mpa-role="decoration" nodeleaf="" style="box-sizing: border-box;font-size: 0px;line-height: 0;max-width: 100%;flex-shrink: 0;width: 20px;"><br/></section></section></section><section data-mid="" style="box-sizing: border-box;display: grid;grid-template-columns: minmax(0px, 1fr);padding-bottom: 8px;"><section data-ignore-width="" data-mid="" data-mpa-anchor="413:401" data-mpa-attachment="module-overlay" data-mpa-role="decoration" nodeleaf="" style="box-sizing: border-box;font-size: 0px;line-height: 0;max-width: 100%;flex-shrink: 0;grid-area: 1 / 1;width: 126px;place-self: end;margin-right: -7px;margin-bottom: -8px;"><img  data-src="https://static.leiphone.com/uploads/new/images/20261019/6ad5eef6d966d.jpg" class="rich_pages wxw-img" data-ratio="0.33" data-w="500" style="display: block;width: 100%;max-width: 100%;height: auto;object-fit: contain;background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261019/6ad5eef6d966d.jpg?imageMogr2/quality/90"/></section></section></section></section><p data-mid="" data-mpa-spacer="true" style="line-height: 16px;"><span leaf=""><br/></span></p><section data-mid="" data-mpa-category="模板" data-mpa-spacer-mode="line-height" data-mpa-template="t" data-template-split-unit="footer" style="box-sizing: border-box;width: 100%;min-width: 0px;font-family: system-ui;"><section data-mid="" style="box-sizing: border-box;display: grid;grid-template-columns: minmax(0px, 1fr);"><section data-ignore-width="" data-mid="" data-mpa-anchor="413:417" data-mpa-attachment="module-background" data-mpa-role="decoration" nodeleaf="" style="box-sizing: border-box;font-size: 0px;line-height: 0;max-width: 100%;flex-shrink: 0;grid-area: 1 / 1;place-self: end;width: 42.5083%;"><br/></section></section></section></section></section><p style="display: none;"><mp-style-type data-value="3"></mp-style-type></p>]]></description>
