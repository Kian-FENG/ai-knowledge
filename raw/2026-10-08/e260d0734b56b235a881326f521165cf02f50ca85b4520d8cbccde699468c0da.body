&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;ROCm&lt;/td&gt;
&lt;td&gt;&lt;code&gt;pip install vllm --extra-index-url https://wheels.vllm.ai/rocm/0.30.0/rocm723&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;XPU&lt;/td&gt;
&lt;td&gt;&lt;code&gt;uv pip install vllm --extra-index-url https://wheels.vllm.ai/0.30.0/xpu --extra-index-url https://download.pytorch.org/whl/xpu --index-strategy unsafe-best-match&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;h3&gt;Docker Images&lt;/h3&gt;
&lt;table&gt;
&lt;thead&gt;
&lt;tr&gt;
&lt;th&gt;Platform&lt;/th&gt;
&lt;th&gt;Docker Image&lt;/th&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td&gt;CUDA 13.0 (Default)&lt;/td&gt;
&lt;td&gt;&lt;code&gt;docker pull vllm/vllm-openai:v0.30.0&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;CUDA 12.9&lt;/td&gt;
&lt;td&gt;&lt;code&gt;docker pull vllm/vllm-openai:v0.30.0-cu129&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;CUDA 13.0 + Ubuntu 24.04&lt;/td&gt;
&lt;td&gt;&lt;code&gt;docker pull vllm/vllm-openai:v0.30.0-ubuntu2404&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;CUDA 12.9 + Ubuntu 24.04&lt;/td&gt;
&lt;td&gt;&lt;code&gt;docker pull vllm/vllm-openai:v0.30.0-cu129-ubuntu2404&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;ROCm&lt;/td&gt;
&lt;td&gt;&lt;code&gt;docker pull vllm/vllm-openai-rocm:v0.30.0&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;CPU&lt;/td&gt;
&lt;td&gt;&lt;code&gt;docker pull vllm/vllm-openai-cpu:v0.30.0&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;XPU&lt;/td&gt;
&lt;td&gt;&lt;code&gt;docker pull vllm/vllm-openai-xpu:v0.30.0&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;h3&gt;Other Artifacts&lt;/h3&gt;
&lt;p&gt;Pre-built release artifacts are available in the &lt;strong&gt;Assets&lt;/strong&gt; section at the bottom of this page, including:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Source distribution tarball&lt;/li&gt;
&lt;li&gt;CUDA 12.9 Python wheels for x86_64 and arm64&lt;/li&gt;
&lt;li&gt;CUDA 13.0 Python wheels for x86_64 and arm64&lt;/li&gt;
&lt;li&gt;CPU Python wheels for x86_64, arm64, and macOS&lt;/li&gt;
&lt;li&gt;XPU Python wheel for x86_64&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;Model Support&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;New models&lt;/strong&gt;: DeepSeek-V4.1-Flash (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5409122751&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56214&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56214/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56214&quot;&gt;#56214&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5409365356&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56228&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56228/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56228&quot;&gt;#56228&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5408920204&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56208&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56208/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56208&quot;&gt;#56208&lt;/a&gt;), DeepSeek-V4-Flash-Vision-Exp (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5300261368&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/54566&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/54566/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/54566&quot;&gt;#54566&lt;/a&gt;) with ROCm support (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5333912209&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55107&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55107/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55107&quot;&gt;#55107&lt;/a&gt;) and LoRA (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5386859426&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55897&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55897/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55897&quot;&gt;#55897&lt;/a&gt;), GLM-5.3-Flash (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5258035817&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/53906&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/53906/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/53906&quot;&gt;#53906&lt;/a&gt;), K2-Horizon with its reasoning and tool parsers (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5331522440&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55063&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55063/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55063&quot;&gt;#55063&lt;/a&gt;), Cohere Compass (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5312291842&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/54774&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/54774/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/54774&quot;&gt;#54774&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5390134119&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55949&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55949/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55949&quot;&gt;#55949&lt;/a&gt;), Bailing V3 VL with MTP (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5388381667&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55921&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55921/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55921&quot;&gt;#55921&lt;/a&gt;), Nanbeige4.2 via the Transformers backend (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5399048608&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56071&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56071/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56071&quot;&gt;#56071&lt;/a&gt;), and a DeepSeek-V4 CPU backend (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5349965707&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55355&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55355/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55355&quot;&gt;#55355&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;DeepSeek-V4.1-Flash&lt;/strong&gt;: whole KV in MXFP8 through the FlashMLA V4.1 record on SM100 (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5454295848&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56893&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56893/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56893&quot;&gt;#56893&lt;/a&gt;), Mega-mHC from the DeepGEMM fork (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5458551962&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56962&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56962/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56962&quot;&gt;#56962&lt;/a&gt;), mHC post block folded into the delayed pre projection (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5435527842&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56633&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56633/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56633&quot;&gt;#56633&lt;/a&gt;), Triton-fused input metadata preparation (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5431027543&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56562&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56562/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56562&quot;&gt;#56562&lt;/a&gt;), async prefetch for CPU-offloaded Engram lookups and Engram DP sharding (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5428318474&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56512&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56512/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56512&quot;&gt;#56512&lt;/a&gt;), DSpark draft states collapsed before the SP all-gather (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5455134074&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56903&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56903/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56903&quot;&gt;#56903&lt;/a&gt;), DSpark drafter no longer inheriting uninitialized EPLB state (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5419991043&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56387&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56387/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56387&quot;&gt;#56387&lt;/a&gt;), XGrammar V4.1 schema constraints for strict tool parameters (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5420857642&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56408&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56408/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56408&quot;&gt;#56408&lt;/a&gt;), Responses text parts (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5413886338&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56299&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56299/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56299&quot;&gt;#56299&lt;/a&gt;), and image sentinel padding scoped to the Vision-Exp checkpoint (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5430660717&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56554&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56554/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56554&quot;&gt;#56554&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;DeepSeek V4&lt;/strong&gt;: plain RoPE without YaRN on sparse SWA layers (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5314876595&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/54815&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/54815/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/54815&quot;&gt;#54815&lt;/a&gt;), &lt;code&gt;--kv-cache-dtype auto&lt;/code&gt; resolving to &lt;code&gt;fp8_ds_mla&lt;/code&gt; with FlashMLA (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;4627290408&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/45091&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/45091/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/45091&quot;&gt;#45091&lt;/a&gt;), prefill sparse index workspace sentinel seeded (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5345894092&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55299&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55299/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55299&quot;&gt;#55299&lt;/a&gt;), dequant gather grid sized by rows (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5331466796&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55061&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55061/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55061&quot;&gt;#55061&lt;/a&gt;), optional Q-norm in the fused MLA epilogue and group_size=32 packed FP8 quant (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5409131238&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56215&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56215/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56215&quot;&gt;#56215&lt;/a&gt;), sparse settings read from the text config for composite models (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5405179257&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56160&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56160/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56160&quot;&gt;#56160&lt;/a&gt;), MegaMoE startup without EP fixed (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5387993619&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55914&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55914/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55914&quot;&gt;#55914&lt;/a&gt;), and a Triton iHC pre/post fallback for HY V4 (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5331395953&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55059&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55059/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55059&quot;&gt;#55059&lt;/a&gt;).&lt;/li&gt;
