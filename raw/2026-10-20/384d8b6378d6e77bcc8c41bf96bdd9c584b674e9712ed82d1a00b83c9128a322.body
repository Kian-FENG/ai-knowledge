1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：主要迭代什么环节？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：现在大家最担心的是，打印速度快，能不能打得好。我们是先保证打得好，再打得快。简单来讲，拓竹的 H2C 虽然搭载了 7 个喷嘴，但只能轮流作业。快造的四喷头方案也是一样，换头才能继续打印。</span></span><strong><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">而我们的四喷头打印方案，支持四头同时工作，不用等待切换打印头。</span></span></strong></section><section style="text-align: center;" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261019/6ad5b57d92d4d.png" class="rich_pages wxw-img" data-ratio="0.5625" data-s="300,640" data-type="png" data-w="1280" type="block" data-imgfileid="506863935" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261019/6ad5b57d92d4d.png?imageMogr2/quality/90"/></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvaunfzr1e4t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：这听起来还挺强的。稳定性如何呢？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：稳定性比拓竹的高一两个数量级，精度高 100 倍。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvaunj0v1nz9"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：怎么做到啊？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：拓竹、快造用的电机，都是比较有性价比的步进电机。我们用的电机是工业级的直线电机，过往主要用在半导体领域，精度都是微米级。</span></span><strong><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">因为直线电机的精度和可靠性高，整个设备体系的精度和可靠性也随之提升了。</span></span></strong><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">打得又快又稳。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvaunmw2210d"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：你们采用工业级的直线电机方案，有受到什么启发？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：从需求出发，大部分人觉得 3D 打印机速度慢，打印一个模型要等几个小时。打照片一分钟搞定，打印模型至少几小时，这种需求没被满足，离用户预期还很远。</span></span><strong><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">3D 打印要进入家庭和大众消费，还有很长的路要走，速度可能需要提升几千倍。</span></span></strong></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvaunq9kd6j"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：除了电机方案，你们前期在产品方向上尝试过其他方案吗？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：换头、换热端以及热端升降等方案，我们都有调研过。</span></span><strong><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">我们之所以选择直线电机方案，更多是觉得它是最优解</span></span></strong><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">，为什么呢？首先我们的四喷头打印机不用换头，省时间，永远是最优解。第二，你购买的一台打印机，标称能打印最大幅面，但实际打印未必每次都用到最大，空间浪费比例很高。从节约空间的角度出发，多头同时打印才是真正的节约空间。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvaunu4410px"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：市面上有做双头打印的，也有不少做四头打印的，你们规划的上限是多少？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：四头打印是起点，下一代是 16 头，再往下一代是 64 头，再往下是 256 头。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvaunxqcku0"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：现在是什么进度？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：16 头和 64 头已经规划好了，只是机器还没做出来。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauo1a74it"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：四头打印已经被验证了，16 头、64 头的可行性来自于哪里？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：</span></span><strong><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">我们的 16 头机器和 4 头机器的大小是一样的，只是打印头的尺寸变小了。</span></span></strong><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">以后我把喷头的尺寸做得更小，64 喷头跟 16 喷头的机器还是一样大小，喷头尺寸会再缩小一半。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauo4sy101d"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：这个想法是什么时候开始萌生的？在第一代产品做到哪个节点的时候？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：我们在做第一代产品就想过，我们要走制造的路径，我们要把制造的效率提升几百倍，而不是几倍。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauo8j61a2t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：刚刚你说你们前面已经调研了很多其他的方案，最终才选了四喷头的方案。相比快造、闪铸的四喷头打印机，肉眼看上去，你们这款产品的架构挺不一样的，这个出发点又是怎么考虑的？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：我们有两个横梁，每个横梁上面有两个头。目前很少有公司会在一个横梁上做两个头，因为皮带驱动不稳定，一个头已经有重量，两个头更重，需要更大的电机推力，而常规步进电机的推力和皮带伸缩性不够，很难实现一个横梁装两个头，更别说四个或 16 个。我们采用直线电机，横梁推力达到 110 N，是常规步进电机的很多倍。有这个金刚钻，才敢揽这个瓷器活。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauobxl22ks"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：对比拓竹或者其他产品，你们的四个喷头有什么优势？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：第一，你摆四台机器要留间距，浪费空间，而我一台机器只比单台大一点，却能顶四台，节约 75% 的空间。第二，时间上，你打一个模型，我能打四个，同样节约 75% 的时间。第三，材料和人工方面，开机率更高，材料成本节约一半，人工也节约一半。第四，管理上，原来一个人管四台，现在管一台；如果原来是 400 台，现在只需 100 台，管理大大简化。以后如果有 16 头的机器，别人需要 1600 台，我这里只需要很少的台数。</span></span></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">我们的这个逻辑遥遥领先。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" data-mpa-action-id="mvav6skn193f" data-pm-slice="0 0 []"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mhjx5w77pk" data-pm-slice="0 0 []"><section mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mgoj6tx51ies" data-pm-slice="0 0 []"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section style="width: 72px;height: 34px;background: #F2F2F2;border-radius: 50%;font-weight: bold;font-size: 22px;color: #262626;line-height: 34px;text-align: center;" data-mid="" mpa-from-tpl="t"><section mpa-content-none="t" data-mid="" mpa-from-tpl="t"><span leaf="" mpa-is-content="t">04</span><span leaf=""><br/></span></section></section><section style="font-weight: bold;font-size: 18px;color: rgb(39, 79, 146);line-height: 25px;margin-top: 4px;" data-mid="" mpa-from-tpl="t"><section data-mid="" mpa-from-tpl="t" style="text-align: center;"><span leaf="" mpa-is-content="t"><span textstyle="" style="letter-spacing: 0.5px;">从打印机到耗材机，轻量智造到底想做多大的生意？</span></span><span leaf=""><br/></span></section></section></section></section></section></section></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauofhtd35"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：有说法称小 B 用户买了咱们的产品，ROI 提升 10 倍以上。这是怎么计算出来的？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：精益制造里有个概念叫人机料法——人力成本、机器设备效率、材料、管理方法。这几件事都搞好了，效率就会不断循环提升。从人的维度看，我们的机器能做到模型打印完自动取出来，别人不用开晚班，很多农场现在都要开晚班去拿模型。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauoisy1spf"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：就是不用人力再干预了。</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：对。我可以让它节约一半的人力，不用开晚班，这是第一个维度。</span></span></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">第二，我的机器产能是拓竹的 4 倍。打常规单色或幻彩模型，包括龙蛋，拓竹设备打一个，我同时打 4 个，因为 4 个喷头可以同时工作。4 倍产能，节约一半人工。材料维度，我们可以提供比拓竹或同类公司低一半的耗材成本。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauoqt01dee"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：耗材的成本降低是因为什么？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：很多人问是不是把毛利降低一点？我想说我们的毛利不会降低，可能还要提升，但会把用户售价降低一半。逻辑是：现在的耗材——不管是拓竹还是其他 3D 打印公司——都是把美国 PLA 颗粒买回来，拉成线再卖到用户，成本从 3 美金一公斤变成 15 美金一公斤。这完全是多余的，买过来又拉回去。</span></span></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><strong><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">我们提供了一个桌面化解决方案，替代生产线大设备，用户可以在美国的农场或家里直接买 3 美金的颗粒，自己拉成线，花 6-7 美金就能在家生产耗材了。</span></span></strong></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauowei1939"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;font-weight: bold;">雷峰网·鲸犀：这个方案，相当于耗材直接在美国本土化。</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：第一叫减少中间环节，没有机会赚差价。第二，拉过来拉过去，浪费很多物流成本。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvaup1u01mjo"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：这个工具是你们自研？定价是多少？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：我们自己研发的。这个机器定价 1000+ 美金。它一天可以生产 30 公斤耗材，每公斤节约 7 美金，一天能省下 200 多美金，一周就能回本。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvaup6ii1id2"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：一周就能回本。有其他同行在做这个事情吗？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：目前没有人做这个事。而且我们这个工具会颠覆整个耗材的行业逻辑。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvaupbyszzj"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：影响这么大吗？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：那卖卷料的就卖不下去了。所以我们以后可能光是耗材机这个设备，都有可能做到比拓竹更大的规模。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvaupjabepo"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：创想三维做了一款 3D 耗材回收机。</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：他们确实也做了这样的一个产品。但是我们的侧重点不一样。创想三维那款侧重的是废料的回收，它是把用过的废料碾碎，混色，再掺点新料，做批量生产。我们做的是新料的生产，可不支持废料回收。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvaupmhjzrd"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：但使用这个是有门槛的，不是所有人都需要这个耗材机。</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：如果年用几百卷，就可以考虑；如果只用两卷，就没必要。</span></span></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">我们是为相对资深的用户设计产品，针对 Pro C 和 SMB 这类有经验的专业客户——他们用量大，三五台机器不停运转，省起来就很划算。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvaupptww1o"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：除了核心的产品，还有两个针对不同细分场景的产品。除了这个，另外一个是啥？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：另外一款是自动取模型的，也是一个配件，定价几百美金。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvaupv521ay8"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：这个工具好，我之前打印过一个模型，取模型的时候就被割伤了。</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：所有取过模型的人都流过血，我也流过。虽然是塑料的，但是一样会让你获得“血的教训”。</span></span></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">取模型还是不方便，远没到安全迅速、打印完直接拿了就用的地步，3D 打印机离那一天还很远。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauq3u614y0"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：你们对发货有做预期吗？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：我们今年 11 月份就会发货。7 月份，我们已经有 50 台打印机发货了，还有 200 台在产线，相当于我们已经有 250 台机器。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauq95zc3s"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：产能怎么做到的？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：我们的制造是在一家特别大的公司，叫欣旺达。所以制造管够，一天 400 台。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauqdt111fh"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;font-weight: bold;">雷峰网·鲸犀：背后有高人牵线吗？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：确实有高人牵线，是我以前在华为的朋友介绍的。</span></span></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">欣旺达有个 3C 事业部，现在做扫地机、泳池机器人。他们跟我讲了投资元鼎的故事：当时元鼎还很小，他们投了几百万，帮他们做制造、做改进，一直迭代——现在元鼎已经是泳池机器人 TOP1。</span></span></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">他们有这种超前培养、和公司一起成长的意识。我们聊后一拍即合，相互认可，所以他们也愿意进入这个赛道。</span></span></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">他们为我们单开了一栋楼，因为一条产线摆不下。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauqi3fkxa"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：跟他们合作，他们有什么硬性的门槛吗？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：他们不是什么都做，也会看领域。我们行业目前处于快速增长期，算是红利期，这可能是他们愿意进入的一个重要原因。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauqlcsp5j"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：会不会有其他家也在跟进方案呢？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：有些人会跟进类似方案，比如也用直线电机，但没人像我们这样用于制造、农场。我们了解到，有些公司的直线电机产品还是针对消费级、个人场景。</span></span></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">大家场景不同，就像同一口锅，可以炒青菜也可以炒荤菜，关键看老板想往哪个方向走。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauqol6q6"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：有哪些在做类似的？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：以前富志做过一款用雅科贝思直线电机的 3D 打印机，卖二三十万一台。这属于大机器。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauqrqn1ky2"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：咱们在 3D 生成这一块有布局吗？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：短期内，我们不会自己做这类基础性投入。我们还没到这个阶段，会选择外部合作，借助别人已有的 AI 能力来赋能。</span></span></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">但如果农场、小作坊或用户对某些模型很感兴趣，我们也会收集一些有意思的模型供大家选择，这个成本不高。我们会选择畅销、热门的模型，不会做那种几百万个没人要的。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauquyqxha"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：设想一下，你们的社区或平台建设逻辑是怎样的？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：我们的用户主要是工程师、设计师，设计能力较强，属于资深人群。我们做的是 Pro C 类产品，更多是提供参考或便利，他们本身就有很强的设计能力。所以我们不会做小白类内容，人群不同，诉求不同，平台建设逻辑也不一样。</span></span></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">我们更倾向于用 AI 来做设计，而不是等别人做好设计再来选择。目前 3D 生成有两个方向：一是用 AI 控制传统设计软件，让设计师更高效、更快完成工作；二是不需要设计师，输入一句话或拍张照就能生成设计，属于傻瓜式。我们更倾向第一种，帮助设计师提高效率，比如原来花一天，现在可能半小时就够了。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mvauqyprzg6"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muf8tesq1b7f" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #4499E7;">雷峰网·鲸犀：你怎么看 3D 打印在欧美制造业中的机会？</span></span></strong></span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">王志宇：结合现在中美博弈的背景，美国现在大举推行&quot;美国制造&quot;这个概念，动不动就给补贴，只要你搬回一个供应链，美国就给你补多少钱。我们会更多地通过 3D 打印去帮助美国把制造做得更好。我觉得在未来欧美的主力制造领域，3D 打印有非常大的发展空间，远不只是一个玩具市场。</span></span></section><section style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;visibility: visible;margin-top: 24px;"><span leaf="" style="font-size: 15px;visibility: visible;"><span textstyle="" style="letter-spacing: 0.5px;">我们公司取的名字叫轻量智造，没有取什么&quot;什么三维&quot;——轻量智造的解读就是：一整套的轻量化制造解决方案。它不局限在 3D 打印这个点，而是怎么样把这种大设备、大制造变成一个小制造，让它回归到原产地、回归到用户那里去：在欧洲、在美国、在各种小镇上面，我就能自己给自己造东西，我不需要依赖一个远在太平洋彼岸的大工厂。我们是在给未来制造递铲子的人。</span></span></section></section></section></section></section><section style="text-align: center;" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261019/6ad5b57db267c.jpg" class="rich_pages wxw-img" data-ratio="0.40816326530612246" data-s="300,640" data-type="jpeg" data-w="735" type="block" data-imgfileid="506863119" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261019/6ad5b57db267c.jpg?imageMogr2/quality/90"/></section><section style="text-align: center;" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261019/6ad5b57dd5b2c.jpg" class="rich_pages wxw-img" data-ratio="0.4087193460490463" data-s="300,640" data-type="jpeg" data-w="734" type="block" data-imgfileid="506863188" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261019/6ad5b57dd5b2c.jpg?imageMogr2/quality/90"/></section>]]></description>
