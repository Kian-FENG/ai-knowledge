RaEK4NUAzDn3AJZic6c6btNibtXv5yibvpU7H7PfnrK0icia0QDg/0" data-username="v2_060000231003b20faec8c4e38a1ec3ddcd04ed36b077dbb450d2d73c89ee8dbd03b0d784507f@finder" data-nickname="左林右狸" data-desc="自动驾驶是具身智能的上半场，而通用人形机器人是具身智能下半场 #李想称具身智能分上下半场 #理想汽车 #李想 #全新理想L9 #具身智能" data-nonceid="11957533650166539562" data-width="1080" data-height="1440" data-type="video" data-id="export/UzFfBgAAxMGDYBhDCX_3jMzT4DCLrK4sXJUjqhp0ltKA_F1qcg"></mp-common-videosnap></section><section data-mpa-template="t" mpa-from-tpl="t" style="letter-spacing: 0.578px;" data-mpa-action-id="mpqnm1fv1rht" data-pm-slice="0 0 []"><section data-mid="" mpa-from-tpl="t" style="display: flex;flex-direction: column;"><section data-mid="" mpa-from-tpl="t" style="display: flex;align-self: center;"><section data-mid="" mpa-from-tpl="t" style="width: 14px;height: 12px;display: flex;justify-content: center;align-items: center;flex-shrink: 0;align-self: center;" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261019/6ad5886c79db8.png" class="rich_pages wxw-img" data-ratio="0.8571428571428571" data-type="png" data-w="28" style="background-color: transparent;height: auto !important;" data-imgfileid="500984958" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261019/6ad5886c79db8.png?imageMogr2/quality/90"/></section><section data-mid="" mpa-from-tpl="t" style="padding-right: 5px;padding-left: 5px;text-align: center;"><p data-mid="" style="font-size: 16px;font-family: PingFangSC-Semibold, &quot;PingFang SC&quot;;font-weight: bold;color: rgb(76, 86, 57);line-height: 22px;letter-spacing: 2px;word-break: break-all;"><span leaf="">往期推荐</span></p></section><section data-mid="" mpa-from-tpl="t" style="width: 14px;height: 12px;flex-shrink: 0;display: flex;justify-content: center;align-items: center;align-self: center;" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261019/6ad5886c96b2c.png" class="rich_pages wxw-img" data-ratio="0.8571428571428571" data-type="png" data-w="28" style="background-color: transparent;height: auto !important;" data-imgfileid="500984959" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261019/6ad5886c96b2c.png?imageMogr2/quality/90"/></section></section></section></section><section data-mpa-template="t" data-from="yb-recommend-list" data-mpa-action-id="mu2da03i1jzk" data-pm-slice="0 0 []"><section data-mpa-template="t" data-from="yb-recommend" data-recommend-article-type="normal" data-recomment-template-id="1" data-recommend-article-id="1000000267_1" data-recommend-article-time="1789380000" data-recommend-article-cover="https://mmbiz.qpic.cn/mmbiz_jpg/IGbhG85vhxF9APr351lA6pW0dm5qVECYWy2K7BhHlhCaJEiaarJnZvKfwgw5yrJgeFmNZqoyEhStEEXoTGQqKE4uLiayGS0mcFmIjbVMt4E7I/0?wx_fmt=jpeg" data-recommend-article-title="Xspark AI 丁文伯：触觉替代不了视觉，但机器人需要一套自己的“脊髓” ｜物理AI 50人" data-recommend-article-content-url="https://mp.weixin.qq.com/s/S5OMxDVKpswxw7AGBz4FCQ"><section data-recommend-type="normal" data-recommend-tid="1" style="width: 100%;display: flex;justify-content: center;align-items: center;" data-mid=""><section style="width: 100%;background: #ffffff;display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid=""><section style="width: 100%;display: flex;justify-content: center;align-items: center;" data-mid=""><span style="width: 100%;flex:1;" class="js_jump_icon h5_image_link"><a href="https://mp.weixin.qq.com/s?__biz=MjM5ODU2NTIwMA==&mid=2648468881&idx=1&sn=2913ac47cbd3475fe01b4755cdf63466&scene=21#wechat_redirect" target="_blank" rel=nofollow><span leaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261019/6ad5886cb7848.jpg" class="rich_pages wxw-img" data-ratio="0.426" data-w="1000" style="width: 100%;max-height: none;object-fit: cover;background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261019/6ad5886cb7848.jpg?imageMogr2/quality/90"/></span></a></span></section><sect