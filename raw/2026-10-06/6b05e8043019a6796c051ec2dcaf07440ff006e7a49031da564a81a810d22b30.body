Map&quot;:{},&quot;isCut&quot;:false}" data-lark-record-format="docx/text"></span><span data-mpa-action-id="mottit0p1adr"></span><span data-lark-record-data="{&quot;rootId&quot;:&quot;HiT6dR6bqoegBFxS6Ztci0eLn5e&quot;,&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;前Covariant AI 副总裁、舟谱数据CTO慕巍博士出任「枢途科技」CTO。&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+15&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7538706056718925852&quot;]},&quot;nextNum&quot;:1}},&quot;type&quot;:&quot;text&quot;,&quot;referenceRecordMap&quot;:{},&quot;extra&quot;:{&quot;channel&quot;:&quot;saas&quot;,&quot;isEqualBlockSelection&quot;:false,&quot;pasteRandomId&quot;:&quot;dfd888fd-3d05-41de-99ef-9e50f4d1eda1&quot;,&quot;mention_page_title&quot;:{},&quot;external_mention_url&quot;:{}},&quot;isKeepQuoteContainer&quot;:false,&quot;isFromCode&quot;:false,&quot;selection&quot;:[{&quot;id&quot;:37,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:3,&quot;end&quot;:44},&quot;recordId&quot;:&quot;HCUjdyERwog1txxNzqYcmirnnBh&quot;}],&quot;payloadMap&quot;:{},&quot;isCut&quot;:false}" data-lark-record-format="docx/text"></span><span data-mpa-action-id="mnzfe1dlmiz"></span><span data-mpa-action-id="mn32l2a062f"></span><span data-mpa-action-id="mmos90171jtf"></span><span data-lark-record-data="{&quot;rootId&quot;:&quot;AzjmduHCvoPVEexzmhKc7S4Enkg&quot;,&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;联创团队刚刚亮相，这家物理AI创业公司的融资与股东阵容也随之浮出水面。&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+z&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7536161670281445404&quot;]},&quot;nextNum&quot;:1}},&quot;type&quot;:&quot;text&quot;,&quot;referenceRecordMap&quot;:{},&quot;extra&quot;:{&quot;channel&quot;:&quot;saas&quot;,&quot;isEqualBlockSelection&quot;:true,&quot;pasteRandomId&quot;:&quot;3ca65e27-5613-4c71-bec7-02bc36dcc7df&quot;,&quot;mention_page_title&quot;:{},&quot;external_mention_url&quot;:{}},&quot;isKeepQuoteContainer&quot;:false,&quot;isFromCode&quot;:false,&quot;selection&quot;:[{&quot;id&quot;:5,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:0,&quot;end&quot;:35},&quot;recordId&quot;:&quot;CuIcdfeCnoYDRFxT9eIcwHljn3Q&quot;}],&quot;payloadMap&quot;:{},&quot;isCut&quot;:false}" data-lark-record-format="docx/text"></span><section style="text-align: left;margin-bottom: 0px;margin-top: 0px;"><span style="font-family: Arial, Helvetica, sans-serif;font-size: 15px;font-weight: bold;letter-spacing: 0.5px;"><span leaf=""><br/></span></span></section></section></section><span data-lark-record-data="{&quot;rootId&quot;:&quot;XVkTdFgTjoSOOfx0zV4cRv7nnDg&quot;,&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;贝塔无限将瞄准万亿消费级机器人蓝海市场。&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+k&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7066985350417170460&quot;]},&quot;nextNum&quot;:1}},&quot;type&quot;:&quot;text&quot;,&quot;referenceRecordMap&quot;:{},&quot;extra&quot;:{&quot;channel&quot;:&quot;saas&quot;,&quot;isEqualBlockSelection&quot;:false,&quot;pasteRandomId&quot;:&quot;d4121fb1-0735-411e-82ac-5446e497d0c2&quot;,&quot;mention_page_title&quot;:{},&quot;external_mention_url&quot;:{}},&quot;isKeepQuoteContainer&quot;:false,&quot;isFromCode&quot;:false,&quot;selection&quot;:[{&quot;id&quot;:6,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:3,&quot;end&quot;:23},&quot;recordId&quot;:&quot;M0FfdVGsRo1taCx2dVBcUm9SnFc&quot;}],&quot;payloadMap&quot;:{},&quot;isCut&quot;:false}" data-lark-record-format="docx/text"></span><span data-lark-record-data="{&quot;rootId&quot;:&quot;HyUOdX3GEoRVXdxcfUfcPgCFn8K&quot;,&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;26年之于具身智能，就是23年之于大语言模型。&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+n&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7066985350417170460&quot;]},&quot;nextNum&quot;:1}},&quot;type&quot;:&quot;text&quot;,&quot;referenceRecordMap&quot;:{},&quot;extra&quot;:{&quot;channel&quot;:&quot;saas&quot;,&quot;isEqualBlockSelection&quot;:false,&quot;pasteRandomId&quot;:&quot;223a8d9b-7e7d-40d4-b910-244b8b09367a&quot;,&quot;mention_page_title&quot;:{},&quot;external_mention_url&quot;:{}},&quot;isKeepQuoteContainer&quot;:false,&quot;isFromCode&quot;:false,&quot;selection&quot;:[{&quot;id&quot;:2,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:4,&quot;end&quot;:27},&quot;recordId&quot;:&quot;JtD7dqrTZoMV7dxZYXYcEJOSn9e&quot;}],&quot;payloadMap&quot;:{},&quot;isCut&quot;:false}" data-lark-record-format="docx/text"></span><span data-mpa-action-id="mkwc1mygyhi"></span><span data-mpa-action-id="mkqn0kmf15uo"></span><p yb-mpa-mark="mark-main-text" style="font-size: 14px;color: rgb(0, 0, 0);line-height: 25px;word-break: break-word;margin-bottom: 0px;margin-top: 0px;" data-mid=""><span leaf="" style="font-family: Arial, Helvetica, sans-serif;" mpa-font-style="mm0fhbt51zfy"><span textstyle="" style="color: #888888; font-weight: normal">&nbsp; &nbsp; 作者丨吴海明</span></span><strong style="-webkit-tap-highlight-color: transparent;margin-right: 0px;margin-left: 0px;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;font-family: Optima-Regular, PingFangTC-light;box-sizing: border-box !important;overflow-wrap: break-word !important;" mpa-from-tpl="t"><span style="-webkit-tap-highlight-color: transparent;margin-right: 0px;margin-left: 0px;padding: 0px;outline: 0px;max-width: 100%;letter-spacing: 0.5px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;"><strong style="-webkit-tap-highlight-color: transparent;margin-right: 0px;margin-left: 0px;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;" mpa-from-tpl="t"><span data-pm-slice="2 2 [&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 16px;padding: 0px;outline: 0px;max-width: 100%;clear: both;min-height: 1em;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);line-height: normal;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;node&quot;,{&quot;tagName&quot;:&quot;strong&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin-top: 0px;margin-bottom: 0px;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" style="-webkit-tap-highlight-color: transparent;margin-right: 0px;margin-left: 0px;padding: 0px;outline: 0px;max-width: 100%;letter-spacing: 0.5px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;"><span leaf="" style="-webkit-tap-highlight-color: transparent;margin-right: 0px;margin-left: 0px;padding: 0px;outline: 0px;max-width: 100%;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;"><br/></span></span></strong></span></strong></p><p yb-mpa-mark="mark-main-text" style="font-size: 14px;color: rgb(0, 0, 0);line-height: 25px;word-break: break-word;margin-bottom: 0px;margin-top: 0px;" data-mid=""><span style="font-family: Optima-Regular, PingFangTC-light;" data-pm-slice="1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-template&quot;:&quot;t&quot;,&quot;mpa-data-temp-power-by&quot;:&quot;yiban.io&quot;,&quot;mpa-data-temp-type&quot;:&quot;image&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;,&quot;data-mpa-action-id&quot;:&quot;mbgaxk84ewm&quot;,&quot;data-pm-slice&quot;:&quot;5 1 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;&quot;,&quot;data-mid&quot;:&quot;&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;width: 100%;&quot;,&quot;data-mid&quot;:&quot;&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;width: 100%;background: #F6F8FF;padding: 20px 12px 12px 12px;&quot;,&quot;data-mid&quot;:&quot;&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;,&quot;data-mpa-action-id&quot;:&quot;mbgdp4b11wn2&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;yb-mpa-mark&quot;:&quot;mark-main-text&quot;,&quot;style&quot;:&quot;font-size: 14px;color: #000000;line-height: 25px;word-break: break-word;&quot;,&quot;data-mid&quot;:&quot;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]"><span style="color: #888888;font-weight: normal;font-family: Arial, Helvetica, sans-serif;" mpa-font-style="mm0fhbt510oy"><span leaf="">&nbsp; &nbsp; 编辑丨李娜&nbsp;</span><span leaf="">岑峰</span></span></span></p><p yb-mpa-mark="mark-main-text" style="font-size: 14px;color: rgb(0, 0, 0);line-height: 25px;word-break: break-word;text-align: right;margin: 0px 16px;" data-mid=""><strong style="-webkit-tap-highlight-color: transparent;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;font-family: Optima-Regular, PingFangTC-light;box-sizing: border-box !important;overflow-wrap: break-word !important;" mpa-from-tpl="t" data-mpa-action-id="mc1ad7ht254l"><strong style="-webkit-tap-highlight-color: transparent;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;" mpa-from-tpl="t"><span data-pm-slice="2 2 [&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 16px;padding: 0px;outline: 0px;max-width: 100%;clear: both;min-height: 1em;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);line-height: normal;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;node&quot;,{&quot;tagName&quot;:&quot;strong&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin-top: 0px;margin-bottom: 0px;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" style="-webkit-tap-highlight-color: transparent;padding: 0px;outline: 0px;max-width: 100%;letter-spacing: 0.5px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;"><span leaf="">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;</span></span></strong></strong></p></section></section></section></section><section data-mpa-action-id="muaud0qxjno" data-pm-slice="0 0 []"><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">两年前，阶跃星辰第一次在基模圈公开亮相时，凭借 Step 1 炸了场，同年接连发布 Step 1V 和万亿参数基座模型 Step 2，彼时行业仍相信，模型越大、能力越强。谁推进 Scaling Law，谁就更接近牌桌中心。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">但过去一年，它的曝光似乎更多集中在另一端：多模态模型、手机、汽车、端侧模型和 Agent。相比之下，那个需要和 Qwen、Kimi、GLM 正面比较的旗舰基模，似乎并不是讨论中心。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><strong><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">Step 5 Preview 改变了这个局面。</span></span></strong></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;c1d1c51d-7f27-4a54-9d92-ed0c1d7e0138&quot;,&quot;height&quot;:904,&quot;width&quot;:2464,&quot;currHeight&quot;:904,&quot;currWidth&quot;:2464,&quot;natrualHeight&quot;:904,&quot;natrualWidth&quot;:2464,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FKCRtbnFzaocjUnxcW64cBeuInsf%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;KCRtbnFzaocjUnxcW64cBeuInsf&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:260862,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20260930/6abcc03752eb6.png" class="rich_pages wxw-img" data-ratio="0.36666666666666664" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="2464" data-height="904" data-backw="546" data-backh="200" data-imgfileid="100262259" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20260930/6abcc03752eb6.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">在 Artificial Analysis Intelligence Index 上，它拿到 44 分，位列全球开源前二，进入顶尖旗舰模型比较的区间。这个成绩也证明了一个问题：</span><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">阶跃在押注终端和 Agent 的同时，</span></span></strong><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">前沿</span></span></strong><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">基座模型的能力上限</span></span></strong><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">并</span></span></strong><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">没有掉队</span></span></strong><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">。</span></span></strong></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">但对 Agent 来说，进入榜单只拿到了入场券。真正困难的是，模型离开 Benchmark 以后，能不能在几十甚至上百步操作里，把一件事情从头做到尾。为此，我们上手进行了实测。</span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muaueqh821yr"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mba8mvlk1t2b"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section nodeleaf="" style="width: 38px;height: 38px;display: flex;justify-content: center;align-items: center;margin-bottom: -38px;margin-left: -20px;" data-mid="" mpa-from-tpl="t"><img  data-src="https://static.leiphone.com/uploads/new/images/20260930/6abcc03789754.jpg" alt="图片" class="rich_pages wxw-img __bg_gif" data-ratio="1.0075757575757576" data-type="gif" data-w="132" style="display: block;height: auto !important;visibility: visible !important;width: 38px !important;background-color: transparent;" data-imgfileid="100241584" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20260930/6abcc03789754.jpg?imageMogr2/quality/90"/></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><p style="font-size: 36px;color: #333333;line-height: 50px;" data-mid=""><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><span leaf="">01</span><span leaf=""><br/></span></strong></p><h2 data-pm-slice="0 0 []"><span leaf=""><br/></span><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">实测：从制作 3D 游戏</span></strong></strong></strong></h2></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><h2 data-pm-slice="0 0 []"><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">看 Step 5 Preview 的能力</span><span leaf=""><br/></span></strong></strong></strong></h2></section></section></section></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">《超级马里奥》让一代人第一次相信：一套简单规则，也能组成一个完整世界。小时候按下跳跃键时，总会想到同一个问题：如果有一天，我也能做一款属于自己的游戏呢？</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;05b0845b-09cf-4b8c-94a1-cea844a4f286&quot;,&quot;height&quot;:500,&quot;width&quot;:889,&quot;currHeight&quot;:500,&quot;currWidth&quot;:889,&quot;natrualHeight&quot;:500,&quot;natrualWidth&quot;:889,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FDbNhbPBSLo7tdBxqq5LcvkPTnSd%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;DbNhbPBSLo7tdBxqq5LcvkPTnSd&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:279597,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20260930/6abcc037bbd15.png" class="rich_pages wxw-img" data-ratio="0.562429696287964" data-type="png" data-w="889" style="background-color:transparent;width:100%;" data-width="889" data-height="500" data-backw="546" data-backh="307" data-imgfileid="100262255" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20260930/6abcc037bbd15.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">那时候，这个念头通常止步于门槛，因为游戏不是一张图、几段剧情或一段代码，而是角色、场景、碰撞、交互、资源导出和工程构建共同成立的结果。往往需要一个庞大的团队或者多个跨国公司共同协作才能把一个类似想法推进成可运行的系统。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">今天，我们在这次测试里，选择把任务放进专业软件链路里：Claude Code CLI 作为 Agent 工作台，Blender 负责 3D 资产和关卡，Three.js/Vite 负责网页游戏呈现。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">测试题是让 Step 5 Preview 制作一个可运行的 3D 迷你游戏《星跃岛：能量快递》，具体题目如下：</span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muaug6j8ix8"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-data-temp-type="body" mpa-from-tpl="t" data-mpa-action-id="mmykzm77ala" data-pm-slice="0 0 []"><section style="width: 100%;padding: 0 10px;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;display: flex;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;align-self: flex-start;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;display: flex;align-items: flex-start;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;background: rgb(246, 248, 255);height: 6px;" data-mid="" mpa-from-tpl="t"><span leaf=""><br/></span></section></section><section style="width: 100%;background: rgb(246, 248, 255);text-align: center;padding: 7px 10px 11px 11px;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;text-align: left;" data-mid="" mpa-from-tpl="t"><p yb-mpa-mark="mark-style-text" style="font-size: 14px;color: rgb(34, 34, 34);line-height: 1.75em;word-break: break-word;margin-bottom: 24px;" data-mid="" mpa-is-content="t"><span leaf="" mpa-font-style="mmc3u4l8171f" style="font-family: Arial, Helvetica, sans-serif;font-size: 15px;" data-mpa-action-id="mmc3u4llds9" data-pm-slice="0 0 []" mpa-is-content="t"><span textstyle="" style="font-weight: bold">代码块</span></span><span leaf=""><br/></span></p><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">请使用 Claude Code CLI 调用本机 Blender，完成一个可运行的 3D 迷你网页游戏。</span></p><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">- 游戏名称为《星跃岛：能量快递》，主角是原创蘑菇头角色“菇噜”，不得使用马里奥、奇诺比奥、任天堂 Logo、贴图或音效。</span></p><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">- 请在 Blender 中创建角色、6 个浮空平台、5 个能量球和 1 个终点信标，导出 .blend 与 GLB 文件；</span></p><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">- 随后使用 Three.js / Vite 创建网页游戏，加载 GLB 资产，实现 WASD/方向键移动、空格跳跃、坠落重生、收集计数、计时、重开按钮和通关提示。</span></p><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">- 请同时生成测试脚本并运行 npm test、npm run build，将源码、构建产物、日志和验收报告保存到指定工作目录。</span></p></section></section></section></section></section></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">这里考的是模型能不能把一个创意变成可检查、可构建、可继续迭代的工程资产。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">我们没有替模型写代码或操作 Blender，而是把原本的大任务拆成四个阶段：先完成主角“菇噜”，再搭建浮空岛关卡，随后导出 GLB 资产，最后进入网页游戏工程。每个阶段内部的代码编写、Blender 操作、文件生成和调试仍由 Step 5 Preview 完成。</span></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;7df48afe-6109-4756-940d-cd4cbc15de00&quot;,&quot;height&quot;:309.375,&quot;width&quot;:550,&quot;currHeight&quot;:309.375,&quot;currWidth&quot;:550,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:0.5729166666666666,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FBPL2b2DwjoM1QyxYOu8cFDvWnxh%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;BPL2b2DwjoM1QyxYOu8cFDvWnxh&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:370787,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20260930/6abcc03801822.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color: transparent;width: 100%;" data-width="960" data-height="540" data-backw="546" data-backh="307" data-imgfileid="100262257" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20260930/6abcc03801822.png?imageMogr2/quality/90"/></section><section style="text-align: center;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="line-height: 1.75em;font-size: 14px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;" mpa-font-style="muaulbzv1lag" data-mpa-action-id="muaulc0317vg" data-pm-slice="0 0 []"><span textstyle="" style="color: #888888">游戏角色“菇噜”站在游戏起始浮空平台</span></span></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;8cd6770b-0ec9-4737-b066-9f4028230c9e&quot;,&quot;height&quot;:309.375,&quot;width&quot;:550,&quot;currHeight&quot;:309.375,&quot;currWidth&quot;:550,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:0.5729166666666666,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FVdG9b2II8opREexvWqSckp2ynl6%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;VdG9b2II8opREexvWqSckp2ynl6&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:363736,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20260930/6abcc0383e709.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color: transparent;" data-width="960" data-height="540" data-imgfileid="100262258" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20260930/6abcc0383e709.png?imageMogr2/quality/90"/></section><section style="text-align: center;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="line-height: 1.75em;font-size: 14px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888">游戏的终点浮空平台，有一个能量球和一个终点信标</span></span></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;787677ac-df3e-45b0-83c7-0aeeb0d9259d&quot;,&quot;height&quot;:310.5,&quot;width&quot;:552,&quot;currHeight&quot;:310.5,&quot;currWidth&quot;:552,&quot;natrualHeight&quot;:540,&quot;natrualWidth&quot;:960,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:0.575,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FEue8bPxVeoM2r0xRb3acmdO4nQe%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;Eue8bPxVeoM2r0xRb3acmdO4nQe&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:282259,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20260930/6abcc03886344.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="960" style="background-color: transparent;" data-width="960" data-height="540" data-imgfileid="100262264" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20260930/6abcc03886344.png?imageMogr2/quality/90"/></section><section style="text-align: center;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="line-height: 1.75em;font-size: 14px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888">完整游戏设计图：6 个浮空平台、游戏角色“菇噜”和终点信标</span></span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">拆分之后，任务开始稳定向前推进。Step 5 Preview 先完成角色与关卡资产，再把 Blender 生成的模型接入 Three.js/Vite 项目，继续处理移动、碰撞、能量球收集和终点判定。中间仍有修改和调试，但最终没有重新推倒工程，而是在已有结果上继续执行，直到项目可以运行。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">最终，《星跃岛：能量快递》能够正常运行：玩家可以控制“菇噜”在 6 个浮空平台之间移动，收集 5 个能量球并抵达终点信标。角色、场景、碰撞、基础交互和网页工程都已经接通，虽然部分视觉和操作细节仍然粗糙，但它已经不是一组静态资产，而是一个可以实际游玩的完整 Demo。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">一起来游戏中体验一下这款名为《星跃岛：能量快递》的 3D 网页游戏：</span></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" nodeleaf=""><iframe class="video_iframe rich_pages" data-src="https://mp.weixin.qq.com/mp/readtemplate?t=pages/video_player_tmpl&amp;action=mpvideo&amp;auto=0&amp;vid=wxv_4703973909107425284" data-mpvid="wxv_4703973909107425284" data-vidtype="2" data-cover="http%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_jpg%2FXqAicMdcoiafPU4JHaTDUM0wl5EFcaPVfibkJTUl0hU9JYaA2yuEUS5KNVxOcqkxroBkupTckNQH745rPCsC7Uwqz5dwu4ZhbfbvDFl66q06Cw%2F0%3Fwx_fmt%3Djpeg" data-ratio="1.5384615384615385" data-w="2560"></iframe></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">执行结果说明：</span><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">Step 5 Preview 能理解复杂目标，并</span></span></strong><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">通过调用 Blender 这类工程化工具</span></span></strong><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">把任务推进到最终构建。</span></span></strong></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">因此，这轮测试真正考验的不仅仅只是代码生成，而是在跨越 Blender、文件系统和网页工程的长任务里，模型能否保持目标、使用工具、根据中间结果继续执行，并最终完成交付。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">如果用一句话总结测试结果，那就是：</span><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">Step 5 Preview 已经具备从自然语言需求到游戏工程构建的完整执行能力，</span></span></strong><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">而且面对</span></span></strong><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">复杂项目</span></span></strong><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">可以以</span></span></strong><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">更清晰的阶段拆分</span></span></strong><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">来完成任务</span></span></strong><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">。</span></span></strong></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">根据阶跃官方披露的消息，Step 5 Preview 的 Coding 能力并不局限于传统代码任务。它可以做复杂软件工程（包括长程规划任务）、前端和视觉开发，也能进入可编程硬件场景；当任务持续数小时、需要不断根据结果调整时，模型也能继续推进。在内部和外部专家参与的评测中，约 70% 的评测者认为 Step 5 Preview 可以自主完成中高复杂度的 Coding 任务。 (雷峰网)</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">同时，Step 5 Preview 还在专业知识工作、金融分析等任务场景中展现出优越表现：在 Agents&#39; Last Exam 的 CLI 子集 ALE-CLI、金融投资研究评测 FrontierFinance，以及跨领域深度研究评测 DRACO 上仅次于 GPT-6 Astra 或 Claude Opus 5，领先其他参评开源模型。</span></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;19442cc1-9786-467e-ace4-bb5b83fc301f&quot;,&quot;height&quot;:329.5862068965517,&quot;width&quot;:708,&quot;currHeight&quot;:329.5862068965517,&quot;currWidth&quot;:708,&quot;natrualHeight&quot;:1134,&quot;natrualWidth&quot;:2436,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:0.29064039408866993,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FFIoEbacsxodr3hxBlIucPqCznec%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;FIoEbacsxodr3hxBlIucPqCznec&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:206860,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20260930/6abcc038c1de0.png" class="rich_pages wxw-img" data-ratio="0.46574074074074073" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="2436" data-height="1134" data-backw="546" data-backh="254" data-imgfileid="100262263" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20260930/6abcc038c1de0.png?imageMogr2/quality/90"/></section><section style="text-align: center;margin: 16px 16px 0px;line-height: 1.75em;"><span leaf="" style="line-height: 1.75em;font-size: 14px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888">Step 5 Preview 在 4 项金融评测的信息检索、</span></span></section><section style="text-align: center;margin: 0px 16px 24px;line-height: 1.75em;"><span leaf="" style="line-height: 1.75em;font-size: 14px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888">估值和完整金融研究流程上都取得了优秀的结果</span></span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">真正进入生产级 Agent 阶段以后，竞争已经不只是模型能不能完成某一步，而是它能不能跨文档、跨工具、跨轮次持续执行，同时把错误率、时间和成本控制在可接受的范围里。Step 5 Preview 的 1M 上下文和面向长程任务的设计，为这类工作提供了基础条件；同时它还能在多种真实业务场景中给出稳定的生产能力。</span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muaujuc99pa"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mba8mvlk1t2b"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section nodeleaf="" style="width: 38px;height: 38px;display: flex;justify-content: center;align-items: center;margin-bottom: -38px;margin-left: -20px;" data-mid="" mpa-from-tpl="t"><img  data-src="https://static.leiphone.com/uploads/new/images/20260930/6abcc03902ca0.jpg" alt="图片" class="rich_pages wxw-img __bg_gif" data-ratio="1.0075757575757576" data-type="gif" data-w="132" style="display: block;height: auto !important;visibility: visible !important;width: 38px !important;background-color: transparent;" data-imgfileid="100241584" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20260930/6abcc03902ca0.jpg?imageMogr2/quality/90"/></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><p style="font-size: 36px;color: #333333;line-height: 50px;" data-mid=""><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><span leaf="">02</span><span leaf=""><br/></span></strong></p><h2 data-pm-slice="0 0 []"><span leaf=""><br/></span><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">为什么 Step 5 Preview 值得被讨论？</span><span leaf=""><br/></span></strong></strong></strong></h2></section></section></section></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">根据 Artificial Analysis （AA 榜单）模型页截图，Step 5 Preview 的 Artificial Analysis Intelligence Index 为 44，输出速度为 99.8 tokens/s，单个 Intelligence Index task 成本为 0.71 美元；输入价格为 1.00 美元/百万 token，输出价格为 2.70 美元/百万 token，缓存折扣为 95%。页面还显示，Step 5 Preview 支持文本和图像输入、文本输出，上下文窗口为 1M token，参数规模为 600B。这说明阶跃此次带来的 Step 5 Preview 是一套“智能、速度、成本、上下文窗口”的组合。</span></section><section style="text-align: justify;margin: 16px 16px 0px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;c9d317b3-2db2-477d-9c73-d3fb7b924ebf&quot;,&quot;height&quot;:1064,&quot;width&quot;:2940,&quot;currHeight&quot;:1064,&quot;currWidth&quot;:2940,&quot;natrualHeight&quot;:1064,&quot;natrualWidth&quot;:2940,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FM95EbKXdQon4l5xo44ecPCf1nhh%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;M95EbKXdQon4l5xo44ecPCf1nhh&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:219085,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20260930/6abcc0392785a.png" class="rich_pages wxw-img" data-ratio="0.36203703703703705" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="2940" data-height="1064" data-backw="546" data-backh="198" data-imgfileid="100262260" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20260930/6abcc0392785a.png?imageMogr2/quality/90"/></section><section style="text-align: center;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="line-height: 1.75em;font-size: 14px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888">Step 5 Preview 在 AA 榜单上模型页截图</span></span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">从 AA 的 Intelligence Index 看，Step 5 Preview 已经进入前沿模型队列。该指数覆盖知识工作、Agent 工作流、终端使用、编程、长上下文、文档推理等多类任务，对一个面向 Agentic 任务的模型来说，这比单看某个问答榜单更接近真实使用场景。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">更关键的是任务成本，Agent 不是一次性回答问题，而是反复读上下文、调用工具、生成代码、运行测试、根据报错继续修改。只要任务变长，token 单价和缓存策略就会直接影响用户是否愿意让模型多试几轮。而这也是决定模型能否被开发者和企业用户选择，真正实现规模化商用的关键。从如下截图来看，Step 5 Preview 凭借 0.71 美元的单任务成本在 654 个模型中位于第 4 位（低成本前列），相当于Kimi K3 的35%。同时，这款模型也将模型能力、效率与成本最优平衡的帕累托前沿向外推进。对于长程 Agent 来说，这个位置意味着它不只是在“能力榜”上有竞争力，也在“多轮尝试是否划算”这个问题上给出了更有吸引力的答案。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;4f8e3233-1a18-4b83-a428-3cf3fbf26bee&quot;,&quot;height&quot;:936,&quot;width&quot;:2464,&quot;currHeight&quot;:936,&quot;currWidth&quot;:2464,&quot;natrualHeight&quot;:936,&quot;natrualWidth&quot;:2464,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FR654bbZ4QoexC6xW1iDcyo5nncf%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;R654bbZ4QoexC6xW1iDcyo5nncf&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:377904,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20260930/6abcc03969895.png" class="rich_pages wxw-img" data-ratio="0.37962962962962965" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="2464" data-height="936" data-backw="546" data-backh="207" data-imgfileid="100262261" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20260930/6abcc03969895.png?imageMogr2/quality/90"/></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;a6bcda42-fc29-4dc8-b0c2-40e79c018126&quot;,&quot;height&quot;:898,&quot;width&quot;:1576,&quot;currHeight&quot;:898,&quot;currWidth&quot;:1576,&quot;natrualHeight&quot;:898,&quot;natrualWidth&quot;:1576,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:1,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FQBLVbxvnRoRbDQxKZnIc8qf5nne%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;QBLVbxvnRoRbDQxKZnIc8qf5nne&quot;,&quot;image_type&quot;:&quot;image/png&quot;,&quot;size&quot;:316306,&quot;comments&quot;:[]}]}" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20260930/6abcc039aad4b.png" class="rich_pages wxw-img" data-ratio="0.5694444444444444" data-type="png" data-w="1080" style="background-color:transparent;width:100%;" data-width="1576" data-height="898" data-backw="546" data-backh="311" data-imgfileid="100262265" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20260930/6abcc039aad4b.png?imageMogr2/quality/90"/></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="muaum9zlgmh"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mba8mvlk1t2b"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section nodeleaf="" style="width: 38px;height: 38px;display: flex;justify-content: center;align-items: center;margin-bottom: -38px;margin-left: -20px;" data-mid="" mpa-from-tpl="t"><img  data-src="https://static.leiphone.com/uploads/new/images/20260930/6abcc039dc3bb.jpg" alt="图片" class="rich_pages wxw-img __bg_gif" data-ratio="1.0075757575757576" data-type="gif" data-w="132" style="display: block;height: auto !important;visibility: visible !important;width: 38px !important;background-color: transparent;" data-imgfileid="100241584" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20260930/6abcc039dc3bb.jpg?imageMogr2/quality/90"/></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><p style="font-size: 36px;color: #333333;line-height: 50px;" data-mid=""><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><span leaf="">03</span><span leaf=""><br/></span></strong></p><h2 data-pm-slice="0 0 []"><span leaf=""><br/></span></h2><h2 data-pm-slice="0 0 []"><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">手握三张牌，</span></strong></strong></strong></h2></section><section style="text-align: center;" data-mid="" mpa-from-tpl="t"><h2 data-pm-slice="0 0 []"><strong mpa-none-content="t" data-mid="" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;font-size: 18px;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Optima-Regular, PingFangTC-light;" mpa-from-tpl="t"><strong style="justify-content: flex-start;align-items: center;flex-direction: column;text-align: center;color: rgb(51, 51, 51);line-height: 25px;font-weight: bold;font-family: Arial, Helvetica, sans-serif;font-size: 18px;" mpa-from-tpl="t"><span leaf="">让阶跃进入国模牌桌中心</span><span leaf=""><br/></span></strong></strong></strong></h2></section></section></section></section></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">Step 5 Preview 进入 AA 榜单全球前沿梯队是重新衡量阶跃的标志性节点。阶跃正在把前沿基座模型、全模态模型矩阵和终端量产能力拧成一股绳，塑造自己的竞争壁垒。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">1.Step 5 Preview 让阶跃进入全球前沿模型竞争区间。尤其对 Agent 任务而言，长上下文和较低调用成本意味着模型可以处理更长链路、更大工程和更多文件，不必把复杂任务拆成太多碎片。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">2.过去一个季度，阶跃先后发布 Step Edge、StepAudio 3 系列，再到 Step 5 Preview，模型矩阵已经覆盖了从云端旗舰、Flash 高效模型、端侧模型，到语音、视觉、生成、GUI 等专项能力的完整全模态矩阵。根据官方信息，StepAudio 3 Realtime 在 Artificial Analysis Conversational Dynamics 榜单中以 98.9% 位列第一，Speech Reasoning 准确率为 99.7%；StepAudio 3 ASR 在非流式语音识别准确性榜单中词错误率为 1.7%，并列第一。听、说、看、生成和操作，不是分散能力，而是在被组织成一套完整模型体系。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">3.据官方公开数据，阶跃模型已进入手机、汽车等真实设备场景量产落地；截至 2025 年底，其手机侧模型装机量超过 4200 万台，日均服务近 2000 万人次，并覆盖国内超50% 头部手机品牌。和纯 API 模型公司相比，终端入口的价值在于高频、真实、复杂：低延迟、低算力、噪声环境、隐私约束和用户习惯，都会持续反向检验模型。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">从行业发展来看，</span><strong style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">基模公司的竞争，已经不再只是单一模型能力比拼，而是全栈技术能力与商业化落地的系统较量</span></span></strong><span leaf="" style="font-weight: bold;text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">。</span></span><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">DeepSeek 的优势在全球开发者影响力，阿里千问背靠云和生态，智谱深耕企业交付，Kimi 更有 C 端产品心智。而阶跃的独特位置则是“AI+终端”：前沿模型负责复杂推理，全模态模型负责感知和表达，端侧模型负责低延迟和高频入口。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">同时，阶跃选的这条路线也并不轻松。终端生态里有手机厂商、车企、操作系统和应用权限；Agent 真正落地，还要解决安全、隐私、跨应用执行和用户信任。通过 Step 5 Preview，说明阶跃已经重新进入第一梯队前沿模型的竞技场，结合已有的全模态模型矩阵和终端量产能力，直接将阶跃送上国产 AI 牌桌的中心。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">大模型市场的终局仍未确定，头部厂商之间的领先优势不会一成不变，模型能力、成本结构、终端入口和工作台体验都可能重新洗牌。Step 5 Preview 的意义在于让阶跃重新进入这场牌局；接下来真正要看的，是模型能不能在更多真实工作流里，把任务一次次交到终点。</span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 14px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;" mpa-font-style="muaudvs31llh" data-mpa-action-id="muaudvsbi22" data-pm-slice="0 0 []"><span textstyle="" style="color: #888888; font-style: italic">&nbsp;附在线体验链接：https://studio.stepfun.com/</span></span></section></section><section><span data-lark-record-format="docx/record"></span></section><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20260930/6abcc03a0a4e4.jpg" class="rich_pages wxw-img" data-ratio="0.40816326530612246" data-s="300,640" data-type="jpeg" data-w="735" data-croporisrc="https://mmbiz.qpic.cn/sz_mmbiz_jpg/XqAicMdcoiafMmnFSDYgj5YhRXtSaLUgkFfgfXB8OUWWYPiaDoxH8mK5zicDayMtrjMFic3IP9xClxEvsI2ZkLPt1F4RBmAPwxgaTzUjZQqxdg3Y/0?wx_fmt=jpeg&amp;from=appmsg" data-cropselx1="0" data-cropselx2="546" data-cropsely1="0" data-cropsely2="223" data-imgfileid="100254959" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20260930/6abcc03a0a4e4.jpg?imageMogr2/quality/90"/></section><section><span data-mpa-action-id="mipr37w01zjd"></span></section>]]></description>
<category>人工智能开发者</category>
<comments>https://www.leiphone.com/category/yanxishe/LjT1ojuhnJ3pBvu4.html#comments</comments>
<pubDate>Wed, 30 Sep 2026 15:55:00 +0800</pubDate>
</item>
<item>
<title>世界制造业大会丨国轩高科重磅发布低空飞行高功率电池等三大创新成果</title>
<link>https://www.leiphone.com/category/industrynews/DOdBNcP5frSITM4c.html</link>
<description><![CDATA[<p style="margin-top: 0px; margin-bottom: 0px; text-align: center;"><img  border="0" style=""  src="https://static.leiphone.com/uploads/new/images/20260930//6abcbee50f5a6.jpg?imageMogr2/quality/90"/></p><p style="text-align: left; margin-top: 5pt; margin-bottom: 5pt;"><span style="font-family: &#39;微软雅黑&#39;; font-size: 12pt; color: #000000;">9月21日，2026世界制造业大会国轩高科专场发布会在合肥举行。立足AI快速发展背景，国轩高科聚焦低空经济、跨境绿色物流、零碳数字能源三大前沿赛道，重磅发布低空飞行高功率星晨电池、中欧非新能源物流运输一体化解决方案、国轩零碳数字云平台三大创新应用成果；同期，国轩高科展区以覆盖海陆空的全场景解决方案亮相新一代信息技术和新能源展区，充分展现公司AI能源底座的技术实力和产业化水平。</span></p><p>&nbsp;</p><p style="text-align: left; margin-top: 5pt; margin-bottom: 5pt;"><span style="font-family: &#39;微软雅黑&#39;; font-size: 14pt; color: #000000; font-weight: bold;">高比能、高功率、高安全、快速补能</span></p><p style="text-align: left; margin-top: 5pt; margin-bottom: 5pt;"><span style="font-family: &#39;微软雅黑&#39;; font-size: 14pt; color: #000000; font-weight: bold;">国轩高科发布“三高一快” 星晨低空飞行电池</span></p><p style="text-align: left; margin-top: 5pt; margin-bottom: 5pt;"><span style="font-family: &#39;微软雅黑&#39;; font-size: 12pt; color: #000000;">随着低空经济产业加速崛起，飞行器对动力电池提出多重严苛挑战，传统电池方案难以兼顾多项指标平衡。本次大会发布的低空飞行高功率星晨电池，面向低空场景定制开发，依托46系大圆柱定向泄压、全极耳结构设计，叠加混合固液体系，筑牢电芯本征安全与高功率基础。研发团队借助AI-机理双轮驱动仿真技术，在万千方案中优中选优，不仅大幅提升研发效率，还通过工况模拟让产品适配复杂多变的低空飞行工况。通过迅导正极、迅径负极、迅凝电解质的“三迅”材料技术，以及从电芯到PACK系统层面的全链路自研创新，星晨电池已具备高比能、高功率、高安全、快速补能的“三高一快”核心优势。</span></p><p style="margin-top: 0px; margin-bottom: 0px; text-align: left;"><img  border="0" style=""  src="https://static.leiphone.com/uploads/new/images/20260930//6abcbee50fb26.jpg?imageMogr2/quality/90"/><br/><span style="font-family: &#39;微软雅黑&#39;; font-size: 12pt; color: #000000;">星晨低空飞行高功率圆柱电池单体能量密度突破330Wh/kg、850Wh/L；在SOC低于25%的情况下，仍支持6C持续放电、12C脉冲放电；达到航空级最严标准的PACK零热蔓延；支持快充、换电双模式，5分钟以内即可快速补能。星晨电池以系统性技术突破，回应低空飞行器对动力电池的多重严苛需求，为行业提供高性能飞行解决方案。</span></p><p>&nbsp;</p><p style="text-align: left; margin-top: 5pt; margin-bottom: 5pt;"><span style="font-family: &#39;微软雅黑&#39;; font-size: 14pt; color: #000000; font-weight: bold;">欧非2600公里+中越2300公里</span></p><p style="text-align: left; margin-top: 5pt; margin-bottom: 5pt;"><span style="font-family: &#39;微软雅黑&#39;; font-size: 14pt; color: #000000; font-weight: bold;">国轩高科重塑中欧非跨境绿色补能一体化方案</span></p><p style="text-align: left; margin-top: 5pt; margin-bottom: 5pt;"><span style="font-family: &#39;微软雅黑&#39;; font-size: 12pt; color: #000000;">面对全球跨境货运电动化转型浪潮，补能基建建设周期长、部署成本高、跨境标准不统一等现实难题长期制约行业发展。国轩高科正式推出中欧非新能源物流运输一体化解决方案。</span></p><p style="text-align: left; margin-top: 5pt; margin-bottom: 5pt;"><span style="font-family: &#39;微软雅黑&#39;; font-size: 12pt; color: #000000;">方案以电啦啦移动储充换一体化系统为载体，系统接入智能云平台，借助AI负荷预测、智能调度算法，统筹电池资产与运力资源，真正实现“电随车走”。系统实现全系列换电电池互通互换，兼容国内外主流行业标准；创新四包联动侧换电系统，支持电量自由组合，灵活匹配不同类型重卡换电车辆需求。</span><br/><span style="font-family: &#39;微软雅黑&#39;; font-size: 12pt; color: #000000;">面向全球化布局，2026年国轩高科将联合GPM等生态合作伙伴，共建欧非2600公里和中越2300公里绿色物流新干线，以硬件产品搭配数字调度能力，赋能跨境绿色货运，助力全球交通能源深度转型。</span></p><p>&nbsp;</p><p><span style="font-size: 18px;"><strong>规划+运营+电交易+碳管理</strong></span></p><p><span style="font-size: 18px;"><strong>国轩零碳数字能源云平台“场景覆盖最广、功能体系最完备”</strong></span></p><p>如果说先进电池是绿色能源的 &quot;硬件基石&quot;，那么 AI 驱动的数字平台，就是让能源高效流转的 &quot;智慧大脑&quot;。本次发布的 GotionGuard-ZERO 国轩零碳数字能源云平台，正是 AI 与能源产业深度融合的结晶 —— 一个集智慧规划、资源聚合、智能调度、市场交易等核心功能于一体的数字能源操作系统。</p><p>作为当前市面场景覆盖最广、功能体系最完备的数字能源平台之一，GotionGuard-ZERO搭建云 - 边 - 端协同分层架构，集成运行监控、智能预测、智慧运维、虚拟电厂、交易结算等核心能力；同时打通气象、电网调度及第三方交易平台接口，全面支撑综合能源各类业务场景落地。</p><p style="text-align: left; margin-top: 5pt; margin-bottom: 5pt;"><img  border="0"  src="https://static.leiphone.com/uploads/new/images/20260930//6abcbee512b29.jpg?imageMogr2/quality/90"/><br/></p><p>该平台主打八大核心应用，AI&nbsp;能源规划智能体自动完成风光储充配比寻优，同步输出收益测算；风光智慧管理系统对风光系统设备实现集中监控，依托功率预测提前预警故障；智慧储能管理系统以百万级测点实时监测电池状态；智慧工厂能源管理系统实时掌握能耗动态，结合分时电价调节用电节奏；充换电智能运营平台统筹重卡补能网络，提供智能选址与负荷调度服务；虚拟电厂及电力交易辅助决策平台聚合平台聚合发、储、用各类可调资源，支撑电力市场交易，&nbsp;可预测电价与负荷走势，实现交易全流程闭环管控；碳资产管理平台让碳流数据可视化、核算自动化，支撑企业低碳合规。</p><p>八大应用环环相扣、协同发力，以&nbsp;AI&nbsp;赋能新型电力系统建设，助力产业绿色低碳转型。</p>]]></description>
<category>业界</category>
<comments>https://www.leiphone.com/category/industrynews/DOdBNcP5frSITM4c.html#comments</comments>
<pubDate>Wed, 30 Sep 2026 15:53:00 +0800</pubDate>
</item>
<item>
<title>越大越强，不再是 LLM 的专利：PixVerse R2 攻克实时世界模型 Scaling 难题</title>
