z"></span><span data-lark-record-data="{&quot;rootId&quot;:&quot;FdZeduLh9ohPKcxr1VDcCN8nnRh&quot;,&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;具身智能，攻入油烟弥漫的后厨&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+e&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7629541120642091970&quot;]},&quot;nextNum&quot;:1}},&quot;type&quot;:&quot;text&quot;,&quot;referenceRecordMap&quot;:{},&quot;extra&quot;:{&quot;channel&quot;:&quot;saas&quot;,&quot;isEqualBlockSelection&quot;:false,&quot;pasteRandomId&quot;:&quot;cfb07fd4-9966-4c79-8ea8-e8bc041d3659&quot;,&quot;mention_page_title&quot;:{},&quot;external_mention_url&quot;:{}},&quot;isKeepQuoteContainer&quot;:false,&quot;isFromCode&quot;:false,&quot;selection&quot;:[{&quot;id&quot;:7,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:3,&quot;end&quot;:17},&quot;recordId&quot;:&quot;BnkadAUsgo3AbGx4g5hcavcRn7g&quot;}],&quot;payloadMap&quot;:{},&quot;isCut&quot;:false}" data-lark-record-format="docx/text"></span><span data-lark-record-data="{&quot;rootId&quot;:&quot;M0lkd1gU4oXvBbxr0hUcNKhwn6c&quot;,&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;百万流量下的机器人打工记&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+c&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7629541120642091970&quot;]},&quot;nextNum&quot;:1}},&quot;type&quot;:&quot;text&quot;,&quot;referenceRecordMap&quot;:{},&quot;extra&quot;:{&quot;channel&quot;:&quot;saas&quot;,&quot;isEqualBlockSelection&quot;:false,&quot;pasteRandomId&quot;:&quot;80c4c2a6-c274-411e-9a10-ddcaa7bcf44b&quot;,&quot;mention_page_title&quot;:{},&quot;external_mention_url&quot;:{}},&quot;isKeepQuoteContainer&quot;:false,&quot;isFromCode&quot;:false,&quot;selection&quot;:[{&quot;id&quot;:4,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:6,&quot;end&quot;:18},&quot;recordId&q