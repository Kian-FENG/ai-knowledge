&lt;li&gt;&lt;strong&gt;xAI:&lt;/strong&gt; &lt;a href=&quot;https://github.com/sherlockwu&quot;&gt;@sherlockwu&lt;/a&gt;.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Independent:&lt;/strong&gt; &lt;a href=&quot;https://github.com/AmeenP&quot;&gt;@AmeenP&lt;/a&gt;, &lt;a href=&quot;https://github.com/awesome-pro&quot;&gt;@awesome-pro&lt;/a&gt;, &lt;a href=&quot;https://github.com/bojiang-li&quot;&gt;@bojiang-li&lt;/a&gt;, &lt;a href=&quot;https://github.com/Champollion9012&quot;&gt;@Champollion9012&lt;/a&gt;, &lt;a href=&quot;https://github.com/charan-rathore&quot;&gt;@charan-rathore&lt;/a&gt;, &lt;a href=&quot;https://github.com/cmdy&quot;&gt;@cmdy&lt;/a&gt;, &lt;a href=&quot;https://github.com/Efeselimsurekli&quot;&gt;@Efeselimsurekli&lt;/a&gt;, &lt;a href=&quot;https://github.com/elizabetht&quot;&gt;@elizabetht&lt;/a&gt;, &lt;a href=&quot;https://github.com/host452b&quot;&gt;@host452b&lt;/a&gt;, &lt;a href=&quot;https://github.com/jorgeantonio21&quot;&gt;@jorgeantonio21&lt;/a&gt;, &lt;a href=&quot;https://github.com/junuxyz&quot;&gt;@junuxyz&lt;/a&gt;, &lt;a href=&quot;https://github.com/neilkg&quot;&gt;@neilkg&lt;/a&gt;, &lt;a href=&quot;https://github.com/Prudctual&quot;&gt;@Prudctual&lt;/a&gt;, &lt;a href=&quot;https://github.com/Sumit884-byte&quot;&gt;@Sumit884-byte&lt;/a&gt;.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;strong&gt;New Contributors:&lt;/strong&gt; welcome to the 45 first-time contributors in this release:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;a href=&quot;https://github.com/Victor49152&quot;&gt;@Victor49152&lt;/a&gt; matched the Qwen vision utilities to the DeepStack vision embedding size (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;4820982524&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/ai-dynamo/dynamo/issues/11244&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/ai-dynamo/dynamo/pull/11244/hovercard&quot; href=&quot;https://github.com/ai-dynamo/dynamo/pull/11244&quot;&gt;#11244&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;&lt;a href=&quot;https://github.com/Stelath&quot;&gt;@Stelath&lt;/a&gt; preserved raw reasoning output in the Responses API (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;4875763280&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/ai-dynamo/dynamo/issues/11604&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/ai-dynamo/dynamo/pull/11604/hovercard&quot; href=&quot;https://github.com/ai-dynamo/dynamo/pull/11604&quot;&gt;#11604&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;&lt;a href=&quot;https://github.com/RealNicolasBourbaki&quot;&gt;@RealNicolasBourbaki&lt;/a&gt; propagated the worker ID into snapshot-restored vLLM engine cores (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5044637630&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/ai-dynamo/dynamo/issues/12545&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/ai-dynamo/dynamo/pull/12545/hovercard&quot; href=&quot;https://github.com/ai-dynamo/dynamo/pull/12545&quot;&gt;#12545&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;&lt;a href=&quot;https://github.com/gitover22&quot;&gt;@gitover22&lt;/a&gt; published KV cache gauges from vLLM prefill workers (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5047826297&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/ai-dynamo/dynamo/issues/12559&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/ai-dynamo/dynamo/pull/12559/hovercard&quot; href=&quot;https://github.com/ai-dynamo/dynamo/pull/12559&quot;&gt;#12559&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;&lt;a href=&quot;https://github.com/aswinvisva&quot;&gt;@aswinvisva&lt;/a&gt; forwarded &lt;code&gt;mm_processor_kwargs&lt;/code&gt; to the TensorRT-LLM engine and enabled NVDEC decoding of &lt;code&gt;data:&lt;/code&gt; URI videos (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5260496516&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/ai-dynamo/dynamo/issues/13856&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/ai-dynamo/dynamo/pull/13856/hovercard&quot; href=&quot;https://github.com/ai-dynamo/dynamo/pull/13856&quot;&gt;#13856&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5556587040&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/ai-dynamo/dynamo/issues/15219&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/ai-dynamo/dynamo/pull/15219/hovercard&quot; href=&quot;https://github.com/ai-dynamo/dynamo/pull/15219&quot;&gt;#15219&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;&lt;a href=&quot;https://github.com/ShaneGZhu&quot;&gt;@ShaneGZhu&lt;/a&gt; made the ThunderAgent cost model aware of data-parallel ranks (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5283760437&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/ai-dynamo/dynamo/issues/14000&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/ai-dynamo/dynamo/pull/14000/hovercard&quot; href=&quot;https://github.com/ai-dynamo/dynamo/pull/14000&quot;&gt;#14000&lt;/a&gt;).&lt;/li&gt;
