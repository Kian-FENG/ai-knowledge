<description><![CDATA[<section style="text-align: center;margin: 0px 16px;line-height: 1.75em;display: block;" data-mpa-action-id="mmiwq6ij1i3r" data-pm-slice="0 0 []" nodeleaf=""><img  class="rich_pages wxw-img" data-aistatus="1" data-croporisrc="https://mmbiz.qpic.cn/mmbiz_jpg/XqAicMdcoiafMBrxoBoibibmia2vbPJbDLIxpGB6tmia9icVq7UAK7uG5IbCnLY6Njg6vzu4JaINicGNWbMluNP2YlicZibGJUktJPsdLe1EVaG9y42rA/0?wx_fmt=jpeg&amp;from=appmsg" data-cropselx1="0" data-cropselx2="546" data-cropsely1="0" data-cropsely2="307" data-imgfileid="100263477" data-ratio="0.55" data-s="300,640" data-src="https://static.leiphone.com/uploads/new/images/20261016/6ad167b0e7a89.jpg" data-type="jpeg" data-w="1000" style="width:100%;display:inline-block;text-align:center;background-color:transparent;"  src="https://static.leiphone.com/uploads/new/images/20261016/6ad167b0e7a89.jpg?imageMogr2/quality/90"/></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-data-temp-type="image" mpa-from-tpl="t" data-mpa-action-id="mmix4tgk1t7p" data-pm-slice="5 10 []" style="padding-left: 16px;padding-right: 16px;"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;padding-left: 0px;padding-right: 0px;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;background: rgb(246, 248, 255);padding: 20px 0px 12px;margin-top: 0px;margin-bottom: 0px;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mm0fhbur236d" data-pm-slice="0 0 []"><section style="text-align: center;"><section><section style="text-align: justify;margin: 0px 16px;"><span style="font-family: Arial, Helvetica, sans-serif;font-size: 15px;font-weight: bold;letter-spacing: 0.5px;"><span data-mpa-action-id="mmix6wyl1l05" data-pm-slice="0 0 []"><span leaf=""><span textstyle="" style="font-weight: bold;">一张五年前的研发清单，兑现如今 AI 行业大半成果。</span></span></span></span></section><span data-mpa-action-id="mqgbkegzw9n"></span><span data-mpa-act