&lt;li&gt;&lt;strong&gt;CPU&lt;/strong&gt;: vectorized sampler (up to 58x on s390x, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5258718384&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/53913&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/53913/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/53913&quot;&gt;#53913&lt;/a&gt;), aarch64 causal conv1d (about 9%, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5271246850&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/54093&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/54093/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/54093&quot;&gt;#54093&lt;/a&gt;), POWER10 AWQ/GPTQ (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5626163504&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59149&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59149/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59149&quot;&gt;#59149&lt;/a&gt;), and PowerPC &lt;code&gt;dtype=auto&lt;/code&gt; choosing bfloat16 (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5566200869&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/58528&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/58528/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/58528&quot;&gt;#58528&lt;/a&gt;).&lt;/li&gt;
