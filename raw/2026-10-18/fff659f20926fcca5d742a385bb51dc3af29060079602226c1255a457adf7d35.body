&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;New endpoints and options&lt;/strong&gt;: &lt;code&gt;/v1/systemone&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5636788960&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59299&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59299/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59299&quot;&gt;#59299&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5765828460&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60677&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60677/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60677&quot;&gt;#60677&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5767685666&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60696&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60696/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60696&quot;&gt;#60696&lt;/a&gt;), &lt;code&gt;hf&lt;/code&gt; parser (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5573097826&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/58604&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/58604/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/58604&quot;&gt;#58604&lt;/a&gt;), &lt;code&gt;vllm download-kernels&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5586831846&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/58765&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/58765/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/58765&quot;&gt;#58765&lt;/a&gt;), &lt;code&gt;output_mode: &quot;text&quot;&lt;/code&gt; and &lt;code&gt;stop_reason&lt;/code&gt; in &lt;code&gt;/inference/v1/generate&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5571462167&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/58588&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/58588/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/58588&quot;&gt;#58588&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5730661435&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60251&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60251/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60251&quot;&gt;#60251&lt;/a&gt;), &lt;code&gt;mm_payload&lt;/code&gt; for render requests (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5832020304&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/61427&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/61427/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/61427&quot;&gt;#61427&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5769729321&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60728&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60728/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60728&quot;&gt;#60728&lt;/a&gt;), Responses &lt;code&gt;min_p&lt;/code&gt; and &lt;code&gt;stop_token_ids&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;4843554363&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/48084&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/48084/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/48084&quot;&gt;#48084&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5432644016&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56592&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56592/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56592&quot;&gt;#56592&lt;/a&gt;), &lt;code&gt;LLM.chat(priority=...)&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5480186418&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/57243&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/57243/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/57243&quot;&gt;#57243&lt;/a&gt;), and &lt;code&gt;/generative_scoring&lt;/code&gt; &lt;code&gt;cache_salt&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5778085137&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60841&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60841/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60841&quot;&gt;#60841&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Behavior&lt;/strong&gt;: &lt;code&gt;max_tokens&lt;/code&gt; is an upper bound instead of a reservation, so long prompts are no longer rejected (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5464273173&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/57035&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/57035/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/57035&quot;&gt;#57035&lt;/a&gt;); least-loaded API worker selection (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5769513146&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60723&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60723/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60723&quot;&gt;#60723&lt;/a&gt;); tool parser compatibility checked at startup (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5674171684&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59749&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59749/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59749&quot;&gt;#59749&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Tool calling and structured output&lt;/strong&gt;: &lt;code&gt;parallel_tool_calls=false&lt;/code&gt; enforced (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5025631813&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/50502&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/50502/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/50502&quot;&gt;#50502&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5636520933&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59298&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59298/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59298&quot;&gt;#59298&lt;/a&gt;), &lt;code&gt;tool_choice=&quot;required&quot;&lt;/code&gt; streaming (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5740164246&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60354&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60354/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60354&quot;&gt;#60354&lt;/a&gt;) and native XML parsers (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;4800346915&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/47512&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/47512/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/47512&quot;&gt;#47512&lt;/a&gt;), Step-3.5 and &lt;code&gt;minimax_m3&lt;/code&gt; on the parser engine (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5638821961&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59321&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59321/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59321&quot;&gt;#59321&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5674079381&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59743&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59743/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59743&quot;&gt;#59743&lt;/a&gt;), xgrammar &lt;code&gt;propertyNames&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5501978187&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/57594&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/57594/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/57594&quot;&gt;#57594&lt;/a&gt;), and LoRA PEFT &lt;code&gt;rank_pattern&lt;/code&gt;/&lt;code&gt;alpha_pattern&lt;/code&gt; applied with unsupported features rejected (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5680391966&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59801&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59801/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59801&quot;&gt;#59801&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5728137597&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60225&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60225/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60225&quot;&gt;#60225&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Rust frontend&lt;/strong&gt;: &lt;code&gt;--grpc-port&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5666606000&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59659&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59659/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59659&quot;&gt;#59659&lt;/a&gt;), &lt;code&gt;--stream-interval&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5759168004&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60589&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60589/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60589&quot;&gt;#60589&lt;/a&gt;), &lt;code&gt;logprob_token_ids&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5657333554&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59549&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59549/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59549&quot;&gt;#59549&lt;/a&gt;), &lt;code&gt;Control.Shutdown&lt;/code&gt; with &lt;code&gt;vllm-proto&lt;/code&gt; 0.5.0 (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5638475916&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59316&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59316/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59316&quot;&gt;#59316&lt;/a&gt;), &lt;code&gt;qwen3_json&lt;/code&gt; parser (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5719792428&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60136&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60136/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60136&quot;&gt;#60136&lt;/a&gt;), and Kimi K3 grammar fixes (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5628404755&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59190&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59190/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59190&quot;&gt;#59190&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5643341976&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59395&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59395/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59395&quot;&gt;#59395&lt;/a&gt;).&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;Security&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;a title=&quot;GHSA-4hhp-h66f-j5j7&quot; data-hovercard-type=&quot;advisory&quot; data-hovercard-url=&quot;/advisories/GHSA-4hhp-h66f-j5j7/hovercard&quot; href=&quot;https://github.com/advisories/GHSA-4hhp-h66f-j5j7&quot;&gt;GHSA-4hhp-h66f-j5j7&lt;/a&gt;: chat templates are validated statically and rendered under a timeout (&lt;code&gt;VLLM_CHAT_TEMPLATE_RENDER_TIMEOUT&lt;/code&gt;), user-supplied &lt;code&gt;chat_template&lt;/code&gt; in Responses &lt;code&gt;chat_template_kwargs&lt;/code&gt; is rejected, and the Rust frontend caps template execution (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5011829213&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/50300&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/50300/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/50300&quot;&gt;#50300&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;GHSA-q97c-p368-75c4: tokenizer &lt;code&gt;max_token_id&lt;/code&gt; off-by-one fixed (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5652533162&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59491&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59491/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59491&quot;&gt;#59491&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;GHSA-frvg-qw88-hww9: P2P ZMQ peer sessions are bounded by &lt;code&gt;VLLM_P2P_MAX_PEERS&lt;/code&gt; (default 128), &lt;code&gt;VLLM_P2P_HANDSHAKE_TIMEOUT_S&lt;/code&gt; (default 30) and &lt;code&gt;VLLM_P2P_IDLE_TIMEOUT_S&lt;/code&gt; (default 300), so unique peer addresses can no longer exhaust ZMQ sockets (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5098151186&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/51504&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/51504/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/51504&quot;&gt;#51504&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;Default CORS settings no longer allow every origin in the Python and Rust frontends; set &lt;code&gt;--allowed-origins&lt;/code&gt; to permit browser origins (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5793054798&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/61009&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/61009/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/61009&quot;&gt;#61009&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;Untrusted images are opened with a raster-format allowlist (&lt;code&gt;ALLOWED_IMAGE_FORMATS&lt;/code&gt;), denying EPS/PostScript and WMF (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5708038313&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60022&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60022/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60022&quot;&gt;#60022&lt;/a&gt;); shared-memory multimodal cache handles are HMAC-signed and forged handles rejected (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5640410316&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59357&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59357/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59357&quot;&gt;#59357&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;Structured-output JSON schemas nested more than 64 levels return 400 (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5709435782&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60036&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60036/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60036&quot;&gt;#60036&lt;/a&gt;); chunked &lt;code&gt;/v1/embeddings&lt;/code&gt; requests keep &lt;code&gt;cache_salt&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;4816505854&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/47696&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/47696/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/47696&quot;&gt;#47696&lt;/a&gt;); Phi-4 MM audio no longer holds multi-GiB attention matrices (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5760364239&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60614&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60614/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60614&quot;&gt;#60614&lt;/a&gt;); DeepSeek-OCR zero-sum pixel tensors no longer kill EngineCore (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5646068615&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59417&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59417/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59417&quot;&gt;#59417&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;Security dependency bumps: &lt;code&gt;aiohttp&amp;gt;=3.14.3&lt;/code&gt;, &lt;code&gt;pillow&amp;gt;=12.3.0&lt;/code&gt;, cryptography, urllib3, pyjwt and others (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5633245714&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59249&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59249/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59249&quot;&gt;#59249&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5638368988&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59315&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59315/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59315&quot;&gt;#59315&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5646796231&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59427&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59427/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59427&quot;&gt;#59427&lt;/a&gt;).&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;Dependencies&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;code&gt;transformers&amp;gt;=5.16.1&lt;/code&gt; (from 5.10.4, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5488278841&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/57387&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/57387/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/57387&quot;&gt;#57387&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5675698311&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59762&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59762/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59762&quot;&gt;#59762&lt;/a&gt;) and &lt;code&gt;tokenizers&amp;gt;=0.23.2&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5679973595&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59796&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59796/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59796&quot;&gt;#59796&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;NIXL 1.5.0 (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5455343440&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56907&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56907/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56907&quot;&gt;#56907&lt;/a&gt;), CuTe DSL 4.8.0 block-scale APIs (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5651317105&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59480&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59480/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59480&quot;&gt;#59480&lt;/a&gt;), &lt;code&gt;humming-kernels==0.1.17&lt;/code&gt; with initial Rubin support (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5841363943&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/61556&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/61556/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/61556&quot;&gt;#61556&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5869310334&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/61858&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/61858/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/61858&quot;&gt;#61858&lt;/a&gt;), InstantTensor 0.2.2 (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5809507866&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/61167&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/61167/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/61167&quot;&gt;#61167&lt;/a&gt;), and &lt;code&gt;flashinfer-jit-cache&lt;/code&gt; excluded from wheel &lt;code&gt;install_requires&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5711579628&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60052&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60052/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60052&quot;&gt;#60052&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;ROCm: AITER 0.1.24.post1 (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5679780827&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59794&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59794/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59794&quot;&gt;#59794&lt;/a&gt;) and MoRI v1.2.3.post1 (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5399070746&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56073&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56073/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56073&quot;&gt;#56073&lt;/a&gt;). XPU: auto-round-lib 0.16.0 (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5789501347&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60976&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60976/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60976&quot;&gt;#60976&lt;/a&gt;). TPU: tpu-inference v0.31.0 (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5724738148&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60190&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60190/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60190&quot;&gt;#60190&lt;/a&gt;).&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;Build&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;Python 3.11-3.14 supported (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5746030133&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60402&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60402/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60402&quot;&gt;#60402&lt;/a&gt;); macOS wheels built with the stable ABI (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5736340879&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60312&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60312/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60312&quot;&gt;#60312&lt;/a&gt;); CUDA source builds require GCC 13 and fail early otherwise (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5732418213&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60259&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60259/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60259&quot;&gt;#60259&lt;/a&gt;); Docker images compile Python bytecode at build time for faster container startup (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5354973549&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/55422&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/55422/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/55422&quot;&gt;#55422&lt;/a&gt;); &lt;code&gt;VLLM_USE_PRECOMPILED&lt;/code&gt; finds a compatible published wheel within the last 20 commits (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5599203579&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/58871&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/58871/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/58871&quot;&gt;#58871&lt;/a&gt;); the vendored DeepGEMM uses &lt;code&gt;TORCH_LIBRARY&lt;/code&gt; (abi3, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;4913014004&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/48962&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/48962/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/48962&quot;&gt;#48962&lt;/a&gt;).&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;Breaking Changes &amp;amp; Deprecations&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;Python 3.10 is no longer supported; the minimum is Python 3.11 (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5746030133&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60402&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60402/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60402&quot;&gt;#60402&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;Default CORS origins changed from &lt;code&gt;*&lt;/code&gt; to none; set &lt;code&gt;--allowed-origins&lt;/code&gt; for browser clients (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5793054798&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/61009&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/61009/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/61009&quot;&gt;#61009&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;&lt;code&gt;transformers&amp;gt;=5.16.1&lt;/code&gt; and &lt;code&gt;tokenizers&amp;gt;=0.23.2&lt;/code&gt; are required (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5488278841&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/57387&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/57387/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/57387&quot;&gt;#57387&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5679973595&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59796&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59796/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59796&quot;&gt;#59796&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;The torch.compile sequence parallelism and AsyncTP passes were removed, along with &lt;code&gt;PassConfig.enable_sp&lt;/code&gt;, &lt;code&gt;fuse_gemm_comms&lt;/code&gt; and &lt;code&gt;sp_min_token_num&lt;/code&gt;; model-level sequence parallelism is unaffected (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5754581997&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60517&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60517/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60517&quot;&gt;#60517&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;Cascade attention was removed; &lt;code&gt;--disable-cascade-attn&lt;/code&gt; still parses but only warns and will be removed in v0.33.0 (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5806861935&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/61126&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/61126/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/61126&quot;&gt;#61126&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;&lt;code&gt;mamba_cache_mode=&quot;all&quot;&lt;/code&gt; was removed; &lt;code&gt;--mamba-cache-mode all&lt;/code&gt; now fails validation (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5611877875&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/58997&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/58997/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/58997&quot;&gt;#58997&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;Previously deprecated APIs were removed: &lt;code&gt;wait_for_inflight_requests&lt;/code&gt; (use &lt;code&gt;mode=&quot;wait&quot;&lt;/code&gt;), &lt;code&gt;AsyncLLM.pause_generation()&lt;/code&gt;, &lt;code&gt;IOProcessor.output_to_response&lt;/code&gt;, &lt;code&gt;vllm.scripts.main()&lt;/code&gt; and &lt;code&gt;vllm bench throughput --dataset&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5784887088&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60923&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60923/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60923&quot;&gt;#60923&lt;/a&gt;). The &lt;code&gt;sonnet&lt;/code&gt; benchmark dataset was removed as scheduled (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5719223351&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60129&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60129/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60129&quot;&gt;#60129&lt;/a&gt;). Tensorizer support was removed from LoRA (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5708235713&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60024&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60024/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60024&quot;&gt;#60024&lt;/a&gt;), and the PyO3 &lt;code&gt;vllm._rust_tool_parser&lt;/code&gt; bridge was removed (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5674079876&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59744&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59744/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59744&quot;&gt;#59744&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;API changes: &lt;code&gt;max_tokens&lt;/code&gt; is treated as an upper bound on output rather than reserved from the context window (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5464273173&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/57035&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/57035/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/57035&quot;&gt;#57035&lt;/a&gt;); Responses API streaming uses &lt;code&gt;response.content_part.added/done&lt;/code&gt; with &lt;code&gt;part.type=&quot;reasoning_text&quot;&lt;/code&gt; instead of &lt;code&gt;response.reasoning_part.added/done&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5666244889&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59652&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59652/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59652&quot;&gt;#59652&lt;/a&gt;); &lt;code&gt;SamplingParams.prompt_logprob_token_ids&lt;/code&gt; is per row (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5459999418&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56984&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56984/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56984&quot;&gt;#56984&lt;/a&gt;); &lt;code&gt;/inference/v1/generate&lt;/code&gt; logprobs use integer token IDs (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5542266388&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/58181&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/58181/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/58181&quot;&gt;#58181&lt;/a&gt;); sleep API responses are standardized and invalid levels return 400 (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5188728427&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/52864&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/52864/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/52864&quot;&gt;#52864&lt;/a&gt;); &lt;code&gt;return_mm_kwargs&lt;/code&gt; is deprecated in favor of &lt;code&gt;mm_payload&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5832020304&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/61427&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/61427/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/61427&quot;&gt;#61427&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;Watermarking: when the engine has watermarking configured, an omitted request field means enabled and only &lt;code&gt;false&lt;/code&gt; opts out; unsupported combinations warn and fall back (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5447880177&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56801&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56801/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56801&quot;&gt;#56801&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;Rust frontend: &lt;code&gt;qwen3_xml&lt;/code&gt; now parses Qwen3-Coder XML (alias of &lt;code&gt;qwen3_coder&lt;/code&gt;); use the new &lt;code&gt;qwen3_json&lt;/code&gt; for the JSON format (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5719792428&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60136&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60136/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60136&quot;&gt;#60136&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;New defaults: shared-memory tensor arena on (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5076100188&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/51207&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/51207/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/51207&quot;&gt;#51207&lt;/a&gt;); GLM-5.x FP8 KV cache on SM100 with &lt;code&gt;--kv-cache-dtype auto&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5720012545&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60140&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60140/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60140&quot;&gt;#60140&lt;/a&gt;, &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5733792962&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60281&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60281/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60281&quot;&gt;#60281&lt;/a&gt;); &lt;code&gt;VLLM_DEEPEP_V2_ALLOW_HYBRID_MODE=1&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5530966935&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/57991&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/57991/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/57991&quot;&gt;#57991&lt;/a&gt;); Humming preferred over Marlin on SM90 (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5461092276&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56997&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56997/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56997&quot;&gt;#56997&lt;/a&gt;); &lt;code&gt;sparse_mla_prefill_workspace_factor&lt;/code&gt; 2 above 256K &lt;code&gt;max_model_len&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5794412846&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/61023&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/61023/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/61023&quot;&gt;#61023&lt;/a&gt;); MRV2 for all models on ROCm (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5418857766&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/56360&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/56360/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/56360&quot;&gt;#56360&lt;/a&gt;); &lt;code&gt;VLLM_ROCM_AITER_MLA_DCP_VERIFY=auto&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5701178434&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59965&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59965/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59965&quot;&gt;#59965&lt;/a&gt;); &lt;code&gt;dtype=auto&lt;/code&gt; picks bfloat16 on PowerPC (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5566200869&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/58528&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/58528/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/58528&quot;&gt;#58528&lt;/a&gt;); MXFP4 W4A4 checkpoints fall back to W4A16 with a warning when no W4A4 kernel exists (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5716019227&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60079&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60079/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60079&quot;&gt;#60079&lt;/a&gt;).&lt;/li&gt;
&lt;li&gt;Stricter validation: incompatible &lt;code&gt;--prefix-match-unit&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5532825530&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/58021&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/58021/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/58021&quot;&gt;#58021&lt;/a&gt;), &lt;code&gt;max_num_scheduled_tokens=0&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5768680759&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/60714&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/60714/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/60714&quot;&gt;#60714&lt;/a&gt;), HiSparse with &lt;code&gt;cudagraph_mode=FULL&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5668959918&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/59688&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/59688/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/59688&quot;&gt;#59688&lt;/a&gt;), and negative &lt;code&gt;--device-ids&lt;/code&gt; (&lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;4919829380&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vllm-project/vllm/issues/49053&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vllm-project/vllm/pull/49053/hovercard&quot; href=&quot;https://github.com/vllm-project/vllm/pull/49053&quot;&gt;#49053&lt;/a&gt;) are rejected at startup.&lt;/li&gt;
&lt;/ul&gt;
