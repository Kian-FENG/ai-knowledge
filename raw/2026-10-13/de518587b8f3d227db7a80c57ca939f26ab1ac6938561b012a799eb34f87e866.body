14px;background: #23648B;clip-path: polygon(0 0, 100% 0, 80% 100%, 20% 100%);" data-mid="" mpa-from-tpl="t" data-nest-level="15"><span leaf=""><br/></span></section><section style="width: 6px;height: 14px;background: #23648B;clip-path: polygon(0 0, 100% 0, 80% 100%, 20% 100%);" data-mid="" mpa-from-tpl="t" data-nest-level="15"><span leaf=""><br/></span></section></section><section style="border-top: 1px solid #23648B;border-bottom: 1px solid #23648B;width: 100%;padding: 14px 0px;" data-mid="" mpa-from-tpl="t" data-nest-level="14"><section style="background: #F3F3F3;padding: 12px;width: 100%;" data-mid="" mpa-from-tpl="t" data-nest-level="15"><p yb-mpa-mark="mark-style-text" style="font-size: 14px;color: #2C2C2C;line-height: 24px;" data-mid=""><span leaf="">MEGA电池召回事件让理想意识到掌握核心数据的重要性。</span></p></section></section><section style="display: flex;justify-content: center;align-items: center;grid-column-gap: 3px;align-self: flex-end;margin-top: -8px;background: #fff;padding-left: 6px;z-index: 1;" data-mid="" mpa-from-tpl="t" data-nest-level="14"><section style="width: 6px;height: 14px;background: #23648B;clip-path: polygon(0 0, 100% 0, 80% 100%, 20% 100%);" data-mid="" mpa-from-tpl="t" data-nest-level="15"><span leaf=""><br/></span></section><section style="width: 6px;height: 14px;background: #23648B;clip-path: polygon(0 0, 100% 0, 80% 100%, 20% 100%);" data-mid="" mpa-from-tpl="t" data-nest-level="15"><span leaf=""><br/></span></section></section></section></section></section><section data-pm-slice="2 2 []" style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;text-align: right;line-height: 1.6em;" mpa-from-tpl="t" data-nest-level="11"><span leaf="" data-mpa-action-id="mbrtqb4vv6w" style="margin: 0px;padding: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;font-size: 14px;" data-nest-level="12"><br/></span></section><section data-pm-slice="2 2 []" style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;text-align: right;line-height: 1.6em;" mpa-from-tpl="t" data-nest-level="11"><span leaf="" data-mpa-action-id="mbrtqb4vv6w" style="margin: 0px;padding: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;font-size: 14px;" data-nest-level="12"><span textstyle="" style="color: #888888;">作者 | 王瑞昊</span></span></section><section style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;text-align: right;line-height: 1.6em;" mpa-from-tpl="t" data-nest-level="11"><section style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;" mpa-from-tpl="t" data-nest-level="12"><span leaf="" data-mpa-action-id="mbrtqb4v1pug" style="margin: 0px;padding: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;font-size: 14px;" data-nest-level="13"><span textstyle="" style="color: #888888;">编辑 | 李雨晨</span></span></section></section></section></section></section></section></section><p data-pm-slice="0 0 []" data-nest-level="6"><span leaf="" data-nest-level="7"><br/></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;" data-nest-level="6"><span mpa-font-style="mr1sgj1g1h96" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" data-nest-level="7"><span style="letter-spacing: 0.5px;font-size: 15px;" mpa-font-style="mr1sh3ce1sug" data-nest-level="8" data-mpa-action-id="mudw0koam8y" data-pm-slice="0 0 []"><span mpa-font-style="mudvzfpn1ram" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" data-nest-level="9"><span style="letter-spacing: 0.5px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" mpa-font-style="mudvzy79ndo"><span leaf="" mpa-font-style="mudw0knr6sa" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">“2026年以后新发布的车型，我们都希望采用自研电池。”</span></span></span></span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;" data-nest-level="6"><span mpa-font-style="mr1sgj1g1h96" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" data-nest-level="7"><span style="letter-spacing: 0.5px;font-size: 15px;" mpa-font-style="mr1sh3ce1sug" data-nest-level="8" data-mpa-action-id="mudw0koam8y" data-pm-slice="0 0 []"><span mpa-font-style="mudvzfpn1ram" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" data-nest-level="9"><span style="letter-spacing: 0.5px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" mpa-font-style="mudvzy79ndo"><span leaf="" mpa-font-style="mudw0knr6sa" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">这不是一次试探。雷峰网获悉，目前，理想自研电池已经搭载在新款理想L8、L6和i8上；今年第四季度，新一代理想MEGA、全新理想i9以及2026款理想i6，也将陆续进入自研电池时代。从增程到纯电，六款车在一年之内完成切换。</span></span></span></span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;" data-nest-level="6"><span mpa-font-style="mr1sgj1g1h96" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" data-nest-level="7"><span style="letter-spacing: 0.5px;font-size: 15px;" mpa-font-style="mr1sh3ce1sug" data-nest-level="8" data-mpa-action-id="mudw0koam8y" data-pm-slice="0 0 []"><span mpa-font-style="mudvzfpn1ram" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" data-nest-level="9"><span style="letter-spacing: 0.5px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" mpa-font-style="mudvzy79ndo"><span leaf="" mpa-font-style="mudw0knr6sa" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">同一款车、两个电池版本，用户会不会犹豫？马东辉说：“没有明显波动，反而是有用户主动找过来，希望排产尽早切换，因为他们想尽早提到搭载自研电池的车。”</span></span></span></span></span></span></p><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrg4p" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">“理想为什么要自研电池？”这是马东辉最近被问及最多的问题。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr22oj" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">他的思绪回到了10年前，当年选择增程路线，这条路并不被看好，但理想还是选了它，因为“那是当时能解决用户补能焦虑的唯一解”。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1s0g" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">这个逻辑同样适用于10年后的今天理想选择自己做电池。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr22xx" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">理想早在2023年4月上海车展发布了“双能战略”——智能和电能。其中电池是电能战略里最关键的一环，“不做电池，就谈不上真正意义上的电能战略。”马东辉说。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrp5q" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">更早之前——2015年，理想在内部正式组建电池研发团队，着手自研自制SEV车型的电池包；2019年，理想和宁德时代联合研发推出行业首款增程大电池，成功跑通增程路线；2020年，经过2年内部技术预研，理想正式立项5C超充电池，并和宁德时代联合研发，在2024年推出行业首款5C超充电池；2026年6月随新款L8正式上车首款自研自制电池。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrtnn" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">目前，理想电池自研团队规模在300人左右，硕博占比75%，在北京、上海、苏州都建立了电池实验室，目前在申请与已获专利接近4000项。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrkt0" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">有人问，2025年底MEGA的电池召回事件，是否为理想今天走向自研电池的直接助力。马东辉说，这是理想的责任，无论电池由哪一家合作伙伴生产制造，首先都是理想作为车企去承担责任，“既然用户选择了理想，我们就要对产品最终负责”。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr111a" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">不过，这件事对理想有一个启发——更加意识到掌握核心数据的重要性。如果能打通研发、零部件和整车制造以及验证环节的数据，就可以更早发现问题，从而大幅降低类似风险。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1s89" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">9月21日，理想汽车北京研发总部，总裁兼总工程师马东辉、整车电动研发高级副总裁刘立国、山东理想汽车电池有限公司CEO柳志民与雷峰网等媒体进行了交流，以下为经编辑后的对话实录：</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw26dqlhr"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mce8ut5v1r0s" data-pm-slice="0 0 []"><section style="display: flex;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section style="display: flex;flex-direction: column;align-self: center;" data-mid="" mpa-from-tpl="t"><section style="" data-mid="" mpa-from-tpl="t"><p style="font-weight: bold;font-size: 12px;color: rgb(53, 125, 186);line-height: 15px;word-break: break-word;text-align: center;" data-mid=""><span leaf="" mpa-font-style="mbrs0ibk1ngb" style="font-size: 20px;" data-mpa-action-id="mbrs0ibwh57" data-pm-slice="0 0 []" mpa-is-content="t">PART 1</span><span leaf=""><br/></span></p></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;z-index: 1;margin: 0 0 -9px -1px;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f610894d7.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f610894d7.png?imageMogr2/quality/90"/></section><section style="align-self: flex-start;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mbrrx76d4ei" data-pm-slice="0 0 []"><section style="display: flex;align-items: flex-start;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;background: rgb(255, 255, 255);height: 6px;" data-mid="" mpa-from-tpl="t"><span leaf="" data-mpa-action-id="mbrrx75dfbf" style="font-size: 28px;"><br/></span></section></section><section style="background: rgb(255, 255, 255);text-align: center;padding: 3px 14px 8px;font-size: 12px;" data-mid="" mpa-from-tpl="t" mpa-font-style="mbrry8gb6us" data-mpa-action-id="mbrry8hb219o" data-pm-slice="0 0 []"><section style="padding: 0px 5px;border-bottom: 7px solid rgb(53, 125, 186);margin-bottom: 0px;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mocw37w6swn" data-pm-slice="0 0 []"><p style="margin-top: 0px;margin-right: 0px;margin-left: 0px;font-weight: bold;color: rgb(34, 34, 34);line-height: 17px;word-break: break-word;text-align: center;" data-mid="" yb-mpa-mark="mark-style-text"><span leaf=""><br/></span></p><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vrbsw"><span leaf="" mpa-is-content="t">不是为了省钱</span></span></span><h2 style="text-align: justify;margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;"><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vr1oql"><span leaf="" mpa-is-content="t">也不是为了换供应商</span></span></span><strong mpa-from-tpl="t"><span leaf=""><br/></span></strong></h2></section></section></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;margin: -10px -4px 0 0;align-self: flex-end;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f610a9f84.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f610a9f84.png?imageMogr2/quality/90"/></section></section></section></section></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw2c8n105q"><section mpa-from-tpl="t" style="margin: 40px 0em 32px;outline: 0px;color: rgb(35, 35, 35);letter-spacing: 0.5px;font-size: 16px;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row nowrap;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;padding-left: 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;outline: 0px;font-size: 17px;line-height: 1.3;text-align: justify;"><p style="margin-right: 0em;margin-left: 0em;outline: 0px;"><span style="font-size: 16px;color: #4499E7;"><strong mpa-from-tpl="t" mpa-is-content="t" style="outline: 0px;"><span leaf="" mpa-is-content="t">问：理想为什么要在这个时间节点自研电池？</span><span leaf=""><br/></span></strong></span></p></section></section></section></section></section></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr81t" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">马东辉：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">十年前发布理想ONE时，很多朋友问过我——理想为什么要做增程？十年之后，我们有机会再沟通一次：理想为什么要做电池，它对用户的价值是什么？</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knreaj" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第一，这是长期战略的延续，不是成本或供应商的选择。战略包含“战”与“略”，也就是“取”与“舍”、“做什么”和“不做什么”，和十年前决定做增程是同一个逻辑。理想的技术战略是2023年4月上海车展发布的“双能战略”——电能和智能，相关研发在正式发布前早已启动：2022年我们搭载了自研增程器，2024年第一代理想MEGA搭载了与宁德时代联合研发、行业首创的5C超充电池。电池是电能战略非常关键的一环——不做电池，就谈不上真正意义上的电能战略。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrbp1" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第二，用户真正关心的不是品牌本身，而是品牌背后的价值。买新能源车，用户真正关心的是那块电池安全不安全、衰减多少、冬季续航是否打折、充电快不快。品牌最终还是要回到能不能为用户创造实际价值。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrwwt" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们认为理想做电池，能提供比采购标品电池更多的价值，核心是“三个打通”。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr17yb" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">一是打通底层数据，目的是安全和质量。从电芯材料、设计、制程，到PACK再到BMS，链条非常长，不做自研自制，企业根本拿不到生产全过程的数据，更无法发挥电池最好的性能。所以在从电芯到PACK再到整车、以及整个测试过程中，理想都坚持把数据打通。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrpmq" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">通过“理想连山系统”打通从材料、零部件生产制造到检测验证的全周期底层数据，包括供应商侧的制造数据，做到可追溯、可定位，电池数据可保存20年；用户提车后还有独立的云端预警系统，7×24小时监测电池健康状态，发现异常提前预警、主动告知，并运营5C超充站实现电池状态自检。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrr0x" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">二是打通整车体验，目的是高性能、长寿命。理想第一代增程系统由发电机、驱动电机、减速器、两个控制器等至少5个部件组装而成；新一代整车系统上，我们把这些部件高度集成为一体，带来了更紧凑的空间、更低的噪音。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr13kl" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">电池也是同样的逻辑——电芯、Pack、BMS、热管理和整车控制不是各自最优就够了，只有作为一套系统联合开发，才能让电池更好服务整车体验，用户提车后也能通过OTA持续优化充电性能和续航表现。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knry43" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">三是打通维修标准和售后服务，目的是让用户获得一致的服务体验。电池衰减、性能异常时，用户第一感觉是找主机厂，但电池包的检测维修和健康度判定往往由电池厂来做，容易变成主机厂、电池厂和用户三方的难题。我们认为不该让用户来回找责任方——用户要的很简单：尽量不出问题，出了问题有人第一时间站出来解决，不管电芯谁家的、Pack谁做的、软件谁写的。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr22q4" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">总结来说，我们更看重自研电池为用户创造什么样的体验。比如刚发布的增程3.0，我们自研自制的增程器做到3年或3万公里的保养周期，也就是第一次保养已经是用车的第三年——国内市场普遍还是一年一万公里，没有哪款产品做到三年三万公里免保养。这不是单靠采购能买到的。</span></span></section><section data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;95baa33b-3499-4868-9427-20414a8ea737&quot;,&quot;height&quot;:679.9960000000001,&quot;width&quot;:1019.994,&quot;currHeight&quot;:679.9960000000001,&quot;currWidth&quot;:1019.994,&quot;natrualHeight&quot;:4000,&quot;natrualWidth&quot;:6000,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:0.169999,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FZF9NbJb4PoQKXtxuccAcroHCnkc%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;ZF9NbJb4PoQKXtxuccAcroHCnkc&quot;,&quot;image_type&quot;:&quot;image/jpeg&quot;,&quot;size&quot;:1,&quot;comments&quot;:[]}]}" nodeleaf="" style="margin-bottom: 0px;line-height: 1.75em;text-align: justify;" data-mpa-action-id="mudw2ta718re" data-pm-slice="0 0 []"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f611057ec.jpg" class="rich_pages wxw-img" data-ratio="0.6666666666666666" data-type="jpeg" data-w="6000" style="background-color: transparent;width: 100%;border-radius: 30px;" data-width="6000" data-height="4000" data-backw="578" data-backh="385" data-imgfileid="100103073" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f611057ec.jpg?imageMogr2/quality/90"/></section><section style="background-color: transparent;text-align: center;margin-bottom: 24px;" data-remoteid="" data-asynid="" src="https://mmbiz.qpic.cn/mmbiz_jpg/cCyjje3LibqUSJ8BfdJWHZoo4YsuMCRYaQmZMWtDvRpTQCvicMEWwRs6aE5omsnh3Ijv4urH0HRnWtxAic2ZCTSsJBte5VyftIwBK2uugB82ME/0?wx_fmt=jpeg&from=appmsg" data-src="" align="" alt="" border="" class="rich_pages wxw-img" data-ratio="0.6666666666666666" data-s="" data-type="jpeg" data-w="6000" aria-label="" aria-braillelabel="" aria-description="" height="" hspace="" ismap="" opacity="" sizes="" title="" type="" usemap="" vspace="" width="" data-width="6000" data-height="4000" data-croporisrc="" data-cropx1="" data-cropx2="" data-cropy1="" data-cropy2="" data-cropselx1="" data-cropselx2="" data-cropsely1="" data-cropsely2="" data-backw="" data-backh="" data-copyright="" data-oversubscription-url="" data-before-oversubscription-url="" data-galleryid="" data-gallerysupplier="" data-cardimg="" data-fileid="" data-imgfileid="100103071" data-positionback="" data-imgqrcoded="1" data-imgid="" data-upload="" data-fromlib="" data-aiimageid="" data-aiimagesource="" data-cacheurl="" data-retry="" data-ignore-width=""><span style="color: #8F959E;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" mpa-font-style="mudw0knrf54"><span leaf="" mpa-font-style="mudw303w1fxw" style="font-size: 12px;" data-mpa-action-id="mudw30431lv1" data-pm-slice="0 0 []"><span textstyle="" style="letter-spacing: 0.5px;color: #888888;">理想汽车联合创始人、总裁兼总工程师 马东辉</span></span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw372qyv3"><section mpa-from-tpl="t" style="margin: 40px 0em 32px;outline: 0px;color: rgb(35, 35, 35);letter-spacing: 0.5px;font-size: 16px;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row nowrap;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;padding-left: 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;outline: 0px;font-size: 17px;line-height: 1.3;text-align: justify;"><p style="margin-right: 0em;margin-left: 0em;outline: 0px;"><span style="font-size: 16px;color: #4499E7;"><strong mpa-from-tpl="t" mpa-is-content="t" style="outline: 0px;"><span leaf="" mpa-is-content="t">问：围绕用户关注的安全、质量、寿命等，理想具体打通了哪些环节？</span><span leaf=""><br/></span></strong></span></p></section></section></section></section></section></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knrj0p" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">刘立国：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">理想做电池自研，核心不是孤立地做一块电芯，而是把关键系统真正打通。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr12yg" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第一，是生产到服务的全链路打通。自研之后，工艺参数的管控程度大幅提升。在理想连山系统中，可以实现从供应商产线的上游材料、电芯制造过程，到PACK，到整车产线装配，再到用户实际使用数据和充电体验数据，最终衔接到服务系统的全链路贯通。过去这条链在中间是断开的，作为主机厂只能看到整车端的参数，很多前端问题已被层层掩盖；现在终端出现任何问题，我们都能第一时间回溯，精确定位是哪个环节出了状况。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1m7g" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第二，是整车系统层面的打通。电池和电驱、电控、充电桩等系统之间存在深度的参数耦合。只有电芯自研，我们才能从底层材料特性出发，把电池与电驱、电控、充电等整车核心系统真正拉通来优化——这种体验提升，是单纯采购成品电芯做集成无法实现的。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr8ua" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">马东辉：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">理想在纯电领域选择5C，就是个典型例子。2024年发布MEGA时搭载5C电池，那时候行业里没有企业真正落地“充电10分钟补充500公里”。5C解决的是补能时间的问题，不是单纯追求一个倍率参数；当时没有完善的5C超充网络，所以我们还同步投入数十亿元，在全国高速和城市核心区域建设超充网络与之匹配。车、电池、桩和云端网络真正协同起来，用户才能获得更快、更稳定、更确定的补能体验。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knrods" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">刘立国：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">充电桩也是自研定义、与伙伴协同制造的，不是简单采购一个外壳。一个超充站内的多个充电桩之间可以根据车辆需求动态调配，实现4C到5C的无缝功率切换。再比如充电枪，理想5C充电枪电流超过700安培，却比过去250安培的充电枪更轻——当时给团队定下的目标很朴素：希望女士在冬天穿着厚衣服，也能单手轻松拎起充电枪。这背后涉及充电枪结构、枪线液冷、热管理、功率分配、软件和控制器等一整套技术设计。在我们之前，行业里没有人在量产充电站上使用液冷方案，现在液冷已经成为主流选择。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr18f7" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第三，是前面提到的售后服务体系打通。传统分工下供应商通常只对主机厂承担合同责任，用户往往要在主机厂、电池供应商和服务体系之间反复沟通，但他只关心能不能尽快解决。电芯自研以后，生产、质量、整车和用户使用的数据真正贯通，服务端可以基于统一的标准和数据体系定位、判断和处理——用户只需要找理想，理想负责定位、解决和服务。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr9lc" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">所以</span></span><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">自研的意义，不只是掌握一项核心技术，更重要的是通过自研实现了从生产到服务、从电池到整车系统、从售后到用户体验的「三重打通」</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">。</span></span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw3ghj1ti5"><section mpa-from-tpl="t" style="margin: 40px 0em 32px;outline: 0px;color: rgb(35, 35, 35);letter-spacing: 0.5px;font-size: 16px;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row nowrap;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;padding-left: 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;outline: 0px;font-size: 17px;line-height: 1.3;text-align: justify;"><p style="margin-right: 0em;margin-left: 0em;outline: 0px;"><span style="font-size: 16px;color: #4499E7;"><strong mpa-from-tpl="t" mpa-is-content="t" style="outline: 0px;"><span leaf="" mpa-is-content="t">问：电池技术已经比较成熟，为什么理想选择在这个时间点自研电池陆续上车？</span><span leaf=""><br/></span></strong></span></p></section></section></section></section></section></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr1deo" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">马东辉：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">我们选择自研其实比较早：理想ONE是2019年底上市的，2020年就正式立项做自研电池。2017到2019年没办法开始，因为第一款产品还没上市、公司没有足够资源；等到理想ONE成功之后，我们就马上持续投入研发。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1cqk" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">理想在研发投入上一直非常坚定：每年差不多是收入的10%，绝对值持续在百亿以上人民币的规模。无论今年经营面临什么样的挑战，研发投入从来没有妥协过。至于为什么今年才陆续上车，是因为技术准备就绪之后，还需要自制产线、需要足以支撑销量规模的产能同时就绪——所以我们花了六年才走到今天。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr1gzg" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">刘立国：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">第一，电池在当下快充技术条件下已是一个相对稳健的技术领域。在质量、可靠性、充电倍率、电池特性等基础指标上，行业已经形成比较成熟的技术体系，单一维度想形成特别大的差异化并不容易。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr13lh" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第二，行业进入成熟阶段，但电池依然有持续突破的空间。未来差异化更多会是在成熟技术基础上的持续突破：比如谁先突破15C并把成本降下来；在行业普遍追求六年十万公里的基础上，谁能做到八年十六万公里、同时保持75%甚至80%的电池健康度。再比如固态电池，如果能率先突破材料、界面等科学层面的关键问题，它就会成为一个全新的技术方向。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1tbm" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第三，自研的价值在于掌握核心技术和产品能力。从成本角度看，用户买到的是同样的产品，长期通过外部采购，成本和价值空间总归会受到产业链分工的影响。把更多的价值留给产品、留给用户，同时坚持健康、长期发展，这是自研很重要的价值。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw46uq153a"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mce8ut5v1r0s" data-pm-slice="0 0 []"><section style="display: flex;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section style="display: flex;flex-direction: column;align-self: center;" data-mid="" mpa-from-tpl="t"><section style="" data-mid="" mpa-from-tpl="t"><p style="font-weight: bold;font-size: 12px;color: rgb(53, 125, 186);line-height: 15px;word-break: break-word;text-align: center;" data-mid=""><span leaf="" mpa-font-style="mbrs0ibk1ngb" style="font-size: 20px;" data-mpa-action-id="mbrs0ibwh57" data-pm-slice="0 0 []" mpa-is-content="t">PART 2</span><span leaf=""><br/></span></p></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;z-index: 1;margin: 0 0 -9px -1px;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f6112438c.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f6112438c.png?imageMogr2/quality/90"/></section><section style="align-self: flex-start;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mbrrx76d4ei" data-pm-slice="0 0 []"><section style="display: flex;align-items: flex-start;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;background: rgb(255, 255, 255);height: 6px;" data-mid="" mpa-from-tpl="t"><span leaf="" data-mpa-action-id="mbrrx75dfbf" style="font-size: 28px;"><br/></span></section></section><section style="background: rgb(255, 255, 255);text-align: center;padding: 3px 14px 8px;font-size: 12px;" data-mid="" mpa-from-tpl="t" mpa-font-style="mbrry8gb6us" data-mpa-action-id="mbrry8hb219o" data-pm-slice="0 0 []"><section style="padding: 0px 5px;border-bottom: 7px solid rgb(53, 125, 186);margin-bottom: 0px;text-align: center;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mocw37w6swn" data-pm-slice="0 0 []"><p style="margin-top: 0px;margin-right: 0px;margin-left: 0px;font-weight: bold;color: rgb(34, 34, 34);line-height: 17px;word-break: break-word;" data-mid="" yb-mpa-mark="mark-style-text"><span leaf=""><br/></span></p><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vrbsw"><span leaf="" mpa-is-content="t">最难的不是把题做出来</span></span></span><h2 style="margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;"><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vr1oql"><span leaf="" mpa-is-content="t">是选对题</span></span></span><strong mpa-from-tpl="t"><span leaf=""><br/></span></strong></h2></section></section></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;margin: -10px -4px 0 0;align-self: flex-end;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f611435e6.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f611435e6.png?imageMogr2/quality/90"/></section></section></section></section></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw4ico1sms"><section mpa-from-tpl="t" style="margin: 40px 0em 32px;outline: 0px;color: rgb(35, 35, 35);letter-spacing: 0.5px;font-size: 16px;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row nowrap;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;padding-left: 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;outline: 0px;font-size: 17px;line-height: 1.3;text-align: justify;"><p style="margin-right: 0em;margin-left: 0em;outline: 0px;"><span style="font-size: 16px;color: #4499E7;"><strong mpa-from-tpl="t" mpa-is-content="t" style="outline: 0px;"><span leaf="" mpa-is-content="t">问：如果回顾六年自研的过程，最难攻克的环节是什么？最大的收益和优势是什么？</span><span leaf=""><br/></span></strong></span></p></section></section></section></section></section></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knrbbc" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">刘立国：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">对工程师来讲，工程本身的技术问题都可以一步步解决——只要投入时间和资源，总能找到方案。最难的，是方向和路线的选择。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrpi7" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第一，是选定增程路线之后，增程电芯的选择和定制化。理想成立之初，市面上没有专门为增程场景设计的电池，功率特性、长循环寿命都不匹配。我们与供应商通过联合开发一点点摸出来，最终在理想ONE上成功搭载了行业首款增程大电池，这也是理想增程路线得以成立的原因之一。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1em7" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第二，是5C超充路线的选择和推动，挑战更大。我们早在2018年就在探索4C、5C这条路线，从开启纯电车型开发的第一天起，纯电就只走800V高压超充这一条路，从来没有反复过。要做5C，是因为我们认为大规模替代燃油车，需要媲美燃油车的充电体验。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrezz" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">但当时行业在快充和换电之间摇摆，对5C并不认可——2018年我们找遍全球前十的供应商，所有人都告诉我们这条路走不通。于是我们花了两年自己做预研，先把技术路线摸出来、把可行性验证清楚，2020年才正式立项，说服供应商推进更深入的联合开发和量产验证。“先摸索方向、再验证可行性、再推动联合研发”，这个过程当时走得比较艰难。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrzv8" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第三，是2020年真正走向自研之后，验证标准的大幅提高。自研意味着要为技术方案负全责，验证会做得更苛刻：我们做的EMB、主动悬架都做了百万公里验证，电池电芯的验证同样高标准，验证样本量在行业内处于领先水平。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrdfn" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">收益核心是两方面：</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1bd6" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">一方面是一体化设计带来的确定性。从电芯本身，到整车热管理，到超充站建设，再到跟国家电网谈供电容量，这是一整套系统设计，不是单点优化。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1rb5" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">比如一个超充站国家电网能给到的最大供电容量一般在600千瓦左右，而我们100度电的电池5C峰值功率已经超过500千瓦，一把枪就要用掉整站容量的八成以上；600千瓦还算大的，很多站实际只有480千瓦甚至更低。储能对峰值充电的贡献较小，主要作用是削峰填谷。所以我们坚持5C、并会在未来很长一段时间继续坚持——5C能给用户最高确定性的补能体验，几乎每一个站都能稳定兑现。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1efq" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">另一方面是技术路线选择上更长期的可靠性。当时电芯面临两条路线：一条是“降低内阻”——产热公式是P=I²R，想充得快电流必须大，电流越大产热越多，要产热小就得减小内阻。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1xwg" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">另一条更简单，不降内阻而是提升电芯耐热能力，但产热短期能扛住，长期高温对耐久性和可靠性始终不利，而且充电越快、电流越大，不断提升耐热能力就像不断建更高的堤坝，长期看并不可靠。我们选择了“降内阻”这条难而正确的路，不管对铁锂还是三元，这都是我们一直坚持的方向。</span></span></section><section data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;bdefadfa-7090-4e6a-b755-ec9a6aa92e94&quot;,&quot;height&quot;:679.938465,&quot;width&quot;:1019.994981,&quot;currHeight&quot;:679.938465,&quot;currWidth&quot;:1019.994981,&quot;natrualHeight&quot;:3895,&quot;natrualWidth&quot;:5843,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:0.174567,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FDHrTbcuszon3pBxT9kJc2hAxn0d%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;DHrTbcuszon3pBxT9kJc2hAxn0d&quot;,&quot;image_type&quot;:&quot;image/jpeg&quot;,&quot;size&quot;:1,&quot;comments&quot;:[]}]}" nodeleaf="" style="margin-bottom: 0px;line-height: 1.75em;text-align: justify;" data-mpa-action-id="mudw4tew19qw" data-pm-slice="0 0 []"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f61179431.jpg" class="rich_pages wxw-img" data-ratio="0.6666096183467397" data-type="jpeg" data-w="5843" style="background-color: transparent;width: 100%;border-radius: 30px;" data-width="5843" data-height="3895" data-backw="578" data-backh="385" data-imgfileid="100103078" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f61179431.jpg?imageMogr2/quality/90"/></section><section style="background-color: transparent;text-align: center;margin-bottom: 24px;" data-remoteid="" data-asynid="" src="https://mmbiz.qpic.cn/mmbiz_jpg/cCyjje3LibqUJ62EmaTUFT3vHWEkjibgKMEp8uiaG7Bicky41VXgujXtHibN3uZg7fmksA6JmyIKkkTm4iafbW7FD1DbxRmmghqDC7NZkpKb8ZP1U/0?wx_fmt=jpeg&from=appmsg" data-src="" align="" alt="" border="" class="rich_pages wxw-img" data-ratio="0.6666096183467397" data-s="" data-type="jpeg" data-w="5843" aria-label="" aria-braillelabel="" aria-description="" height="" hspace="" ismap="" opacity="" sizes="" title="" type="" usemap="" vspace="" width="" data-width="5843" data-height="3895" data-croporisrc="" data-cropx1="" data-cropx2="" data-cropy1="" data-cropy2="" data-cropselx1="" data-cropselx2="" data-cropsely1="" data-cropsely2="" data-backw="" data-backh="" data-copyright="" data-oversubscription-url="" data-before-oversubscription-url="" data-galleryid="" data-gallerysupplier="" data-cardimg="" data-fileid="" data-imgfileid="100103065" data-positionback="" data-imgqrcoded="" data-imgid="" data-upload="" data-fromlib="" data-aiimageid="" data-aiimagesource="" data-cacheurl="" data-retry="" data-ignore-width=""><span style="color: #8F959E;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" mpa-font-style="mudw0knrl9k"><span leaf="" mpa-font-style="mudw4xtu1dny" style="font-size: 12px;" data-mpa-action-id="mudw4xu1lr6" data-pm-slice="0 0 []"><span textstyle="" style="letter-spacing: 0.5px;color: #888888;">理想汽车整车电动研发高级副总裁、山东理想汽车电池有限公司董事长 刘立国</span></span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw54xo14ok"><section mpa-from-tpl="t" style="margin: 40px 0em 32px;outline: 0px;color: rgb(35, 35, 35);letter-spacing: 0.5px;font-size: 16px;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row nowrap;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;padding-left: 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;outline: 0px;font-size: 17px;line-height: 1.3;text-align: justify;"><p style="margin-right: 0em;margin-left: 0em;outline: 0px;"><span style="font-size: 16px;color: #4499E7;"><strong mpa-from-tpl="t" mpa-is-content="t" style="outline: 0px;"><span leaf="" mpa-is-content="t">问：现在理想自研电池在结构、材料上的创新，用户能真切感受到哪些变化？下一代的方向是什么？</span><span leaf=""><br/></span></strong></span></p></section></section></section></section></section></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr4uf" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">柳志民：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">从产品价值出发，去解决甚至超越用户需求，是我们做研发的核心逻辑。2018年起我们就为5C超充做前期预研，2020年跑通了可能的技术路径——当时我们要找的是能同时兼顾5C快充、700公里续航和综合能量密度的方案，市面上没有现成答案，所以必须从材料、配方、体系、结构最底层做技术原型验证，通过后再进入产品定义和核心技术攻坚阶段。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrnv8" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">电池的创新不只是电芯本身，还涉及整个电池系统集成：怎么高效散热，怎么和整车控制策略协同，让电池在全场景下都提供稳定性能——这是一套体系性创新，不是单点突破。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrhms" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">理想超充电池从今年L8开始，L6、MEGA、i8、i9、i6都已或将会搭载自研电池。过去一年我们为长寿命做了大量改进：正负极电解液的改性、极片工艺改进以及应用策略优化，让电池使用寿命有30%的显著提升。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1zxz" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">面向下一代，我们从去年开始推进15C超充技术，目前已实现15C能力，也有搭载15C电池的车在路跑测试——但不会为了追一个更高的倍率数字草率推出，一定要给用户足够确定性的体验才会量产。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr216u" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们也希望未来电动车的电池真正成为用户的一项“资产”，下一代我们会持续在更快的超充速度、更高的可靠性、更长的寿命、更高的能量密度几个方向深入创新，并同步推进固态电池相关技术路线。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw5lc31vfw"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mce8ut5v1r0s" data-pm-slice="0 0 []"><section style="display: flex;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section style="display: flex;flex-direction: column;align-self: center;" data-mid="" mpa-from-tpl="t"><section style="" data-mid="" mpa-from-tpl="t"><p style="font-weight: bold;font-size: 12px;color: rgb(53, 125, 186);line-height: 15px;word-break: break-word;text-align: center;" data-mid=""><span leaf="" mpa-font-style="mbrs0ibk1ngb" style="font-size: 20px;" data-mpa-action-id="mbrs0ibwh57" data-pm-slice="0 0 []" mpa-is-content="t">PART 3</span><span leaf=""><br/></span></p></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;z-index: 1;margin: 0 0 -9px -1px;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f6119a164.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f6119a164.png?imageMogr2/quality/90"/></section><section style="align-self: flex-start;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mbrrx76d4ei" data-pm-slice="0 0 []"><section style="display: flex;align-items: flex-start;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;background: rgb(255, 255, 255);height: 6px;" data-mid="" mpa-from-tpl="t"><span leaf="" data-mpa-action-id="mbrrx75dfbf" style="font-size: 28px;"><br/></span></section></section><section style="background: rgb(255, 255, 255);text-align: center;padding: 3px 14px 8px;font-size: 12px;" data-mid="" mpa-from-tpl="t" mpa-font-style="mbrry8gb6us" data-mpa-action-id="mbrry8hb219o" data-pm-slice="0 0 []"><section style="padding: 0px 5px;border-bottom: 7px solid rgb(53, 125, 186);margin-bottom: 0px;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mocw37w6swn" data-pm-slice="0 0 []"><p style="margin-top: 0px;margin-right: 0px;margin-left: 0px;font-weight: bold;color: rgb(34, 34, 34);line-height: 17px;word-break: break-word;text-align: center;" data-mid="" yb-mpa-mark="mark-style-text"><span leaf=""><br/></span></p><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vrbsw"><span leaf="" mpa-is-content="t">哪些必须自己干</span></span></span><h2 style="text-align: justify;margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;"><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vr1oql"><span leaf="" mpa-is-content="t">&nbsp;哪些交给产业链&nbsp;</span></span></span><strong mpa-from-tpl="t"><span leaf=""><br/></span></strong></h2></section></section></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;margin: -10px -4px 0 0;align-self: flex-end;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f611b8c0c.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f611b8c0c.png?imageMogr2/quality/90"/></section></section></section></section></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw5ti31ydo"><section mpa-from-tpl="t" style="margin: 40px 0em 32px;outline: 0px;color: rgb(35, 35, 35);letter-spacing: 0.5px;font-size: 16px;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row nowrap;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;padding-left: 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;outline: 0px;font-size: 17px;line-height: 1.3;text-align: justify;"><p style="margin-right: 0em;margin-left: 0em;outline: 0px;"><span style="font-size: 16px;color: #4499E7;"><strong mpa-from-tpl="t" mpa-is-content="t" style="outline: 0px;"><span leaf="" mpa-is-content="t">问：刚才我们了解到在电芯上已经实现了100%自研，模式上为什么选择PACK自研自制？为什么又要电芯自研代工？</span><span leaf=""><br/></span></strong></span></p></section></section></section></section></section></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr18rd" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">马东辉</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">：战略分为选择和落地，落地有自研和外购两种方式。像玻璃、轮胎我们都是外购，因为这些零部件发展多年、体验成熟稳定；而决定用户差异化体验的核心技术，我们选择自研。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1rw0" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">自研又分自研自制和自研代工，二者并不是对立的——即便是自研自制，也不意味着所有零件都自己生产，至少有些材料没有必要自制。以电驱动为例：新一代自研自制的碳化硅电驱系统拆开看有几个层次——转子是我们设计、交给合作伙伴汇川代工生产的；碳化硅芯片也是我们自研、找代工厂生产；基于碳化硅芯片做的功率模组封装和控制器是我们完全自制的；最后把控制器、转子和自制的定子组装在一起，总装和测试都由我们自己完成。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr19w7" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">再比如今年五月Livis Day上发布的马赫M100芯片，设计是我们自研的，代工交给台积电；代工完成后我们把芯片做成控制器，这部分是自研自制，但贴片环节又找专业厂商代工。所以自研自制和自研代工不是简单的二元对立，而是基于战略判断做出的一系列具体选择。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knru7u" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">回到PACK和电芯本身。PACK为什么要自研自制？因为它跟整车的底盘系统、驱动系统、整车架构设计高度耦合——我没法把别家的PACK直接装到自己的车上。虽然有换电技术，但电池包也没办法做到像加油一样“即插即充即走”，它的物理边界太大，而这个边界又跟整车强相关。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1vi0" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">不光是物理尺寸，整套热管理系统每家设计都不一样。更重要的是，PACK里承载着BMS的软硬件系统——这正是“数据打通”的关键载体：从上游生产制造的数据，到用户使用过程中的数据，再到充电过程中的数据，都要靠PACK来承载和贯穿。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr22ci" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">电芯为什么选择自研代工？化学体系和电芯结构由我们研发，生产环节交给国内优秀的电池生产企业——他们在制造管理能力和工艺水平上有长期积累，双方正好互补。就像芯片是我们自己研发的，但规模化生产交给专业伙伴，更利于成本和效率的最优化。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw60sm24g7"><section mpa-from-tpl="t" style="margin: 40px 0em 32px;outline: 0px;color: rgb(35, 35, 35);letter-spacing: 0.5px;font-size: 16px;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row nowrap;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;padding-left: 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;outline: 0px;font-size: 17px;line-height: 1.3;text-align: justify;"><p style="margin-right: 0em;margin-left: 0em;outline: 0px;"><span style="font-size: 16px;color: #4499E7;"><strong mpa-from-tpl="t" mpa-is-content="t" style="outline: 0px;"><span leaf="" mpa-is-content="t">问：长期来看，哪些能力自己做，哪些交给产业链，边界在哪？</span><span leaf=""><br/></span></strong></span></p></section></section></section></section></section></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr2z6" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">刘立国：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">第一，围绕电能和智能两个战略方向，我们坚定加大投入。电能方面包括电驱动、增程系统、电池和热管理，其中热管理也是典型的自研代工模式；代表未来技术趋势和竞争方向的新赛道，比如主动悬架、EMB及其核心部件，同样采用深度自研加代工的方式。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr23zx" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第二，如果一项新技术能给用户带来差异化价值，但市场上没有成熟方案，交给供应商也无法满足需求，这部分我们必须自己下场。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr3wd" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">理想的原则是：对决定用户体验和产品差异化的关键技术，坚持深度自研和主导；对需要长期制造积累、规模效率和产业协同的环节，则与优秀产业伙伴深度合作。比如保险杠，行业里有不少公司选择自制来追求低成本，但这类部件不在我们的战略方向内，造型由我们来做，方案和制造交给供应商。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrh45" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">除此之外，我们不过多介入供应商端的战略开发，核心是在整车层面提出需求、把技术方案和验证做好，制造端则充分发挥供应商成熟的制造能力。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1m78" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">问：电池企业在材料、工艺和量产一致性上积累了大量Know-how，理想能否跨越这些能力门槛？</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knrsok" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">柳志民：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">研发投入的绝对值和企业经营范围强相关。理想围绕电池研发更多聚焦自身产品平台，只聚焦5C超充电池，所以投入的绝对值不会达到电池企业同样的规模。但我们不认为投入绝对值的高低就能简单等同于谁更专业。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1r3b" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">从2018年开始做原型技术论证起，在供应商都告诉我们做不到的情况下，我们花两年时间摸索出可能的技术路径，并把价值主张和技术方案传递给上下游伙伴，协同从材料到电芯的合作伙伴、调动产业资源共同实现目标。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1ciw" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">从底层创新逻辑看，无论外购、自研代工还是自研自制，理想在电池技术研发上采用的都是全栈自研，覆盖最基础的材料和工艺开发。在5C研发初期行业没有完整解决方案，我们必须自己找到可行路径并解决每个环节的落地。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrwbf" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">例如在正负极材料上，我们与上游供应商签订了多项战略框架协议，围绕石墨负极、三元正极进行定制化开发和产业孵化，也希望伙伴能把相关技术推广到整个行业。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrhrw" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">在PACK结构、整车协同、BMS算法和产品定义上，理想也做了大量创新。以理想i6为例，我们针对磷酸铁锂电池低SoC（电池荷电状态）电量跳变的问题，通过算法与材料体系的协同创新有效降低了跳变：行业内通常需要通过满充进行电量校准，而理想的自研电池可以把满充校准的需求控制在较低水平。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw6kur11g4"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mce8ut5v1r0s" data-pm-slice="0 0 []"><section style="display: flex;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section style="display: flex;flex-direction: column;align-self: center;" data-mid="" mpa-from-tpl="t"><section style="" data-mid="" mpa-from-tpl="t"><p style="font-weight: bold;font-size: 12px;color: rgb(53, 125, 186);line-height: 15px;word-break: break-word;text-align: center;" data-mid=""><span leaf="" mpa-font-style="mbrs0ibk1ngb" style="font-size: 20px;" data-mpa-action-id="mbrs0ibwh57" data-pm-slice="0 0 []" mpa-is-content="t">PART 4</span><span leaf=""><br/></span></p></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;z-index: 1;margin: 0 0 -9px -1px;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f611d6000.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f611d6000.png?imageMogr2/quality/90"/></section><section style="align-self: flex-start;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mbrrx76d4ei" data-pm-slice="0 0 []"><section style="display: flex;align-items: flex-start;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;background: rgb(255, 255, 255);height: 6px;" data-mid="" mpa-from-tpl="t"><span leaf="" data-mpa-action-id="mbrrx75dfbf" style="font-size: 28px;"><br/></span></section></section><section style="background: rgb(255, 255, 255);text-align: center;padding: 3px 14px 8px;font-size: 12px;" data-mid="" mpa-from-tpl="t" mpa-font-style="mbrry8gb6us" data-mpa-action-id="mbrry8hb219o" data-pm-slice="0 0 []"><section style="padding: 0px 5px;border-bottom: 7px solid rgb(53, 125, 186);margin-bottom: 0px;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mocw37w6swn" data-pm-slice="0 0 []"><p style="margin-top: 0px;margin-right: 0px;margin-left: 0px;font-weight: bold;color: rgb(34, 34, 34);line-height: 17px;word-break: break-word;text-align: center;" data-mid="" yb-mpa-mark="mark-style-text"><span leaf=""><br/></span></p><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vrbsw"><span leaf="" mpa-is-content="t">跳过6C和12C</span></span></span><h2 style="text-align: justify;margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;"><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vr1oql"><span leaf="" mpa-is-content="t">&nbsp;直接开始预研15C&nbsp;</span></span></span><strong mpa-from-tpl="t"><span leaf=""><br/></span></strong></h2></section></section></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;margin: -10px -4px 0 0;align-self: flex-end;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f612022dc.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f612022dc.png?imageMogr2/quality/90"/></section></section></section></section></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw6soj10ay"><section mpa-from-tpl="t" style="margin: 40px 0em 32px;outline: 0px;color: rgb(35, 35, 35);letter-spacing: 0.5px;font-size: 16px;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row nowrap;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;padding-left: 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;outline: 0px;font-size: 17px;line-height: 1.3;text-align: justify;"><p style="margin-right: 0em;margin-left: 0em;outline: 0px;"><span style="font-size: 16px;color: #4499E7;"><strong mpa-from-tpl="t" mpa-is-content="t" style="outline: 0px;"><span leaf="" mpa-is-content="t">问：第一个问题，理想从供应商身份变成股东，管理权责有什么变化，如何权衡？第二个问题，整车厂接下来怎么保证技术主权？</span><span leaf=""><br/></span></strong></span></p></section></section></section></section></section></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knrh0o" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">刘立国：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">在研发合作过程中，电池的技术原型方案阶段由我们主导设计；到后期PD阶段（产品项目开发阶段）和量产导入，双方团队逐步深度参与、协同推进。我们在山东成立了电池有限公司，目前派驻山东与欣旺达协同的团队几十人，此前在深圳的前期研发阶段也派驻了不少人。简单来说，针对5C这样的具体目标，原型方案设计以我们为主导，量产落地是双方共同完成的。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1xev" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">关于如何保证技术主权，核心是三点：</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr20em" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第一，在现有5C基础上进一步提升寿命和可靠性，这是当前研发的主攻方向，通过在安全性、可靠性和长寿命上持续精进，构建技术壁垒。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knra6z" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第二，向更高倍率快充突破，目标是15C。当初做5C，是因为行业普遍还在1.5C、2C、2.5C的水平，用户充电要35到40分钟；做到5C之后充电时间降到10分钟500公里，不同温度下均衡来看，目前用户平均充电时间大概13分钟。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1pn3" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们没有跟进行业里的6C、8C、10C，是因为从10分钟降到8分钟，用户感知的提升并不明显，代价却很大——电池体系和充电站都要更新升级，用户实际只感受到两分钟的缩短。所以目标直接定义为15C：如果能走通，价值是把充电时间从10分钟降到5分钟以下，这是代次级的提升。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr68t" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第三，更远期的方向是固态电池。固态电池这几年非常火热，国家也大力支持。但我们的判断是，它距离在乘用车上规模化渗透还需要更长时间，最早可能应用在低空飞行这类对能量密度要求极高、对成本不那么敏感的产品上；到乘用车领域，我估计要到2032年以后才逐渐开始有渗透率，届时渗透率可能也在1%以下。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr1k79" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">柳志民：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">我们跟欣旺达从2019年开始接触，2021年开启第一个项目的联合开发。这次投资并不是第一次——2022年我们就投资了欣旺达四个亿，那时候已经有深度的战略协同。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrjqa" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们的技术标准都是导入的：不只是质量、制造标准，从最开始的原型方案设计、产品定义、技术方案选择、工程落地方案、产线规划，甚至双方团队的文化协同、工具链协同。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1zvw" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">讲一个小事情，欣旺达的飞书都是理想汽车帮助导入的。去年我们在山东成立了合资公司，PACK通过合资的方式自研自制；电芯也不只是定义特性，在制造环节的设备与工厂规划阶段我们就开始深度融合。</span></span></section><section data-type="image" data-ace-gallery-json="{&quot;items&quot;:[{&quot;uuid&quot;:&quot;1637a06d-085c-4048-ae1f-f0dab47e4667&quot;,&quot;height&quot;:679.9960000000001,&quot;width&quot;:1019.994,&quot;currHeight&quot;:679.9960000000001,&quot;currWidth&quot;:1019.994,&quot;natrualHeight&quot;:4000,&quot;natrualWidth&quot;:6000,&quot;pluginName&quot;:&quot;imageUpload&quot;,&quot;scale&quot;:0.169999,&quot;src&quot;:&quot;https%3A%2F%2Finternal-api-drive-stream.feishu.cn%2Fspace%2Fapi%2Fbox%2Fstream%2Fdownload%2Fpreview%2FCmvzbfcOCoExHex8AU3chlsbnFN%2F%3Fpreview_type%3D16&quot;,&quot;file_token&quot;:&quot;CmvzbfcOCoExHex8AU3chlsbnFN&quot;,&quot;image_type&quot;:&quot;image/jpeg&quot;,&quot;size&quot;:1,&quot;comments&quot;:[]}]}" nodeleaf="" style="margin-bottom: 0px;line-height: 1.75em;text-align: justify;" data-mpa-action-id="mudw720csii" data-pm-slice="0 0 []"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f61222270.jpg" class="rich_pages wxw-img" data-ratio="0.6666666666666666" data-type="jpeg" data-w="6000" style="background-color: transparent;width: 100%;border-radius: 30px;" data-width="6000" data-height="4000" data-backw="578" data-backh="385" data-imgfileid="100103079" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f61222270.jpg?imageMogr2/quality/90"/></section><section style="background-color: transparent;text-align: center;margin-bottom: 24px;" data-remoteid="" data-asynid="" src="https://mmbiz.qpic.cn/mmbiz_jpg/cCyjje3LibqUjsKaBBLUIJ4V1FCicLDPUBHbOpOpsB4xrj43XBt6PfaJj9pWOTFPfwo6ibrR7UrZuMo0vPemSibI7kuwxOT8Cs76Jw0jwnOdibaI/0?wx_fmt=jpeg&from=appmsg" data-src="" align="" alt="" border="" class="rich_pages wxw-img" data-ratio="0.6666666666666666" data-s="" data-type="jpeg" data-w="6000" aria-label="" aria-braillelabel="" aria-description="" height="" hspace="" ismap="" opacity="" sizes="" title="" type="" usemap="" vspace="" width="" data-width="6000" data-height="4000" data-croporisrc="" data-cropx1="" data-cropx2="" data-cropy1="" data-cropy2="" data-cropselx1="" data-cropselx2="" data-cropsely1="" data-cropsely2="" data-backw="" data-backh="" data-copyright="" data-oversubscription-url="" data-before-oversubscription-url="" data-galleryid="" data-gallerysupplier="" data-cardimg="" data-fileid="" data-imgfileid="100103070" data-positionback="" data-imgqrcoded="1" data-imgid="" data-upload="" data-fromlib="" data-aiimageid="" data-aiimagesource="" data-cacheurl="" data-retry="" data-ignore-width=""><span style="color: #8F959E;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" mpa-font-style="mudw0knrx94"><span leaf="" mpa-font-style="mudw78x4lnm" style="font-size: 12px;" data-mpa-action-id="mudw78xb1zfj" data-pm-slice="0 0 []"><span textstyle="" style="letter-spacing: 0.5px;color: #888888;">山东理想汽车电池有限公司CEO、理想汽车动力电池高级总监 柳志民</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr1666" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">马东辉：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">大家说理想抠、花钱谨慎，是因为我们知道赚钱不容易，希望把成本用到产品上，也没有过多的钱做宣传。但我们从来不做财务投资，做的都是战略和技术上的投资，所以从2022年到现在，投欣旺达对理想是一件非常重要的事。我们只是最近公布了消息，但开始的时间可不是今天。举例说，柳博未来得有90%的时间都会在工厂里面，虽然家在北京，但为了做好事业，就得下这样的决心。</span></span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw7fpziq6"><section mpa-from-tpl="t" style="margin: 40px 0em 32px;outline: 0px;color: rgb(35, 35, 35);letter-spacing: 0.5px;font-size: 16px;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row nowrap;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;padding-left: 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;outline: 0px;font-size: 17px;line-height: 1.3;text-align: justify;"><p style="margin-right: 0em;margin-left: 0em;outline: 0px;"><span style="font-size: 16px;color: #4499E7;"><strong mpa-from-tpl="t" mpa-is-content="t" style="outline: 0px;"><span leaf="" mpa-is-content="t">问：15C超充和固态电池有量产时间表吗？另外闪充主要是比亚迪在做，同样快的还有换电，你们考虑过做换电吗？</span><span leaf=""><br/></span></strong></span></p></section></section></section></section></section></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr153t" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">柳志民：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">关于15C，技术准备与量产应用是两个阶段。去年公司内部原型方案已经到了B样阶段（设计基本锁定、接近量产状态），整个电池系统的解决方案都已完成，并在车上做了大量验证。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr11rq" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">但在下一代配套设施完善之前，当下我们还是用5C给用户提供补能确定性，同时在充电性能基础上不断提升寿命和能量密度。只从技术层面看，预计明年可以完成相关技术准备；但整体量产应用还要根据车型规划判断，以及15C相对5C的价值增益是否还需要快速迭代。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrpe8" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">关于固态电池，目前仍处于技术攻关阶段。我们从材料、界面到电芯器件、系统集成方案都有持续投入，但几个核心问题还存在科学和工程瓶颈：一是寿命，如何做到更长的使用寿命；二是充电性能，围绕理想的价值主张实现足够高的充电性能目前仍有挑战；三是成本，当前固态电池成本高于液态电池数倍，如何让用户用合理成本享受更好体验，中间还有大量科学和工程问题需要解决。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knryi4" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们已有多个项目在开发，也在眼镜产品上做了固态电池原型验证，但在整车上实现成熟量产、保证用户体验确定性，我们判断预计还需要5年时间。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrp1c" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">关于路线，当下我们首先聚焦5C整体的补能体验。我们也看到比亚迪在大力推进闪充，随着场站逐步完善，体验也在提升。但现阶段我们更看重补能体验的确定性，这需要跟场站和超充桩的电容能力相匹配，所以理想还是会专注5C超充路线。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1otl" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">关于换电，理想从第一代产品就选择了增程，2020年起启动超充技术的研究，在解决用户补能焦虑上已经做出了选择。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw7kqrize"><section mpa-from-tpl="t" style="margin: 40px 0em 32px;outline: 0px;color: rgb(35, 35, 35);letter-spacing: 0.5px;font-size: 16px;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row nowrap;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;padding-left: 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;outline: 0px;font-size: 17px;line-height: 1.3;text-align: justify;"><p style="margin-right: 0em;margin-left: 0em;outline: 0px;"><span style="font-size: 16px;color: #4499E7;"><strong mpa-from-tpl="t" mpa-is-content="t" style="outline: 0px;"><span leaf="" mpa-is-content="t">问：自研电池在多大程度上是为纯电战略做准备？未来增程和纯电两条产品线如何定位？</span><span leaf=""><br/></span></strong></span></p></section></section></section></section></section></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr2476" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">刘立国：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">我们现在是增程和纯电两条腿走路。增程经历了三代演进：1.0是理想ONE时代，2.0是L系列，3.0是今年发布的新一代增程，随着自研深度不断加大，进步非常迅速。增程3.0实现三年三万公里的保养周期，核心目的是让增程的整体使用体验无限接近纯电——从NVH角度已经做到基本一致，从保养角度也已经接近纯电。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1ce7" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">使用成本上，城市场景纯电仍有优势，因为家充电费很低；高速场景由于服务区电价较高、纯电车型高速电耗也比较大，增程的使用成本已经越来越接近纯电。两条产品线都会持续投入，不存在哪一个必然替代另一个的问题。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr1z3y" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">马东辉：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">理想在不同阶段会根据市场环境和用户需求做出不同选择：2017年开始做增程，是结合当时的电池价格和补能条件；2024年第一款纯电车型上市，是因为当时5C技术已经具备条件，能把充电时间大幅缩短。所以第一点是节奏。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrnfk" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">在这个时间点推出自研电池同样是节奏上的选择；自研电池是理想三电核心能力建设的重要组成部分，会同时服务纯电和增程两条产品路线。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1vdz" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第二点，关于纯电和增程未来的比例。中国市场新能源汽车渗透率已经超过60%。前段时间我从北京开车到哈尔滨，没想到那里也有那么多用户拥抱纯电、拥抱我们新上市的MEGA，这打破了我的认知。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1c4o" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">但中国太大，各地气候和充电设施条件不同，有些地方寒冷、有些地方人口稀少，因此未来很长一段时间内，纯电和增程都会有市场。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1jin" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">增程对理想还有一个重要意义，是海外战略。全球很多地方的补能条件远不如中国，就像十年前的中国一样。可油可电的增程，既能带来补能的便捷性，也能提供电动车的驾驶体验和智能化体验，是我们推行海外战略中非常重要的技术路线。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw7rsarau"><section mpa-from-tpl="t" style="margin: 40px 0em 32px;outline: 0px;color: rgb(35, 35, 35);letter-spacing: 0.5px;font-size: 16px;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row nowrap;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;padding-left: 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;outline: 0px;font-size: 17px;line-height: 1.3;text-align: justify;"><p style="margin-right: 0em;margin-left: 0em;outline: 0px;"><span style="font-size: 16px;color: #4499E7;"><strong mpa-from-tpl="t" mpa-is-content="t" style="outline: 0px;"><span leaf="" mpa-is-content="t">问：未来几年，自研代工电芯和外供电芯的比例计划控制在多少？产能是否足够？</span><span leaf=""><br/></span></strong></span></p></section></section></section></section></section></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr1v8f" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">马东辉：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">2026年以后新发布的车型，我们都希望采用自研电池——PACK自研自制，电芯自研代工。PACK产能会根据国内外销量需求，提前匹配电芯产能和电池PACK产能。电芯代工伙伴现在是欣旺达和中创新航，如果未来销量和市占率提升，也会寻找更多头部电池企业合作，前提是符合“三个打通”策略。所以不存在与外购分比例的问题。</span></span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw8321bbx"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mce8ut5v1r0s" data-pm-slice="0 0 []"><section style="display: flex;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section style="display: flex;flex-direction: column;align-self: center;" data-mid="" mpa-from-tpl="t"><section style="" data-mid="" mpa-from-tpl="t"><p style="font-weight: bold;font-size: 12px;color: rgb(53, 125, 186);line-height: 15px;word-break: break-word;text-align: center;" data-mid=""><span leaf="" mpa-font-style="mbrs0ibk1ngb" style="font-size: 20px;" data-mpa-action-id="mbrs0ibwh57" data-pm-slice="0 0 []" mpa-is-content="t">PART 5</span><span leaf=""><br/></span></p></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;z-index: 1;margin: 0 0 -9px -1px;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f6123ea1e.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f6123ea1e.png?imageMogr2/quality/90"/></section><section style="align-self: flex-start;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mbrrx76d4ei" data-pm-slice="0 0 []"><section style="display: flex;align-items: flex-start;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;background: rgb(255, 255, 255);height: 6px;" data-mid="" mpa-from-tpl="t"><span leaf="" data-mpa-action-id="mbrrx75dfbf" style="font-size: 28px;"><br/></span></section></section><section style="background: rgb(255, 255, 255);text-align: center;padding: 3px 14px 8px;font-size: 12px;" data-mid="" mpa-from-tpl="t" mpa-font-style="mbrry8gb6us" data-mpa-action-id="mbrry8hb219o" data-pm-slice="0 0 []"><section style="padding: 0px 5px;border-bottom: 7px solid rgb(53, 125, 186);margin-bottom: 0px;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mocw37w6swn" data-pm-slice="0 0 []"><p style="margin-top: 0px;margin-right: 0px;margin-left: 0px;font-weight: bold;color: rgb(34, 34, 34);line-height: 17px;word-break: break-word;text-align: center;" data-mid="" yb-mpa-mark="mark-style-text"><span leaf=""><br/></span></p><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vrbsw"><span leaf="" mpa-is-content="t">自研不一定比外采便宜</span></span></span></section></section></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;margin: -10px -4px 0 0;align-self: flex-end;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f6125ee00.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f6125ee00.png?imageMogr2/quality/90"/></section></section></section></section></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw8cno1krl"><section mpa-from-tpl="t" style="margin: 40px 0em 32px;outline: 0px;color: rgb(35, 35, 35);letter-spacing: 0.5px;font-size: 16px;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row nowrap;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;padding-left: 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;outline: 0px;font-size: 17px;line-height: 1.3;text-align: justify;"><p style="margin-right: 0em;margin-left: 0em;outline: 0px;"><span style="font-size: 16px;color: #4499E7;"><strong mpa-from-tpl="t" mpa-is-content="t" style="outline: 0px;"><span leaf="" mpa-is-content="t">问：前几年有一波车企扶持其他电池企业，有些并不太成功。为什么有的做下来了，有的没有取得预想的效果？</span><span leaf=""><br/></span></strong></span></p></section></section></section></section></section></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knrc3l" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">马东辉：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">理想选择合作伙伴，不只是电芯和电池，在任何核心零部件品类上都有一套稳定的原则——TQCD：T是技术能力，Q是质量，C是成本竞争力，D是供应和交付能力。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr210x" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">除了TQCD，我们还非常看重合作伙伴的开放性和协同能力。理想的产品定义、技术方案、质量标准和制造过程，需要与伙伴真正协同。过去在空簧等多个品类上也是如此：当时我们选择的未必是行业规模最大的伙伴，但双方愿意一起攻克技术难题、共同成长，今天孔辉、保隆等伙伴已成为行业中非常优秀的企业。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1lk0" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">选择欣旺达也是基于这样的判断：双方有长期合作基础；我们目前不仅与欣旺达开展电芯自研代工合作，也与中创新航合作。未来如果有头部电池企业足够开放、在TQCD上满足要求，我们同样欢迎。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrsap" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">但开放合作有两个前提：第一，数据一定要打通——哪些环节应当检测、是否有漏检、关键工艺参数有没有发生变化，这些信息我们希望及时掌握，为的是更早发现问题、更早预警，尽可能在出厂前解决问题；第二，产品设计标准和性能要求要能够协同，如果合作伙伴有自己的标准却无法与理想的要求协同，就难以进入我们的合作体系。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr20nm" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">原则只有两点：对所有优秀合作伙伴保持开放；任何品类的合作都要基于TQCD，以及开放、协同。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw8i7l2u0"><section mpa-from-tpl="t" style="margin: 40px 0em 32px;outline: 0px;color: rgb(35, 35, 35);letter-spacing: 0.5px;font-size: 16px;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row nowrap;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;padding-left: 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;outline: 0px;font-size: 17px;line-height: 1.3;text-align: justify;"><p style="margin-right: 0em;margin-left: 0em;outline: 0px;"><span style="font-size: 16px;color: #4499E7;"><strong mpa-from-tpl="t" mpa-is-content="t" style="outline: 0px;"><span leaf="" mpa-is-content="t">问：2025年MEGA经历了电池召回，主动召回一万多台车。这件事对今天自研代工的战略是否有直接推动力？</span><span leaf=""><br/></span></strong></span></p></section></section></section></section></section></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr1u45" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">马东辉：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">2025年MEGA的电池问题，这是理想的责任。我一直强调，用户买的是理想的MEGA，无论电池由哪一家合作伙伴生产制造，最终交付给用户的都是理想的产品，既然用户选择了理想，我们就要对产品最终负责。不管问题来源于哪，首先都是我们作为车企承担责任。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr20yr" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">自研是长期战略，不可能因为去年的事情临时做出决定就能实现今年自研电池上车——我们花了6年时间走到现在。但这件事也让我们更加认识到掌握核心数据的重要性：进一步打通研发、零部件和整车制造以及验证环节的数据，可以帮助我们更早发现问题、降低类似风险。</span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw8pbqs0w"><section mpa-from-tpl="t" style="margin: 40px 0em 32px;outline: 0px;color: rgb(35, 35, 35);letter-spacing: 0.5px;font-size: 16px;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row nowrap;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;padding-left: 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;outline: 0px;font-size: 17px;line-height: 1.3;text-align: justify;"><p style="margin-right: 0em;margin-left: 0em;outline: 0px;"><span style="font-size: 16px;color: #4499E7;"><strong mpa-from-tpl="t" mpa-is-content="t" style="outline: 0px;"><span leaf="" mpa-is-content="t">问：头部电池厂商都在加强To C宣传，理想会不会同步做消费者心智建设？这对短期订单会不会有影响？</span><span leaf=""><br/></span></strong></span></p></section></section></section></section></section></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr7jt" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">刘立国：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">技术处于非常早期阶段时，To C宣传是有价值的；但如果技术已经相对成熟稳定，To C传播对用户本身的价值就有待商榷了。我们认为最终还是要回到用车体验本身。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1o5m" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">对理想来说，不管产品和技术做得再好，市场上也不可避免出现质疑的声音，我们确实还有很多需要提升的地方，所以更希望通过产品和实际体验，把自研真正带来的价值体现出来。而且这里的用户价值，核心不仅仅是电池本身，更重要的是整车体验——我们最终要回答的是：自研这些技术，到底给用户带来了什么样的用车体验和价值提升。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knrran" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">马东辉：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">关于品牌宣传，如果有相应的预算，相比做品牌宣传，我们更希望把预算投入到能真正为用户创造价值的事情上，持续研发，让技术最终通过产品和体验得到验证。关于销量和订单，既然选择了自研代工和自研自制，接下来就是用产品去验证这个选择。我们希望用户看到的是理想整体的产品和技术能力——不光是电池，还有增程器、电驱动、制动、转向等核心技术，因为最终交付给用户的是一整套理想汽车的产品，最终为用户负责的也是理想汽车。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1ow8" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">问：有些车型下单前两天还是宁德时代，后面就是自研的，这之间有明显的销量波动影响吗？</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr156c" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">马东辉：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">这是我们的战略选择，对此非常坚定。比如9月16日上市的理想i9，第一批搭载宁德时代的电池，随着自研电池产能爬坡，后续会是理想自研的电池。从我个人感知，并没有明显的销量波动，反而是有一些用户联系我们，希望排产尽早切换，因为他们想尽早提到搭载自研电池的车。对于不同批次搭载的电池，我们都会对最终的性能、质量和服务负责。</span></span></span></section><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mudw8w1kzi7"><section mpa-from-tpl="t" style="margin: 40px 0em 32px;outline: 0px;color: rgb(35, 35, 35);letter-spacing: 0.5px;font-size: 16px;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row nowrap;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;padding-left: 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(68, 153, 231);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" style="margin-right: 0em;margin-left: 0em;outline: 0px;font-size: 17px;line-height: 1.3;text-align: justify;"><p style="margin-right: 0em;margin-left: 0em;outline: 0px;"><span style="font-size: 16px;color: #4499E7;"><strong mpa-from-tpl="t" mpa-is-content="t" style="outline: 0px;"><span leaf="" mpa-is-content="t">问：自研电池对成本有多少影响？自研的优势什么时候能体现在毛利率改善上？</span><span leaf=""><br/></span></strong></span></p></section></section></section></section></section></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudw0knr3el" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">马东辉：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">工程师的优点就是不回避问题。很多媒体朋友都会有同样的疑问：自研电池的成本是不是比外购更低。</span></span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr117t" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们拆一下：电池成本主要由产线投资的分摊、制费（人力、能耗、生产损耗和合格率）、原材料（正负极材料、隔膜和电解质，占比较高）、仓储物流运输以及研发投入构成，最后是企业需要获得的合理毛利。无论自研自制、自研代工还是外购，成本基本都由这几部分构成。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr41b" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">整体来看，我们并不认为自研的成本比外采低——仅仅是每年的研发投入，就是一笔不小的数字。但自研有没有成本优化空间？我们的机会点绝不是用更便宜的材料，这不符合理想的价值观。机会点主要在以下几方面：</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knryzw" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第一，保证产线利用率。充分利用产线，分摊到每块电池上的成本才能降低。我们可以推进平台化：例如理想i8、i9和MEGA可以采用同一种电芯、在同一条产线上生产。无论某一款产品产量高低，我们关注的是总产量的波动，从而充分利用产线。这不会减少设备投资，但可以提升整体产能利用率。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrrc" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第二，在制造费用上减少浪费和损耗。理想有专门的智能工业团队，打造了理想连山平台，打通生产过程中的每一个环节：除了质量预警，还可以分析瑕疵和不合格品由哪个环节造成，识别后持续改进；团队会深入电芯和PACK生产环节，通过数据分析、人工智能等方式不断提高合格率。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1tta" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第三，在原材料上从被动应对转向主动布局。过去碳酸锂价格上涨，我们的采购价格就联动上涨；未来随着更深度参与电池研发和生产，我们会在上游做布局，通过期货等方式锁定部分大宗商品价格。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knr1t9w" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第四，在仓储、物流和运输上，统一仓储地点、物流方式、包装方案和存储标准，从这些细节里找成本优化的机会。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span leaf="" mpa-font-style="mudw0knrluh" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">关于研发投入：合作伙伴投入的数十亿元研发费用，最终也会转化为成本体现在产品价格中；自己研发计入研发费用，外购则可能体现在BOM成本里，因为供应商的毛利需要覆盖研发投入。两种模式很大程度上是财务科目归类的差异，增程器也是同样的逻辑。</span></span></section><section style="margin-bottom: 24px;line-height: 1.75em;text-align: justify;"><span mpa-font-style="mudvzfpn1fuf" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" mpa-font-style="mudvzy79l13"><span leaf="" mpa-font-style="mudw0knrap0" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">最后回到毛利。无论外购还是自研代工，产业链上的企业都应该获得合理的利润空间，理想同样需要保持健康经营，才能持续为用户提供新的产品价值。</span></span></span></span></section></section></section></section></section><p style="display: none;"><mp-style-type data-value="3"></mp-style-type></p>]]></description>
<category>智能驾驶</category>
<comments>https://www.leiphone.com/category/transportation/KdptMsXu5w9oiUOo.html#comments</comments>
<pubDate>Sat, 10 Oct 2026 16:24:00 +0800</pubDate>
</item>
<item>
<title>新智驾独家丨奇瑞高层人事调整：智能化中心负责人谢保军疑似离职</title>
<link>https://www.leiphone.com/category/transportation/oiSyYkdJBNF6AfVW.html</link>
<description><![CDATA[<section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" data-mpa-action-id="mqyzfe8e1o6q" data-pm-slice="0 0 []" data-nest-level="2"><section data-mpa-template="t" data-nest-level="3"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mqyujg2k1kai" data-pm-slice="0 0 []" data-nest-level="4"><section data-mpa-template="t" mpa-from-tpl="t" data-mpa-action-id="mr1sh6ji1dny" data-pm-slice="0 0 []" data-nest-level="5"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" data-mpa-action-id="mqyyysh4f7z" data-pm-slice="0 0 []" data-nest-level="6"><section data-mpa-template="t" mpa-from-tpl="t" style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;letter-spacing: 0.544px;" data-mpa-action-id="mlf0mwjx1fmf" data-pm-slice="0 0 []" data-nest-level="7"><section data-role="outer" label="Powered by 135editor.com" mpa-from-tpl="t" style="-webkit-tap-highlight-color: transparent;outline: 0px;text-align: center;visibility: visible;" data-nest-level="8"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin-top: 15px;margin-bottom: 5px;-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-nest-level="9"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin-top: 15px;margin-bottom: 15px;-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-nest-level="10"><section mpa-from-tpl="t" style="padding-right: 8px;padding-left: 8px;-webkit-tap-highlight-color: transparent;outline: 0px;line-height: 1.7;visibility: visible;" data-nest-level="11"><section style="text-align: center;" data-mpa-action-id="mtl8j4ty1esv" data-pm-slice="0 0 []" mpa-from-tpl="t" data-nest-level="12" nodeleaf=""><img  class="rich_pages wxw-img" data-aistatus="1" data-croporisrc="https://mmbiz.qpic.cn/mmbiz_png/cCyjje3LibqVbpK7ZJSuFJm6O8PkqbaQus52R6gAdJ9bAaw97IAJnicQM43kicZpWYC5fhPhWmtnRBjsXjwnj7RGUYEk8IT4DcFW2joibObeAQM/0?wx_fmt=png&amp;from=appmsg" data-cropselx2="562" data-cropsely2="482" data-imgfileid="100102723" data-ratio="0.6666666666666666" data-s="300,640" data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f59fe0f1a.jpg" data-type="png" data-w="1266" height="925" style="background-color: transparent;width: 100%;height: auto !important;" width="1079"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f59fe0f1a.jpg?imageMogr2/quality/90"/></section></section></section></section></section><section style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" mpa-from-tpl="t" data-nest-level="8"><section style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" mpa-from-tpl="t" data-nest-level="9"><section data-pm-slice="3 4 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" mpa-from-tpl="t" data-nest-level="10"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mc47wtwy1gqi" data-nest-level="11"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t" data-nest-level="12"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;width: 100%;" data-mid="" mpa-from-tpl="t" data-nest-level="13"><section style="display: flex;justify-content: center;align-items: center;grid-column-gap: 3px;align-self: flex-start;margin-bottom: -8px;background: #fff;padding-right: 6px;z-index: 1;" data-mid="" mpa-from-tpl="t" data-nest-level="14"><section style="width: 6px;height: 14px;background: #23648B;clip-path: polygon(0 0, 100% 0, 80% 100%, 20% 100%);" data-mid="" mpa-from-tpl="t" data-nest-level="15"><span leaf=""><br/></span></section><section style="width: 6px;height: 14px;background: #23648B;clip-path: polygon(0 0, 100% 0, 80% 100%, 20% 100%);" data-mid="" mpa-from-tpl="t" data-nest-level="15"><span leaf=""><br/></span></section></section><section style="border-top: 1px solid #23648B;border-bottom: 1px solid #23648B;width: 100%;padding: 14px 0px;" data-mid="" mpa-from-tpl="t" data-nest-level="14"><section style="background: #F3F3F3;padding: 12px;width: 100%;" data-mid="" mpa-from-tpl="t" data-nest-level="15"><p yb-mpa-mark="mark-style-text" style="font-size: 14px;color: #2C2C2C;line-height: 24px;" data-mid=""><span leaf="">内部飞书状态已显示暂停使用。</span></p></section></section><section style="display: flex;justify-content: center;align-items: center;grid-column-gap: 3px;align-self: flex-end;margin-top: -8px;background: #fff;padding-left: 6px;z-index: 1;" data-mid="" mpa-from-tpl="t" data-nest-level="14"><section style="width: 6px;height: 14px;background: #23648B;clip-path: polygon(0 0, 100% 0, 80% 100%, 20% 100%);" data-mid="" mpa-from-tpl="t" data-nest-level="15"><span leaf=""><br/></span></section><section style="width: 6px;height: 14px;background: #23648B;clip-path: polygon(0 0, 100% 0, 80% 100%, 20% 100%);" data-mid="" mpa-from-tpl="t" data-nest-level="15"><span leaf=""><br/></span></section></section></section></section></section><section data-pm-slice="2 2 []" style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;text-align: right;line-height: 1.6em;" mpa-from-tpl="t" data-nest-level="11"><span leaf="" data-mpa-action-id="mbrtqb4vv6w" style="margin: 0px;padding: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;font-size: 14px;" data-nest-level="12"><br/></span></section><section data-pm-slice="2 2 []" style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;text-align: right;line-height: 1.6em;" mpa-from-tpl="t" data-nest-level="11"><span leaf="" data-mpa-action-id="mbrtqb4vv6w" style="margin: 0px;padding: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;font-size: 14px;" data-nest-level="12"><span textstyle="" style="color: #888888;">作者 | 王瑞昊</span></span></section><section style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;text-align: right;line-height: 1.6em;" mpa-from-tpl="t" data-nest-level="11"><section style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;" mpa-from-tpl="t" data-nest-level="12"><span leaf="" data-mpa-action-id="mbrtqb4v1pug" style="margin: 0px;padding: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;font-size: 14px;" data-nest-level="13"><span textstyle="" style="color: #888888;">编辑 | 李雨晨</span></span></section></section></section></section></section></section></section><p data-pm-slice="0 0 []" data-nest-level="6"><span leaf="" data-nest-level="7"><br/></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;" data-nest-level="6"><span mpa-font-style="mr1sgj1g1h96" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" data-nest-level="7"><span style="letter-spacing: 0.5px;font-size: 15px;" mpa-font-style="mr1sh3ce1sug" data-nest-level="8"><span leaf="" mpa-font-style="mr1sh6j4ztq" style="text-align: justify;line-height: 1.75em;letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" data-nest-level="9"><span textstyle="" style="letter-spacing: 0.5px;">雷峰网《新智</span></span><span leaf="" mpa-font-style="mr1sh6j4ztq" style="font-family: &quot;mp-quote&quot;, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" data-nest-level="9"><span textstyle="" style="letter-spacing: 0.5px;">驾》独家获悉，奇瑞汽车股份有限公司副总裁、智能化中心负责人谢保军疑似已离职，内部飞书状态已显示暂停使用。</span></span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">雷峰网《新智驾》就此事向奇瑞汽车求证，截止发稿未作回应。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">谢保军于2024年10月加入奇瑞，最初任职于旗下大卓智能，主要负责智能驾驶相关研发工作。2025年5月，奇瑞将雄狮科技、大卓智能以及研发总院相关业务整合，成立奇瑞智能化中心，谢保军成为中心实际运营负责人，统筹智能座舱、智能辅助驾驶、数字架构等智能化业务。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">此后，奇瑞进一步推进猎鹰智驾技术方案归一、合作伙伴收敛和全栈自研，并在2026年AI之夜推出猎鹰500、700、900等智驾产品序列以及灵犀智舱、小奇同学等AI能力，谢保军也多次代表奇瑞对外介绍相关进展。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">谢保军此前长期在吉利体系任职。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">2010年前后加入沃尔沃汽车，先后负责软件、电子、自动驾驶、整车电子电气架构及智能网联等研发工作，曾担任沃尔沃研发中心软件与电子高级总监、沃尔沃汽车亚太区研发高级总监等职务。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">随后加入极氪，担任极氪智能科技副总裁、软件及电子中心负责人，核心负责电子电气架构以及相关软硬件平台。2024年10月离开极氪后，谢保军转投奇瑞旗下大卓智能。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><strong><span leaf="" style="text-align: justify;letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">本文作者长期关注自动驾驶和车圈的人与事，欢迎添加微信 jinyuan-0428 交流讨论。</span></span></strong></p></section></section></section></section><p style="display: none;"><mp-style-type data-value="3"></mp-style-type></p>]]></description>
<category>智能驾驶</category>
<comments>https://www.leiphone.com/category/transportation/oiSyYkdJBNF6AfVW.html#comments</comments>
<pubDate>Sat, 10 Oct 2026 16:22:00 +0800</pubDate>
</item>
<item>
<title>零跑朱江明放话第二品牌要做iPhone式产品革命，哪来的自信？</title>
<link>https://www.leiphone.com/category/transportation/2mlyhW6adiiiwwoy.html</link>
<description><![CDATA[<section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" data-mpa-action-id="mqyzfe8e1o6q" data-pm-slice="0 0 []" data-nest-level="2"><section data-mpa-template="t" data-nest-level="3"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mqyujg2k1kai" data-pm-slice="0 0 []" data-nest-level="4"><section data-mpa-template="t" mpa-from-tpl="t" data-mpa-action-id="mr1sh6ji1dny" data-pm-slice="0 0 []" data-nest-level="5"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" data-mpa-action-id="mqyyysh4f7z" data-pm-slice="0 0 []" data-nest-level="6"><section data-mpa-template="t" mpa-from-tpl="t" style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;letter-spacing: 0.544px;" data-mpa-action-id="mlf0mwjx1fmf" data-pm-slice="0 0 []" data-nest-level="7"><section data-role="outer" label="Powered by 135editor.com" mpa-from-tpl="t" style="-webkit-tap-highlight-color: transparent;outline: 0px;text-align: center;visibility: visible;" data-nest-level="8"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin-top: 15px;margin-bottom: 5px;-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-nest-level="9"><section powered-by="xiumi.us" mpa-from-tpl="t" style="margin-top: 15px;margin-bottom: 15px;-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-nest-level="10"><section mpa-from-tpl="t" style="padding-right: 8px;padding-left: 8px;-webkit-tap-highlight-color: transparent;outline: 0px;line-height: 1.7;visibility: visible;" data-nest-level="11"><section style="text-align: center;" data-mpa-action-id="mu6obq5j1gn3" data-pm-slice="0 0 []" mpa-from-tpl="t" data-nest-level="12" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f7cdb76.jpg" class="rich_pages wxw-img" data-ratio="0.66640625" data-s="300,640" data-type="jpeg" data-w="1280" height="920" style="background-color: transparent;width: 100%;height: auto !important;" width="1079" data-croporisrc="https://mmbiz.qpic.cn/sz_mmbiz_jpg/cCyjje3LibqW8FVeuW04PGgaC6biaerhrzlkSXMvzWwO40RKSgB1AoWxVlgkLKEYeaYBgSiaUfrZvqUiadknS1gacpDKIQAsMq6ichzTEzzYaxlI/0?wx_fmt=jpeg&amp;from=appmsg" data-cropselx2="562" data-cropsely2="482" data-imgfileid="100102991" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f7cdb76.jpg?imageMogr2/quality/90"/></section></section></section></section></section><section style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" mpa-from-tpl="t" data-nest-level="8"><section style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" mpa-from-tpl="t" data-nest-level="9"><section data-pm-slice="3 4 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" mpa-from-tpl="t" data-nest-level="10"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mc47wtwy1gqi" data-nest-level="11"><section style="width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;" data-mid="" mpa-from-tpl="t" data-nest-level="12"><section style="display: flex;justify-content: flex-start;align-items: center;flex-direction: column;width: 100%;" data-mid="" mpa-from-tpl="t" data-nest-level="13"><section style="display: flex;justify-content: center;align-items: center;grid-column-gap: 3px;align-self: flex-start;margin-bottom: -8px;background: #fff;padding-right: 6px;z-index: 1;" data-mid="" mpa-from-tpl="t" data-nest-level="14"><section style="width: 6px;height: 14px;background: #23648B;clip-path: polygon(0 0, 100% 0, 80% 100%, 20% 100%);" data-mid="" mpa-from-tpl="t" data-nest-level="15"><span leaf=""><br/></span></section><section style="width: 6px;height: 14px;background: #23648B;clip-path: polygon(0 0, 100% 0, 80% 100%, 20% 100%);" data-mid="" mpa-from-tpl="t" data-nest-level="15"><span leaf=""><br/></span></section></section><section style="border-top: 1px solid #23648B;border-bottom: 1px solid #23648B;width: 100%;padding: 14px 0px;" data-mid="" mpa-from-tpl="t" data-nest-level="14"><section style="background: #F3F3F3;padding: 12px;width: 100%;" data-mid="" mpa-from-tpl="t" data-nest-level="15"><p yb-mpa-mark="mark-style-text" style="font-size: 14px;color: #2C2C2C;line-height: 24px;" data-mid=""><span leaf="">第二品牌新车有一个反常识的指标：得房率超过100%。</span></p></section></section><section style="display: flex;justify-content: center;align-items: center;grid-column-gap: 3px;align-self: flex-end;margin-top: -8px;background: #fff;padding-left: 6px;z-index: 1;" data-mid="" mpa-from-tpl="t" data-nest-level="14"><section style="width: 6px;height: 14px;background: #23648B;clip-path: polygon(0 0, 100% 0, 80% 100%, 20% 100%);" data-mid="" mpa-from-tpl="t" data-nest-level="15"><span leaf=""><br/></span></section><section style="width: 6px;height: 14px;background: #23648B;clip-path: polygon(0 0, 100% 0, 80% 100%, 20% 100%);" data-mid="" mpa-from-tpl="t" data-nest-level="15"><span leaf=""><br/></span></section></section></section></section></section><section data-pm-slice="2 2 []" style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;text-align: right;line-height: 1.6em;" mpa-from-tpl="t" data-nest-level="11"><span leaf="" data-mpa-action-id="mbrtqb4vv6w" style="margin: 0px;padding: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;font-size: 14px;" data-nest-level="12"><br/></span></section><section data-pm-slice="2 2 []" style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;text-align: right;line-height: 1.6em;" mpa-from-tpl="t" data-nest-level="11"><span leaf="" data-mpa-action-id="mbrtqb4vv6w" style="margin: 0px;padding: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;font-size: 14px;" data-nest-level="12"><span textstyle="" style="color: #888888;">作者 | 王瑞昊</span></span></section><section style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;text-align: right;line-height: 1.6em;" mpa-from-tpl="t" data-nest-level="11"><section style="margin: 0px;padding: 0px;display: block;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;" mpa-from-tpl="t" data-nest-level="12"><span leaf="" data-mpa-action-id="mbrtqb4v1pug" style="margin: 0px;padding: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;word-break: normal !important;font-size: 14px;" data-nest-level="13"><span textstyle="" style="color: #888888;">编辑 | 李雨晨</span></span></section></section></section></section></section></section></section><p data-pm-slice="0 0 []" data-nest-level="6"><span leaf="" data-nest-level="7"><br/></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;" data-nest-level="6"><span mpa-font-style="mr1sgj1g1h96" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" data-nest-level="7"><span style="letter-spacing: 0.5px;font-size: 15px;" mpa-font-style="mr1sh3ce1sug" data-nest-level="8"><span leaf="" mpa-font-style="mr1sh6j4ztq" style="text-align: justify;line-height: 1.75em;letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" data-nest-level="9"><span textstyle="" style="letter-spacing: 0.5px;">雷峰网了解到，2015年零跑成立的时候，团队一共50个人，其中41个是工程师。</span></span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">十一年过去，那41个人里还有21个留在公司。今天的零跑有1万名员工，8500个在做研发，销售、人力、财务、公关全部加起来，只有1500人。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">2026年8月，零跑全球交付103,129辆，上半年归母净利润2.1亿元，手里有18座零部件工厂，整车成本的65%由自己掌握。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">9月16日这场技术日，零跑给了一个主题词：底气。当天晚上发的东西很多，朱江明自己总结起来是“1加3”：一套面向第二品牌的全新架构，加上智驾、电池、电驱三个领域的重磅技术。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">底气是个很难自证的词。零跑的答案，是三个方向：一个新品牌、一套新智驾、一门外供生意。</span></span></p><section nodeleaf="" data-mpa-action-id="mu6p4lppgqx" data-pm-slice="0 0 []" style="margin-bottom: 0px;"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f8033a3.jpg" class="rich_pages wxw-img" data-ratio="0.6666103983794733" data-type="jpeg" data-w="5924" style="background-color: transparent;width: 100%;border-radius: 30px;" data-width="5924" data-height="3949" data-backw="578" data-backh="385" data-imgfileid="100103012" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f8033a3.jpg?imageMogr2/quality/90"/></section><p style="text-align: center;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 12px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" mpa-font-style="mu6q0fin11h7" data-mpa-action-id="mu6q0fiu28v" data-pm-slice="0 0 []"><span textstyle="" style="letter-spacing: 0.5px;color: #888888;">零跑核心高管，从左到右依次是：电驱线负责人巫存，电子线负责人周洪涛，创始人朱江明，整车产品负责人曹力，电池线负责人宋忆宁，副总裁周颖</span></span></p><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mu6pa2l61o8o"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mce8ut5v1r0s" data-pm-slice="0 0 []"><section style="display: flex;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section style="display: flex;flex-direction: column;align-self: center;" data-mid="" mpa-from-tpl="t"><section style="" data-mid="" mpa-from-tpl="t"><p style="font-weight: bold;font-size: 12px;color: rgb(53, 125, 186);line-height: 15px;word-break: break-word;text-align: center;" data-mid=""><span leaf="" mpa-font-style="mbrs0ibk1ngb" style="font-size: 20px;" data-mpa-action-id="mbrs0ibwh57" data-pm-slice="0 0 []" mpa-is-content="t">PART 1</span><span leaf=""><br/></span></p></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;z-index: 1;margin: 0 0 -9px -1px;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f821507.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f821507.png?imageMogr2/quality/90"/></section><section style="align-self: flex-start;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mbrrx76d4ei" data-pm-slice="0 0 []"><section style="display: flex;align-items: flex-start;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;background: rgb(255, 255, 255);height: 6px;" data-mid="" mpa-from-tpl="t"><span leaf="" data-mpa-action-id="mbrrx75dfbf" style="font-size: 28px;"><br/></span></section></section><section style="background: rgb(255, 255, 255);text-align: center;padding: 3px 14px 8px;font-size: 12px;" data-mid="" mpa-from-tpl="t" mpa-font-style="mbrry8gb6us" data-mpa-action-id="mbrry8hb219o" data-pm-slice="0 0 []"><section style="padding: 0px 5px;border-bottom: 7px solid rgb(53, 125, 186);margin-bottom: 0px;text-align: center;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mocw37w6swn" data-pm-slice="0 0 []"><p style="margin-top: 0px;margin-right: 0px;margin-left: 0px;font-weight: bold;color: rgb(34, 34, 34);line-height: 17px;word-break: break-word;" data-mid="" yb-mpa-mark="mark-style-text"><span leaf=""><br/></span></p><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vrbsw"><span leaf="" mpa-is-content="t">第二品牌要</span></span></span><h2 style="margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;"><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vr1oql"><span leaf="" mpa-is-content="t">做一次iPhone式革命</span></span></span><strong mpa-from-tpl="t"><span leaf=""><br/></span></strong></h2></section></section></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;margin: -10px -4px 0 0;align-self: flex-end;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f842de7.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f842de7.png?imageMogr2/quality/90"/></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;margin-top: 24px;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">零跑要发布第二个品牌。在正式亮相之前，朱江明给它的定位不是多一条产品线，而是一场替代。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">“我们要做汽车行业的苹果。”</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">朱江明的逻辑是这样的：新能源汽车发展到现在，从外面看，你分不清这是一辆燃油车还是一辆电动车，因为外观是一样的；拉开车门，里面还是五个座位、六个座位、七个座位，功能区没有任何改变。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">“这个就像原来的功能手机，它就那么几个单调的功能。”</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">苹果当年做了什么？iPhone从多功能化开始，把手机彻底重做了一遍。朱江明举了个很具体的例子：以前出门旅游要带一堆东西：单反相机、MP3，为了办公发邮件还得背一台电脑，iPhone把这些全整合进了一个东西里。“这个就是他的创新性的革命”。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">朱江明告诉雷峰网，车也到了这个节点。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">动力系统的替代已经基本完成，接下来是智能驾驶越来越好用，接管次数越来越少。零跑给自己定的目标，是年底在城区实现100公里无接管。当开车这件事本身变得轻松，人在车里的时间就可以拿来做别的事，周末的活动半径和方式都会变。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">用他的话说，“势必在这个车里面，开车更轻松了，周末的活动就更丰富了，所以这个车的形态就跟原来做了很多改变。”</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">所以第二品牌的产品，“确实要像iPhone替代传统功能手机一样，做革命性的变化”。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">具体到工程上，这场革命的第一步是把座舱做大。零跑给了一个很反常识的指标：得房率超过100%。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">传统汽车的空间是围绕驾驶设计的。发动机占着前舱，传动轴穿过座舱，两个减振塔像犄角一样凸进来。这些燃油时代的布局惯性，导致车看着不小、能用的地方却不大。大多数车企的做法是在既定布局里一点一点抠空间，零跑的选择是从零重构，沿长、宽、高三个方向同时做。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">要长度：行业首发的超级集成空调一体机加上动力总成后置。空调零件数量减少18%、纵向占用空间减少34%、管路减少30%、运行噪声降低3dB，腾出来的地方加上后置的动力总成不再侵占座舱，最终座舱纵向长度约4400毫米，比同级多出约700毫米，舱内长度空间提升19%。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">要宽度：减振器直立布局配铝压铸一体化小型塔包，减振器外旋8.3度，把“犄角”收了回去。前排横向宽度做到约1100毫米，腿部宽度空间提升37.5%。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">要高度：下面用纯平低地板把地板降低约70毫米，上面用原生一体化智能升顶棚向上拓展约800毫米。一降一升，舱内高度提升63.7%，人在车里可以直立，形成一个Loft。</span></span></p><section nodeleaf="" data-mpa-action-id="mu6p5hzs1hz6" data-pm-slice="0 0 []" style="margin-bottom: 24px;"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f8701d7.jpg" class="rich_pages wxw-img" data-ratio="0.325" data-type="jpeg" data-w="1280" style="background-color: transparent;width: 100%;border-radius: 30px;" data-width="7680" data-height="2496" data-backw="578" data-backh="188" data-imgfileid="100102996" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f8701d7.jpg?imageMogr2/quality/90"/></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">空调一体机这件事，朱江明在沟通会里讲了背后的思路，比参数更说明问题。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">他说，这跟家用空调的演化是一个道理。以前的窗机没什么管子，一个模块就把全功能实现了，按在墙上、外部连在一起推到外面去，里面的空间就大了。而打开现在汽车的前机舱，压缩机、冷凝器、蒸发器加一堆管路，很散，“我们以终为始的话，可以把汽车的空调彻底地进行革命”。他的总结是，一切创新都是从需求出发，为了让出空间。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">“具体包括我们的内部还有很多创新，我想给大家留一个悬念，等我们第二品牌发布的时候，大家可以看到，我们确实是一个移动空间，是一个完全的新物种。”</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">空间之外是电子层面的重构。四叶草5.0做了真正的中央集成控制，过去每个域控制器各自决策，现在只有一个中央域控做决策，其他域控只负责执行，整车线束压到500米以内。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">全车48V供电给智能化时代修了一条电力高速公路，线束减重50%；全车以太网用统一的语言让所有部件直接对话，还采用了非对称方案，下行10G大流量、上行100M小流量，一根线同时跑视频和控制数据；车云AgentOS则把复杂推理和长期记忆放在云端，车端留核心Agent保低时延和隐私。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">能量管理也被重做了一遍：热管理零部件从69个减到21个，纵向空间占用从580毫米压到310毫米，管路从6.2米缩到3.3米；首创的14通阀打通制冷与制热回路，支持48种切换模式和54种能量交互模式，冬季制热功率18kW，领先行业20%。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">用这套架构做的第二品牌新车，按目前的计划将在明年第四季度亮相并开始交付。</span></span></p><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mu6p9ge71glc"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mce8ut5v1r0s" data-pm-slice="0 0 []"><section style="display: flex;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section style="display: flex;flex-direction: column;align-self: center;" data-mid="" mpa-from-tpl="t"><section style="" data-mid="" mpa-from-tpl="t"><p style="font-weight: bold;font-size: 12px;color: rgb(53, 125, 186);line-height: 15px;word-break: break-word;text-align: center;" data-mid=""><span leaf="" mpa-font-style="mbrs0ibk1ngb" style="font-size: 20px;" data-mpa-action-id="mbrs0ibwh57" data-pm-slice="0 0 []" mpa-is-content="t">PART 2</span><span leaf=""><br/></span></p></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;z-index: 1;margin: 0 0 -9px -1px;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f88f4a5.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f88f4a5.png?imageMogr2/quality/90"/></section><section style="align-self: flex-start;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mbrrx76d4ei" data-pm-slice="0 0 []"><section style="display: flex;align-items: flex-start;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;background: rgb(255, 255, 255);height: 6px;" data-mid="" mpa-from-tpl="t"><span leaf="" data-mpa-action-id="mbrrx75dfbf" style="font-size: 28px;"><br/></span></section></section><section style="background: rgb(255, 255, 255);text-align: center;padding: 3px 14px 8px;font-size: 12px;" data-mid="" mpa-from-tpl="t" mpa-font-style="mbrry8gb6us" data-mpa-action-id="mbrry8hb219o" data-pm-slice="0 0 []"><section style="padding: 0px 5px;border-bottom: 7px solid rgb(53, 125, 186);margin-bottom: 0px;text-align: center;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mocw37w6swn" data-pm-slice="0 0 []"><p style="margin-top: 0px;margin-right: 0px;margin-left: 0px;font-weight: bold;color: rgb(34, 34, 34);line-height: 17px;word-break: break-word;" data-mid="" yb-mpa-mark="mark-style-text"><span leaf=""><br/></span></p><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vrbsw"><span leaf="" mpa-is-content="t">零跑智驾之前没什么存在感</span></span></span><h2 style="margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;"><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vr1oql"><span leaf="" mpa-is-content="t">怎么一下进了第一梯队</span></span></span><strong mpa-from-tpl="t"><span leaf=""><br/></span></strong></h2></section></section></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;margin: -10px -4px 0 0;align-self: flex-end;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f8ac6e2.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f8ac6e2.png?imageMogr2/quality/90"/></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;margin-top: 24px;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">过去几年，如果有人列一份国内智能驾驶第一梯队的名单，里面大概率不会有零跑。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">这家公司在智驾上的策略，一直是在控制整体资源投入的前提下坚持全域自研，从最早自研感知硬件、自研智驾芯片，到自研软件算法。中间遇到过巨大的挑战，但即便在最困难的时候，零跑也没有放弃自研算法。代价就是，它在很长一段时间里是缺席主流讨论的。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">变化发生在最近一年。2025年9月，零跑认准了世界模型这条路线；2026年3月，跑通了世界模型智驾的DEMO版本；到现在，实车已经被媒体和用户提前做了一镜到底的测试，效果达到行业第一梯队，实现了弯道超车。从选定路线到站上来，不到一年。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">它是怎么做到的？</span></span></p><section nodeleaf="" data-mpa-action-id="mu6p605y1gx" data-pm-slice="0 0 []" style="margin-bottom: 24px;"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f8d2196.jpg" class="rich_pages wxw-img" data-ratio="0.5625" data-type="jpeg" data-w="1280" style="background-color: transparent;width: 100%;border-radius: 30px;" data-width="4032" data-height="2268" data-backw="578" data-backh="325" data-imgfileid="100102993" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f8d2196.jpg?imageMogr2/quality/90"/></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">首先是技术路线的选择：不靠BEV感知，不依赖规则代码，激光雷达只作为安全冗余。云端有一个基座世界模型，用大数据量训练，让模型具备理解世界、推理生成世界的能力，像一个持续进化的知识库；车端有一个实时世界模型，复用云端能力，结合导航和车辆实时状态做实时决策，能在200TOPS、640TOPS、1280TOPS等不同算力等级上部署。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">其次是架构创新带来的效率。从第一性原理出发重构模型架构：保持图像视角表征，省掉BEV转换那部分算力；设计记忆存储模块，让模型能记住历史；把惯性与实时理解解耦，让驾驶更平顺。规则只用来给红绿灯这类交通法规兜底，代码量因此减少90%。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">此外，是车队级的协同学习。一辆车遇到了复杂路况学会了怎么处理，其他车通过云端也能学会。这一条解决了智驾行业长尾场景落地难的老问题，单个车队跑不到的场景，规模可以。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">在零跑智驾负责人周洪涛看来，做到这些的关键不是钱和人。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">“首先我并不太认可智驾需要去砸钱堆人才能做的这个说法，绝大部分友商在智驾上，比如说之前投入几千个人的，现在都在大幅度的缩减。很多时候这个事情并不是砸钱砸人就能做得出来的。”</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">他接着讲了去年年底给团队提要求时的一个场景：他说希望每个人能像孙悟空一样，拔一根头发出来就变一个分身做事。底下有个发量比较小的小伙伴回答说，放心，我们马上又能帅起来。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">“我们是一个永不放弃的团队，我觉得这是我们能把这套系统做出来的根本原因。”</span></span></p><section nodeleaf="" data-mpa-action-id="mu6p6hg91spm" data-pm-slice="0 0 []" style="margin-bottom: 24px;text-align: center;"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f91de33.jpg" class="rich_pages wxw-img" data-ratio="0.6666666666666666" data-type="jpeg" data-w="4320" style="background-color: transparent;width: 100%;border-radius: 30px;" data-width="4320" data-height="2880" data-backw="578" data-backh="385" data-imgfileid="100103006" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f91de33.jpg?imageMogr2/quality/90"/></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">朱江明在旁边补了一句关于参照系的话。他说，跟特斯拉比没有可比性，因为中国的车不能去美国，FSD也不太能在中国落地，“这里就无解了，怎么说都可以，都没法比”。但他认为中国的开车环境是最难的：外卖小哥没中国这么多，串来串去；美国的规则更讲究，道路分得很清楚，从小镇出发上高速，到达城市，路况完全不一样。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">所以在他看来，中国这些智驾团队都很努力，而且越做越好，越来越接近一周不要接管、甚至半个月不要接管；将来真正的无人驾驶，一定是逐步逼近最终的一个状态：L4的状态，但还是有一个过程。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">技术之外，零跑把这套东西的门槛压得很低：多个算力平台、10万元以内的车型也能搭载。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">截至8月底已交付30多万辆带激光雷达和高阶智驾芯片的车型，零跑承诺为这些用户免费升级到最新的世界模型版本，而且终身免费使用。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">其中最早期那一万多台因为硬件平台不一致，算法移植重构至少要花5000万元，零跑的决定是照样满足。理由很朴素：用户当时是冲着高阶智驾买的车。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">同一套判断逻辑，也体现在零跑对更新的技术，比如具身智能的态度上。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">零跑其实已经做出了完全自研的机器人，这款机器人需要的电机、控制器、电池、感知算法、计算平台，零跑自己在车上全部已经做了十年。但朱江明对这件事相当克制，甚至有点泼冷水。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">他把现在的机器人比作人的年龄：“基本上是在预研阶段，至少能跑，这个也就一两岁。可能五六岁的时候是可以跑个步的水平，但你要工作，要20岁，还有好多要成长。”</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">所以零跑不会在近期把人形作为重点，而是去关注那些好的自动化场景，用现在的AI技术和自己已有的技术，做出第二个增长曲线。用发布会上的那句话概括就是：能遛一遛的机器人不算本事，能赚钱的机器人才拿得出手。</span></span></p><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mu6paxdb42q"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mce8ut5v1r0s" data-pm-slice="0 0 []"><section style="display: flex;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section style="display: flex;flex-direction: column;align-self: center;" data-mid="" mpa-from-tpl="t"><section style="" data-mid="" mpa-from-tpl="t"><p style="font-weight: bold;font-size: 12px;color: rgb(53, 125, 186);line-height: 15px;word-break: break-word;text-align: center;" data-mid=""><span leaf="" mpa-font-style="mbrs0ibk1ngb" style="font-size: 20px;" data-mpa-action-id="mbrs0ibwh57" data-pm-slice="0 0 []" mpa-is-content="t">PART 3</span><span leaf=""><br/></span></p></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;z-index: 1;margin: 0 0 -9px -1px;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f93efec.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f93efec.png?imageMogr2/quality/90"/></section><section style="align-self: flex-start;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mbrrx76d4ei" data-pm-slice="0 0 []"><section style="display: flex;align-items: flex-start;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;background: rgb(255, 255, 255);height: 6px;" data-mid="" mpa-from-tpl="t"><span leaf="" data-mpa-action-id="mbrrx75dfbf" style="font-size: 28px;"><br/></span></section></section><section style="background: rgb(255, 255, 255);text-align: center;padding: 3px 14px 8px;font-size: 12px;" data-mid="" mpa-from-tpl="t" mpa-font-style="mbrry8gb6us" data-mpa-action-id="mbrry8hb219o" data-pm-slice="0 0 []"><section style="padding: 0px 5px;border-bottom: 7px solid rgb(53, 125, 186);margin-bottom: 0px;text-align: center;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mocw37w6swn" data-pm-slice="0 0 []"><p style="margin-top: 0px;margin-right: 0px;margin-left: 0px;font-weight: bold;color: rgb(34, 34, 34);line-height: 17px;word-break: break-word;" data-mid="" yb-mpa-mark="mark-style-text"><span leaf=""><br/></span></p><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vrbsw"><span leaf="" mpa-is-content="t">同行为什么开始</span></span></span><h2 style="margin-top: 0px;margin-bottom: 0px;line-height: 1.75em;text-align: center;"><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vr1oql"><span leaf="" mpa-is-content="t">掏钱买零跑的技术</span></span></span><strong mpa-from-tpl="t"><span leaf=""><br/></span></strong></h2></section></section></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;margin: -10px -4px 0 0;align-self: flex-end;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f95ee67.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f95ee67.png?imageMogr2/quality/90"/></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;margin-top: 24px;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">技术日上还有一组数字很招人注意：零跑的技术已经开始卖给别人了。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">整车级技术赋能一汽、Stellantis集团；电子产品线有5家对外合作，电池系统10家，电驱及电力电子部件已获8家主机厂定点。朱江明说，技术外供已经成为企业的第二增长曲线。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">同行凭什么买？</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">首先，是因为零跑真的把零件做了一遍。朱江明说，在自研自制这方面，零跑跟比亚迪很像，“我们几乎就是把电子的零部件全部做了一遍”，包括整套热管理系统，连里面的压缩机也自己做。昨天大家看到的空调一体机，就是一次彻底的重构。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">这件事从公司成立第一天就设定了模式，十年没变：全域自研、深度自制。起步早的部分，比如电驱、电池、电子电气架构，现在都领先了；后来的电源和电力电子相关，也全部自己做，而且做得很深。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">此外，是因为有一条硬门槛。在零跑，自己研发制造的核心零部件，PPM和3mis一定要优于供应商，才允许投放市场。朱江明说得不含糊：首先要保证自研零部件的品质是更好的，然后才是成本更优，才可以面向市场。顺序不能反过来。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">还有，是算得过来的账。零跑算过一笔：如果合作伙伴选择这套成套件：电池包、电驱、所有控制器、车灯打包式输出，比起自己去选一堆供应商，至少有一千到两千元的成本优势。除了便宜，还有两个好处：速度快，互相匹配的磨合时间短；风险小。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">交付方式有两种：一种是在零跑自己的工厂生产，这是已经跟一汽完成并量产的模式；另一种是在对方自己的工厂生产，零跑提供的是自己研发和制造的核心零部件。朱江明的判断是，“我们认为这种合作是最快的，而且规模也会做起来”，同时要保证合作伙伴的产品有绝对的竞争力。</span></span></p><section nodeleaf="" data-mpa-action-id="mu6p7dodjf3" data-pm-slice="0 0 []" style="margin-bottom: 24px;"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f9850d7.jpg" class="rich_pages wxw-img" data-ratio="0.66640625" data-type="jpeg" data-w="1280" style="background-color: transparent;border-radius: 30px;width: 100%;" data-width="5304" data-height="3536" data-backw="578" data-backh="385" data-imgfileid="100103003" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f9850d7.jpg?imageMogr2/quality/90"/></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">还有一个重要原因，是组织方式。零跑内部四条产品线，整车、电子、电池、电驱，是相互独立的，每条线端到端负责：从产品规划、立项、开发到交付，一个人一块，边界很清晰。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">曹力负责整车，就是把整车这一摊端到端拉通，产品有没有竞争力、质量是不是比竞品好，都由这一摊负责。座舱和电气架构也一样，从每一代的迭代到制造再到交付，甚至把零部件拉到整车工厂线边的位置，都是这条线的职责。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">但独立不等于割裂。朱江明强调，在协同研发的时候它们是一个整体：“在整车这里，电子部分的工程师一个也没有，都是我们组合成的每一个项目的团队。”一个整车项目组成一个团队，别的整车厂内部有不同专业、零部件作为辅助，零跑的协同在他看是最好的。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">这种组织形态也解释了零跑的一个反常识现象：整车和电子各有3000人的团队，电驱和电池也都有一千多人，而且这四个负责人全部是2015年加入零跑的，从一两个人开始，一代又一代迭代到现在。稳定，本身就是能力的一部分。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">另一个原因，是零跑对供应链的理解。朱江明说，中国的供应链可以学苹果，也可以学三星。苹果自己没有工厂，但所有订单的材料、零部件全部由自己定完，摄像头模组、电池、屏幕都定完，连组装代工也定完，“他这个是终极模式”。三星是全产业链，屏幕自己的、存储自己的、SOC也是自己的，做到了全球第一。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">零跑的策略介于两者之间：一部分自制，一部分外供，不同零部件采用不同的方式。因为在汽车这种低毛利行业里，百分百自制也就意味着没法削波填谷，产能的波动自己不可控。朱江明的说法是，“我们需要吸收人家有优势的东西为我所用，那我就可以成就比他更伟大的公司。”</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">当然还有一个不容忽视的原因，是地理位置。零跑把整车厂集中在浙江的两个地方，运输成本高的零部件必须布置在5公里到10公里的范围内。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">这个想法来自造车之前朱江明去丰田的那次精益生产考察：丰田在日本的所有配套零部件和整车工厂都放在丰田市，物流最近，淡旺季可以把别人的工人挪过来平衡产量，供应商也在周边，“它的供应链距离最短，成本最低”。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">浙江正好具备这个条件：这里是IT公司愿意来的地方，因为这里有人才。“天时地利人和，我认为我们的浙江都非常好。”</span></span></p><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mu6pbjfp10h4"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mce8ut5v1r0s" data-pm-slice="0 0 []"><section style="display: flex;flex-direction: column;" data-mid="" mpa-from-tpl="t"><section style="display: flex;flex-direction: column;align-self: center;" data-mid="" mpa-from-tpl="t"><section style="" data-mid="" mpa-from-tpl="t"><p style="font-weight: bold;font-size: 12px;color: rgb(53, 125, 186);line-height: 15px;word-break: break-word;text-align: center;" data-mid=""><span leaf="" mpa-font-style="mbrs0ibk1ngb" style="font-size: 20px;" data-mpa-action-id="mbrs0ibwh57" data-pm-slice="0 0 []" mpa-is-content="t">PART 4</span><span leaf=""><br/></span></p></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;z-index: 1;margin: 0 0 -9px -1px;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f9a8406.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f9a8406.png?imageMogr2/quality/90"/></section><section style="align-self: flex-start;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mbrrx76d4ei" data-pm-slice="0 0 []"><section style="display: flex;align-items: flex-start;" data-mid="" mpa-from-tpl="t"><section style="width: 100%;background: rgb(255, 255, 255);height: 6px;" data-mid="" mpa-from-tpl="t"><span leaf="" data-mpa-action-id="mbrrx75dfbf" style="font-size: 28px;"><br/></span></section></section><section style="background: rgb(255, 255, 255);text-align: center;padding: 3px 14px 8px;font-size: 12px;" data-mid="" mpa-from-tpl="t" mpa-font-style="mbrry8gb6us" data-mpa-action-id="mbrry8hb219o" data-pm-slice="0 0 []"><section style="padding: 0px 5px;border-bottom: 7px solid rgb(53, 125, 186);margin-bottom: 0px;" data-mid="" mpa-from-tpl="t" data-mpa-action-id="mocw37w6swn" data-pm-slice="0 0 []"><p style="margin-top: 0px;margin-right: 0px;margin-left: 0px;font-weight: bold;color: rgb(34, 34, 34);line-height: 17px;word-break: break-word;text-align: center;" data-mid="" yb-mpa-mark="mark-style-text"><span leaf=""><br/></span></p><span mpa-font-style="mocvtjufmjv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span style="letter-spacing: 0.5px;font-weight: bold;font-size: 20px;" mpa-font-style="mocw37vrbsw"><span leaf="" mpa-is-content="t">&nbsp;写在最后&nbsp;</span></span></span></section></section></section><section style="width: 14px;height: 13px;display: flex;justify-content: center;align-items: center;margin: -10px -4px 0 0;align-self: flex-end;" data-mid="" mpa-from-tpl="t" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f9c7e1e.png" class="rich_pages wxw-img" data-ratio="0.9285714285714286" data-w="28" style="background-color: transparent;" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f4f9c7e1e.png?imageMogr2/quality/90"/></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;margin-top: 24px;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">所有这些安排，最后都要回答一个问题：增长从哪来。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">朱江明每天都在想这个。“每一年我们都在想我们的增长来自哪里。实际上今年整个中国汽车行业降了20%。”他说，新能源1到8月份降了6%，没有增长，是负增长，这确实给所有人很大的挑战。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">零跑比较幸运的地方在于去年就想清楚了，今年的增量来自扩充产品线：A系列和D系列，从6.58万元开始一路覆盖到30万元，今年在售的十款车里有四款是今年发布的，填补了很多原来没有覆盖的价格带。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">下一个增长点也已经排好：明年第四季度第二品牌亮相并开始交付；海外市场因为产品发布节奏比国内慢大概两个季度，A10刚发布、A05还没上市，新品的海外放量会成为明年的另一块增量。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">他还补了一句关于心态的话：要居安思危，“所有事情不可能一帆风顺，不可能都很理想，一定会有各种困难要去克服”。做法是把困难想得更多一些，看竞争对手、看宏观、看自己，也只有把困难想到前面，才能在遇到困难的时候不至于那么焦虑。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" style="letter-spacing: 0.5px;font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">“虽然说没有百分百，但至少我们还是希望每年都有比较良性的增长。”</span></span></p></section></section></section></section><p style="display: none;"><mp-style-type data-value="3"></mp-style-type></p>]]></description>
<category>智能驾驶</category>
<comments>https://www.leiphone.com/category/transportation/2mlyhW6adiiiwwoy.html#comments</comments>
<pubDate>Sat, 10 Oct 2026 16:20:00 +0800</pubDate>
</item>
<item>
<title>对话蔚来创始人李斌：蔚来单车均价比奥迪贵18万，比宝马贵七八万，比奔驰贵数万</title>
<link>https://www.leiphone.com/category/transportation/AZ0KUba2gFI5kSB4.html</link>
<description><![CDATA[<section data-mpa-powered-by="yiban.io" data-pm-slice="0 0 []" style="-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: &quot;PingFang SC&quot;, system-ui, -apple-system, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;"><section style="-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;"><section style="-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;"><section style="-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;" data-mpa-action-id="mtr489ll10w4" data-pm-slice="0 0 []"><section style="text-align: center;" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f37be33d1.png" class="rich_pages wxw-img js_insertlocalimg" data-ratio="0.18" data-s="300,640" data-type="png" data-w="1000" style="width: 100%;background-color: transparent;" type="block" data-backw="578" data-backh="104" data-imgfileid="504268953" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f37be33d1.png?imageMogr2/quality/90"/></section><section data-mpa-template="t" mpa-from-tpl="t" style="-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;letter-spacing: 0.544px;visibility: visible;" data-pm-slice="0 0 []"><section mpa-from-tpl="t" style="-webkit-tap-highlight-color: transparent;margin: 0px 0px -10px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgb(34, 34, 34);letter-spacing: 0px;text-align: right;line-height: 25.6px;visibility: visible;"></section></section><p data-pm-slice="0 0 []"><span leaf=""><br/></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krlwp" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">李斌最近提出了一个反共识：在汽车行业，过去大家都认为，量上去了，成本自然就会下来。但现在反过来了，量上去了，成本反而也可能上去了。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krnkr" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">李斌叫这个现象为“规模不经济”，背后的原因，是AI行业现处于不计成本投入的阶段，对内存等资源需求庞大，导致汽车企业的需求一旦起来，就会直接与AIDC（人工智能数据中心）行业形成资源竞争。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr14iw" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">“你要得少一点，人家还可以给你打折；你要得多了，对不起，价格反而上去了。”李斌告诉雷峰网，“这个很有意思。”</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr19ac" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">蔚来也未能独善其身。第二季度，蔚来单台成本较去年底上涨了1.4万元，按当季销量计算，一个季度相当于凭空多出约15亿元成本。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr9gn" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">李斌预计下半年成本仍将继续上涨，在现有基础上还可能增加两三千元。“这些都是没有谈判空间的，我们完全无法谈判。”李斌说。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krwib" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">更有意思的是，在如此严峻的成本环境下，蔚来交出了一份反常识财报：上半年累计交付19.11万辆，同比增长67.4%；实现营收576.7亿元，同比增长85.8%；毛利总额107.7亿元，同比增长282.2%；综合毛利率达到18.7%，同比提升约10个百分点。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr1u17" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">营收增速跑赢了销量，毛利增速又跑赢了营收。与此同时，蔚来二季度经营利润为2.07亿元，连续第三个季度盈利。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr1mfj" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">蔚来也跑赢了行业，根据乘联会数据，今年上半年乘用车零售量同比下降20.2%，整车制造利润率只有约1.5%，同比近乎腰斩，按单车均价20.2万元折算，单车净利润不足3000元。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr170q" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">不过，也有人提出质疑，蔚来连续三个季度经营利润转正采用的是Non-GAAP口径，其中剔除了股权激励等非现金项目。因此这个利润数字是否足够“硬”，仍然存在讨论空间。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr1uq4" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">对此，李斌表示，判断一家公司的经营质量，更应该看经营利润，而不是被利息、投资收益等非经营因素干扰的GAAP净利润。比如蔚来对长鑫等项目的投资，确实会改善GAAP利润，但这不能代表汽车主业本身的经营能力。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr6jd" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">核心在于，蔚来能否持续把技术创新、产品研发和服务体系转化为经营利润，这才是企业实现健康、可持续发展的基础。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr7ba" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">“去年大家讨论的是，蔚来能不能盈利？我们盈利了。然后又讨论能不能持续盈利？我们也持续盈利了。现在大家又在问，到底应该怎么看蔚来。”</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr8aw" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">李斌说，无论外界如何评价蔚来，蔚来内部还是比较笃定的。在经历前两个阶段后，蔚来已经进入了以经营质量和可持续盈利能力为核心的第三阶段。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krbx6" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">能直观反映经营质量的是，2026年二季度，蔚来平均成交价达到40.6万元，7月进一步提升至43.46万元，已全面超越BBA，比奥迪高出约18万元，较宝马高出约七八万元，较奔驰高出数万元。李斌认为，这意味着用户越来越认可蔚来这个品牌。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krd6" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">蔚来联合创始人、总裁秦力洪补充了一个数据：目前品牌因素在蔚来用户购车决策中的占比已经超过30%，位居第二，李斌预计明年品牌因素会上升到第一。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr1g9y" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">单车均价反映的是蔚来经营质量的上限，而以效率为主的体系能力保的是可持续盈利的下限。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr13ms" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">自去年开始，蔚来围绕用户价值创造，建立全员经营CBU机制，并将AI进一步融入经营管理，让组织从花钱做业务转向更精细地计算投入产出。这种变化已经开始体现在经营结果上。过去一些做得并不够好的环节，如今通过CBU机制逐步得到改善，经营效率持续提升。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr1ios" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">对蔚来而言，如果千亿元规模的销售额能够通过5%的效率提升转化为50亿元经营成果，这意味着体系能力正在真正转化为利润，而非停留在组织变革层面。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr1yrg" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">行业趋势也正在验证蔚来的选择。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr1rod" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">纯电渗透率7月达到44.3%，是增程加插混的1.5倍；在NEV内部，纯电占比已达到68%，是插混加增程的两倍；与此同时，大型SUV纯电渗透率超过40%，连续6个月销量登顶。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krqu8" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">只做纯电的蔚来，增长顺势而为。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krjkf" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">9月3日，蔚来发布财报后的第三天，李斌与秦力洪在蔚来上海总部的一间会议室里，和包括雷峰网在内的小范围媒体进行了长达三个小时的交流，以下为经编辑后的对话实录：</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section data-mpa-template="t" mpa-from-tpl="t" style="margin-bottom: 24px;outline: 0px;color: rgba(0, 0, 0, 0.9);font-size: 17px;letter-spacing: 0.544px;text-align: justify;"><section data-mpa-template="t" mpa-from-tpl="t" style="outline: 0px;"><section data-role="paragraph" mpa-from-tpl="t" style="outline: 0px;"><section data-role="title" data-tools="135编辑器" data-id="94063" mpa-from-tpl="t" style="outline: 0px;"><section hm_fix="374:463" mpa-from-tpl="t" style="padding-top: 10px;padding-bottom: 10px;outline: 0px;text-align: center;"><section mpa-from-tpl="t" style="outline: 0px;display: inline-block;"><section data-bgless="spin" data-bglessp="280" mpa-from-tpl="t" style="margin-bottom: -22px;outline: 0px;height: 8px;background: rgb(238, 92, 47);border-radius: 6px;overflow: hidden;"><span leaf=""><br/></span></section><section mpa-from-tpl="t" style="margin-right: auto;margin-left: auto;padding-right: 10px;padding-left: 10px;outline: 0px;display: inline-block;height: 35px;color: rgb(63, 63, 63);line-height: 35px;font-size: 30px;transform: rotate(0deg);"><strong mpa-from-tpl="t" style="outline: 0px;" mpa-is-content="t"><span leaf="">01</span><span leaf=""><br/></span></strong></section></section></section><h4 style="outline: 0px;font-weight: 400;font-size: 16px;text-align: center;visibility: visible;letter-spacing: 0.544px;line-height: 1.6em;"><strong mpa-from-tpl="t" style="outline: 0px;visibility: visible;"><span style="outline: 0px;color: #EE5B2E;visibility: visible;" mpa-is-content="t"><span leaf="">AI正在对汽车行业形成三重暴击</span></span><span leaf=""><br/></span></strong></h4></section></section></section></section><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：上半年蔚来营收、毛利和经营质量都有明显改善，这背后的核心因素是什么？这些能力能否支撑蔚来下半年乃至明年持续盈利？</span></span></strong></span></p></section></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489krfxq" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">我们还是有信心的。现在我们控制成本和费用的能力，比以前强了很多。另一方面，在销量增长上，我们也建立了一套自己的底层方法，叫“6P模型”，现在对销量的预测准确度比以前高很多。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr1kx4" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">有些车型，我们已经可以做到提前三个月预测销量，偏差率控制在10%以内。需求预测本身并不容易，但现在整个经营体系的可预测性确实比以前强了很多。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：上半年蔚来营收已经进入中国自主品牌前三。现在汽车企业的评价体系是不是也应该发生变化？您认为看一家车企最重要的指标是什么？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489kr1bc3" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">我觉得首先还是要看增长质量，包括单价、毛利率、产品结构以及整个经营质量。比如一家公司的销量里还有大量插混、增程甚至油车，这些可能都是未来需要填的坑，这种增长和纯电增长的质量是不一样的。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krs6c" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">所以我一直建议大家可以做一个“中国品牌纯电销售收入排行榜”。把销售额、毛利、单价以及增长质量综合起来看，比简单看销量或者营收更有意义。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krf47" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">因为数字背后还有数字。真正评价一家企业，要看它增长的部分是不是符合未来趋势，以及这些增长有没有带来健康的经营结果。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：今年下半年新车上市任务基本完成，在没有新车刺激的情况下，蔚来拉动销量的核心抓手是什么？Q3交付指引低于市场预期，销量是否进入瓶颈期？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489krqs2" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">秦力洪：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">下半年准确来说是7月中旬以后新车上市任务基本完成，接下来销量增长还是来自多个方面。首先要看整个市场，如果四季度出现局部回暖，我们希望能够抓住市场机会。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr213" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第二个非常重要的因素是价格稳定。新车价格剧烈波动，会直接影响二手车价格，进而影响消费者购买新车的决策。我们一直在跟踪这个指标，乐道L60目前在细分市场里的二手车价格表现就比较坚挺。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krokg" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第三个是精益效率。我们全国一线销售人员数量是相对固定的，如果把每个人每天能够投入的时间看成生产力总额，真正要做的就是让每一个人的有效工作多一点，减少无效工作。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krub" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">所以我们没有什么神奇的大招，核心就是抓住市场机会、保持价格稳定，同时把最基础的一线生产力一点点提升起来。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489krbke" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">还有一个冷知识，我们公司增长最快的一年恰恰没有发布新车。我们现在还是非常有信心，因为新增订单量一直在逐月增长。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krxt1" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">大家有时候看交付量，比如去年12月交付两万多台ES8，但这并不意味着当月新增了两万多个订单，其中还包括前期库存订单。所以我们内部真正看的是新增订单，目前这个指标增长还是非常健康的。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：上半年蔚来营收、毛利等经营数据表现不错，但财报发布后股价出现波动。您认为资本市场目前低估蔚来的地方是什么？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489kr1ss8" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">资本市场的价格反映的是投资人在这个时间点对公司的综合认知，影响因素非常多。说实话，如果我能把股价为什么涨跌解释清楚，那我可能已经发财了。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krqfk" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">但我确实认为，汽车行业现在有点被低估。AI对汽车行业形成了三重暴击：首先是内存、PCB、铜、铝甚至电池等资源被AIDC大量吸走；第二是人才被具身智能等新领域吸引；第三是资本市场的注意力也被这些领域吸走了。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr101u" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们身上有几方面可能被低估。第一是全栈技术能力，包括芯片、操作系统和AI能力，这些都是AI时代的底层能力。第二是能源业务，包括换电、能源服务等，它的价值也没有完全被市场理解。</span></span></p><section nodeleaf="" style="text-align: center;margin-bottom: 0px;line-height: 1.75em;" data-mpa-action-id="mtr4d8xmbqf" data-pm-slice="0 0 []"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f37c43e11.png" class="rich_pages wxw-img" data-ratio="1.333467417538214" data-type="jpeg" data-w="2486" height="1228" style="background-color: transparent;width: 100%;" width="939" data-width="2486" data-height="3315" data-backw="578" data-backh="756" data-imgfileid="504272728" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f37c43e11.png?imageMogr2/quality/90"/></section><p style="text-align: center;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr4dhfbiil" style="font-size: 12px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" data-mpa-action-id="mtr4dhfj12ds" data-pm-slice="0 0 []"><span textstyle="" style="letter-spacing: 0.5px;color: #888888;">蔚来创始人、董事长、CEO李斌</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr1ujz" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第三是蔚来在智能电动车时代的品牌稀缺性。三四十万元以上的市场里，真正能够和蔚来进行体系化品牌竞争的企业并不多。品牌意味着长期稳定的竞争力，也意味着长期稳定的盈利能力。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr12zz" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">还有一点是我们的商业模式。蔚来去年服务与社区业务突破100亿元，今年一、二季度还在持续增长并且赚钱，这是基于存量用户产生的持续收益，也是目前很多汽车公司不具备的能力。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：芯片、电池原材料都在涨价，下半年蔚来怎么守住毛利率？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489kr1ugh" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">上半年特别是二季度，我们已经把这一轮成本上涨消化掉了大部分。下半年虽然还会继续涨一点，但我们会通过供应链成本优化，以及和合作伙伴一起提效，消化额外的涨价成本。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krnur" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">所以总体来看，我们有信心保持一个合理的毛利率水平，基本和二季度接近。只要价格不乱动、不主动降价，毛利率还是可以稳住的。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：二季度整车毛利率18.5%，下半年单车成本还会上涨，蔚来到底是保销量还是保毛利？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489kr1v5z" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">我们最终看的是毛利总额，毛利总额优先。内部做量价关系测算的时候，也是以毛利总额最大化、EBIT最大化为核心。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr13rh" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">现在这个阶段，单纯通过价格做文章意义不大。降一点价格带来的销量增长有限，降几万元又会直接破坏成本结构和毛利，所以近期没有主动调整价格的必要。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krhlr" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">今天汽车行业还有一个变化，就是很多成本已经出现了规模不经济。以前制造业是量越大、成本越低，但现在很多真正能够分摊的固定成本没有想象中那么多，量上去以后，成本甚至可能继续上升。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：原材料持续涨价，蔚来怎么应对？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489krzhx" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">抗拒不了，只能接受。我们能做的就是保持价格稳定，保持高端定位，同时持续优化内部运营效率。</span></span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：蔚来有没有明确的市场份额目标？未来做到多大销量可以实现全口径盈利？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489kr4tt" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">我们没有规定哪一年必须做到多少市场份额，但有一个大体目标，就是在第三成长周期保持40%—50%的增长。虽然整个行业在下行，但纯电渗透率还在提升，我们只做纯电，所以仍然有机会。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489krl5r" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">今年四季度到明年一季度压力会大一些，主要是因为去年四季度基数太高。去年四季度交付超过12.4万辆，单月还交付了两万多台ES8，所以今年四季度即使继续增长，基数也已经完全不同。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr6rj" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">从全年来看，今年的增长仍然会比较不错。明年一季度一直是行业比较困难的季度，还要看今年有多少存量订单能够延续到明年。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：全口径盈利是不是需要非常大的销量？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489kruf" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">全口径盈利其实没有大家想象得那么难。NON-GAAP和全口径之间，主要还受到股权激励、利息、投资收益等因素影响。如果投资收益好一点，全口径就可能盈利。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr1o5u" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">从企业经营角度来看，我们更看重NON-GAAP，因为很多非经营性因素受外部环境影响较大，并不完全代表企业日常运营能力。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：蔚来已经连续三个季度盈利，为什么如此看重持续盈利？这是否意味着以后不会再主动降价？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489kr1iyn" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">前几年我们追求盈利，是因为公司处于不同的发展阶段。现在蔚来半年营收已经接近600亿元，全年肯定会超过1200亿元，如果这个规模还不能持续稳定盈利，就说明公司的管理能力还存在问题。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr1fr4" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">所以持续稳定的盈利能力，现在已经不是执着于利润，而是一个基本的管理要求。外部成本变化不能成为长期不能盈利的理由。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kr1p5q" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们也不会追求特别高的利润率。换电业务本身就是战略性投入，其他业务赚的钱覆盖这些投入之后，公司依然能够盈利，从盈利质量角度看是比较健康的。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：汽车行业从追求规模转向追求最优规模，蔚来怎么判断最优规模？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks20ig" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">这个问题比较难回答，说到底还是要认真算细账。关键要看企业到底有多少固定成本，以及这些固定成本和费用有多少能够真正通过销量分摊。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksu3f" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">所以未来我们的账会越来越细。单车CBU、单门店CBU、单市场活动CBU、单个零件CBU，每件事情都要去算。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks19po" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">最终不是简单追求规模最大，而是找到每件事情的最优解，这就是CBU机制的价值。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：蔚来上半年销售和管理费用明显高于研发费用，研发费用下降是否意味着省出来的盈利？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks1tiv" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">这个说法有点被带节奏了。上半年我们的钱肯定是赚出来的，毛利总额已经相当于其他一些公司的两三家总和。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks93v" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">研发费用下降，主要是通过提效保证研发竞争力，同时把一些低ROI的应用开发减少或者取消。基础研发一直有保障，所以不是简单地砍研发换利润。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1v0c" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">销售费用方面，乐道还处于投入期，需要维持400多家门店和几千名销售人员；欧洲也有牛屋等长期品牌建设投入。这些都会阶段性影响销售费用。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksa6o" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">管理费用整体还是非常精益的，财务人员占公司总人数的比例很低，管理体系的人员占比也很低。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks179z" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">秦力洪：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">蔚来的销售费用里还包含整个换电站和相关服务，这一点和采用经销商模式的企业不能简单横向比较。很多公司的相关费用实际上已经体现在价格体系里了。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks5gf" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">另外二季度新品发布比较多，有一些阶段性的营销支出，三季度新品相对少，相关费用也会有所下降。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section data-mpa-template="t" mpa-from-tpl="t" style="margin-bottom: 24px;outline: 0px;color: rgba(0, 0, 0, 0.9);font-size: 17px;letter-spacing: 0.544px;text-align: justify;"><section data-mpa-template="t" mpa-from-tpl="t" style="outline: 0px;"><section data-role="paragraph" mpa-from-tpl="t" style="outline: 0px;"><section data-role="title" data-tools="135编辑器" data-id="94063" mpa-from-tpl="t" style="outline: 0px;"><section hm_fix="374:463" mpa-from-tpl="t" style="padding-top: 10px;padding-bottom: 10px;outline: 0px;text-align: center;"><section mpa-from-tpl="t" style="outline: 0px;display: inline-block;"><section data-bgless="spin" data-bglessp="280" mpa-from-tpl="t" style="margin-bottom: -22px;outline: 0px;height: 8px;background: rgb(238, 92, 47);border-radius: 6px;overflow: hidden;"><span leaf=""><br/></span></section><section mpa-from-tpl="t" style="margin-right: auto;margin-left: auto;padding-right: 10px;padding-left: 10px;outline: 0px;display: inline-block;height: 35px;color: rgb(63, 63, 63);line-height: 35px;font-size: 30px;transform: rotate(0deg);"><strong mpa-from-tpl="t" style="outline: 0px;" mpa-is-content="t"><span leaf="">02</span><span leaf=""><br/></span></strong></section></section></section><h4 style="outline: 0px;font-weight: 400;font-size: 16px;text-align: center;visibility: visible;letter-spacing: 0.544px;line-height: 1.6em;"><strong mpa-from-tpl="t" style="outline: 0px;visibility: visible;"><span style="outline: 0px;color: #EE5B2E;visibility: visible;" mpa-is-content="t"><span leaf="">能不能做，和要不要做，是两回事</span></span><span leaf=""><br/></span></strong></h4></section></section></section></section><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：智能电动车已经涉及汽车、能源和信息技术等多个领域，很多车企都在跨界布局。蔚来为什么反而越来越强调聚焦？未来什么时候会考虑第二、第三增长曲线？</span></span></strong></span></p></section></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks1034" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">智能电动汽车和传统汽车确实已经是完全不同的产品形态，它同时涉及信息技术、能源和汽车三个行业。但汽车依然是高价值、长生命周期的耐用消费品，安全、供应链、制造、研发和服务这些基本规律都不能丢。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1tyo" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">现在的汽车其实比过去复杂很多，一辆车有大量芯片，电池占据很高的价值量，还有软件、OTA以及持续迭代。以前造车更像敲鼓，现在更像交响乐，不同系统的迭代节奏完全不同。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1u8p" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">从能力上讲，我们当然可以做储能、软件以及各种智能电动产品，但能做和应该做是两回事。就像苹果有很多能力，也不会因为能做就什么都做，这是战略选择。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksxp4" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们在中国高端市场的空间还很大。比如上海上半年蔚来的市场份额如果能做到8%，销量就可以增长三倍；长三角还有更大的空间。在这些事情还没有做到之前，去谈第二曲线，我认为是好高骛远。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks244u" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">所以我们现在还是聚焦中国市场、聚焦高端，把自己的基本功练好。未来如果需要布局第二、第三曲线，我们可以通过分拆融资、培养创业团队等方式去做，但现在公司的资源和精力还是应该放在最重要的事情上。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：蔚来过去在研发、换电、服务等方面进行了大量长期投入，现在又选择聚焦汽车。未来如果其他车企通过AI、机器人等新业务实现领先，蔚来如何判断哪些业务应该投入？一项业务又应该给团队多长时间证明自己？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ksvq0" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">一款车从研发到整个生命周期，至少应该用五年的周期来看。研发可能需要两年，后面还要看三年的产品生命周期，不能只看明天能不能赚钱。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksl5k" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">但即使按照五年来看，也可以做优先级排序。技术路线是十年思考，产品规划是五年思考，产品定义是两年思考。尤其产品规划，要想清楚哪些事情应该做、哪些事情不应该做。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1hfu" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">包括全球市场也是一样，要算清楚进入哪些国家、什么时候进入、用什么品牌和车型进入。以前我们可能更多是看大方向，现在我们更强调把账算清楚以后再做。</span></span></p><section nodeleaf="" style="text-align: justify;margin-bottom: 0px;line-height: 1.75em;" data-mpa-action-id="mtr4fapz1h0g" data-pm-slice="0 0 []"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f37cad9c1.png" class="rich_pages wxw-img" data-ratio="1.3332112779201757" data-type="jpeg" data-w="2731" height="1131" style="background-color: transparent;width: 100%;" width="878" data-width="2731" data-height="3641" data-backw="578" data-backh="745" data-imgfileid="504272727" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f37cad9c1.png?imageMogr2/quality/90"/></section><p style="text-align: center;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr4fm4l1mdd" style="font-size: 12px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;" data-mpa-action-id="mtr4fm4uq95" data-pm-slice="0 0 []"><span textstyle="" style="letter-spacing: 0.5px;color: #888888;">蔚来联合创始人、总裁秦力洪</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1mwf" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">这不意味着我们不做长期投入。现在蔚来研发投入里很大一部分仍然是基础能力建设，这些项目本身就是长期投入。换电站今年依然保持建设速度，目标还是新增1000座，渠道和门店建设也没有放慢。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks24hk" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们在具身智能等领域同样有布局，只是布局方式和其他公司不一样。核心还是一句话：长期投入要做，但每一项投入都要知道为什么做、算得清楚账。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：除了汽车之外，蔚来的第二、第三增长曲线会来自哪里？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks1nzr" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">第二增长曲线其实已经出现了，主要来自服务和社区的存量收入。随着保有量增长，即使每年的新车销量不增长，服务和社区收入也有机会持续扩大。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1giu" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">今年我们的充换电电量同比增长大约40%，公司内部围绕服务与社区收入已经有十几个业务线，包括订阅服务、智能辅助驾驶订阅等。仅二手车用户的智驾订阅，今年就已经带来几千万元收入。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1c0v" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">这不是一个未来的故事，服务与社区业务已经是百亿元级规模。去年全年大约100亿元，今年上半年已经达到58亿元，其中一季度27亿元、二季度31亿元。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1ml1" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">第三增长曲线可能来自更大的领域，比如能源业务或者物理AI，这个时间会更远一些。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：明年三个品牌的销量结构会怎么变化？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks24pu" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">目前还没有认真算过，但整体结构不会和今年有太大变化。乐道的占比肯定会比今年提高。</span></span></span></p><section data-role="title" data-tools="135编辑器" data-id="94063" mpa-from-tpl="t" style="outline: 0px;"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：很多车企做具身智能是为了资本市场故事，如果做机器人能够提升市值，蔚来会不会考虑？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks1q9r" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span mpa-font-style="mtr489ks1034" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong></span><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">我非常同意具身智能会是一个非常大的生意，对人类社会的意义也非常大。但什么时候进入、用什么方式进入、做什么产品和服务，每家公司都会有不同判断。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks120u" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我把机器人分成三类：第一类是表演型机器人，现在大部分机器人属于这一类，控制能力可以，但真正能干的事情还比较有限；第二类是生产力机器人；第三类是通用服务机器人。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1ttq" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">生产力机器人其实已经非常普及。汽车上的辅助驾驶就是一种生产力机器人，相当于买车送司机；酒店送餐机器人、家里的扫地机器人也都是。它们不需要长得像人，也不一定需要用人的方式完成工作。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksum6" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">所以我认为生产力机器人还有非常大的空间，但不一定非要做成人形。通用服务机器人当然也非常有价值，但难度更大，属于比较终极的目标。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksa0r" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">可以直接从最难的事情开始，也可以先做生产力机器人先挣钱，最终可能殊途同归。我们现阶段还是会根据自己的判断选择进入的时间和方式。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section data-mpa-template="t" mpa-from-tpl="t" style="margin-bottom: 24px;outline: 0px;color: rgba(0, 0, 0, 0.9);font-size: 17px;letter-spacing: 0.544px;text-align: justify;"><section data-mpa-template="t" mpa-from-tpl="t" style="outline: 0px;"><section data-role="paragraph" mpa-from-tpl="t" style="outline: 0px;"><section data-role="title" data-tools="135编辑器" data-id="94063" mpa-from-tpl="t" style="outline: 0px;"><section hm_fix="374:463" mpa-from-tpl="t" style="padding-top: 10px;padding-bottom: 10px;outline: 0px;text-align: center;"><section mpa-from-tpl="t" style="outline: 0px;display: inline-block;"><section data-bgless="spin" data-bglessp="280" mpa-from-tpl="t" style="margin-bottom: -22px;outline: 0px;height: 8px;background: rgb(238, 92, 47);border-radius: 6px;overflow: hidden;"><span leaf=""><br/></span></section><section mpa-from-tpl="t" style="margin-right: auto;margin-left: auto;padding-right: 10px;padding-left: 10px;outline: 0px;display: inline-block;height: 35px;color: rgb(63, 63, 63);line-height: 35px;font-size: 30px;transform: rotate(0deg);"><strong mpa-from-tpl="t" style="outline: 0px;" mpa-is-content="t"><span leaf="">03</span><span leaf=""><br/></span></strong></section></section></section><h4 style="outline: 0px;font-weight: 400;font-size: 16px;text-align: center;visibility: visible;letter-spacing: 0.544px;line-height: 1.6em;"><strong mpa-from-tpl="t" style="outline: 0px;visibility: visible;"><span style="outline: 0px;color: #EE5B2E;visibility: visible;" mpa-is-content="t"><span leaf="">汽车行业进入马拉松中后阶段还有三五年</span></span><span leaf=""><br/></span></strong></h4></section></section></section></section><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：随着乐道未来向更主流的家庭市场发力，蔚来的品牌表达会不会变得更加亲民？如何平衡高端品牌调性和大众沟通？</span></span></strong></span></p></section></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks1wwa" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">目前外界关于乐道新车的很多信息其实都是猜测，我们还没有公布具体车型。乐道未来还是会坚持高品质家庭用车的定位，可以理解为对标丰田、大众的高线产品，去满足一部分目前没有被很好满足的家庭用车需求。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksf4g" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">所以大家期待特别便宜的乐道，这个应该不存在。但我们认为它一定要值，要给用户提供相匹配的产品和价值。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1oqg" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">蔚来的品牌其实十几年没有发生大的变化，我们一直希望成为一个有想法、有品位、靠谱的朋友。乐道也是希望成为用户靠谱的伙伴，萤火虫则是“自在发光”，每个品牌都有自己的定义。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksfc4" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">推出新的产品，并不意味着整个公司都要改变自己的表达方式。我们还是把自己的事情做好。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：现在蔚来在部分城市的销量已经超过BBA。您此前说汽车行业进入马拉松中后阶段，您认为这个阶段还会持续多久？最终行业会形成怎样的格局？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks1vhm" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">我认为中期还有三到五年，后端可能没有真正结束的那一天。再往后看五到十年，行业可能会形成阶段性的基本格局。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksjm5" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">行业集中度一定会提升，但我认为不会高到大家想象的程度。全球汽车行业一直都不是一个高度集中的行业，其中一个重要原因就是地缘政治。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksttl" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">中国车企现在全球化发展很快，但背后也存在一定隐忧，未来最大的变量可能还是国际政治和全球贸易环境。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：昨天力洪在澳门提到香港市场。蔚来进入香港目前是什么进展？为什么右舵车型开发成本和周期相对更高？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks64c" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">秦力洪：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">香港市场的筹划一直在进行。昨天澳门开业时，有香港当地重要的汽车销售公司专门过来交流，还有香港用户专程到澳门买ES9，这让我们进一步感受到当地市场的需求。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kswjr" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">欧洲市场目前我们更看重品牌声誉和用户体验，会采用代理模式，让合作伙伴先把产品和服务经营好，再和我们一起增加投入，这样效率和财务结构都会更合理。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksvy8" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">香港市场我们会继续推进，但具体时间目前还不好说。至于右舵车，我并不认为蔚来的成本或者周期一定比别人高，只是我们在CBU层面的成本核算比较细。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：最近行业对速成车的讨论比较多。智能电动车越来越复杂，您怎么看待开发周期与产品质量之间的关系？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks1cio" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">如果一款车经过国家相关标准和认证，我觉得评价它不能简单看开发时间长短。关键应该区分两种情况：一种是经过充分验证和测试的，另一种是没有经过充分验证和测试的。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksufn" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">开发时间短并不必然意味着产品验证不足。我们可以保证蔚来的每一款车都经过严格、充分的测试，最终还是要看产品有没有经过充分验证。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：乐道未来会不会进入12万—20万元市场？乐道的价格下探空间有多大？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks1ci4" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">乐道目前其实已经进入20万元以内。L60的BaaS价格进一步往下，但我们会非常谨慎地逐步把价格线往下移，不会一下子跳到15万元左右。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1gpt" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们可以明确说，蔚来没有进入15万元以下市场的计划。未来基本还是围绕20万元以内这个区间做，但不会无限制地下探。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks16qz" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">短期来看，换电联盟也不是最高优先级，还是先让自己的车卖好。合作伙伴如果愿意上车，我们欢迎，也会积极配合。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：乐道是否已经从追求规模转向兼顾毛利的中高端家庭品牌？它作为独立品牌的价值是什么？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489kspd2" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">我们要做的是“蔚、乐、萤”。乐道今年1—8月平均成交价24.8万元，已经超过一些传统豪华品牌。乐道会坚持高品质家庭用车的定位，因为智能电动汽车要做到高品质，成本结构就决定了不可能做到特别便宜。</span></span></span></p><section nodeleaf="" style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f37d1c358.png" class="rich_pages wxw-img" data-ratio="0.5625" data-type="png" data-w="1920" style="background-color: transparent;width: 100%;" data-width="1920" data-height="1080" data-backw="578" data-backh="325" data-imgfileid="504272725" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f37d1c358.png?imageMogr2/quality/90"/></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1ji2" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">蔚来5系、6系上市之后，品牌均价仍然会保持在40万元以上，乐道和蔚来的均价会保持十几万元的差距，这本身就是两个不同的市场。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksft2" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">蔚来9系、8系更偏行政旗舰和全场景，兼顾商务与家庭；乐道则更加专注高品质家庭场景。当然，乐道也可以承担公务用途，目前已经有政府采购乐道作为公务用车，BaaS之后18万元以内就可以满足一些采购标准。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1dsb" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">乐道怎么算成功？就是各款产品在各自细分市场做到领先。目前L90在30万元级纯电大SUV里已经是第一名，这是事实。只要产品定义正确、渠道逐步覆盖，乐道就有机会达到我们的预期。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksbee" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">销售管理和销售团队会保持独立，不会进一步合并。但在渠道上，未来会有部分SKY门店合并，三四线城市也会进一步增加三品牌共用门店。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section data-mpa-template="t" mpa-from-tpl="t" style="margin-bottom: 24px;outline: 0px;color: rgba(0, 0, 0, 0.9);font-size: 17px;letter-spacing: 0.544px;text-align: justify;"><section data-mpa-template="t" mpa-from-tpl="t" style="outline: 0px;"><section data-role="paragraph" mpa-from-tpl="t" style="outline: 0px;"><section data-role="title" data-tools="135编辑器" data-id="94063" mpa-from-tpl="t" style="outline: 0px;"><section hm_fix="374:463" mpa-from-tpl="t" style="padding-top: 10px;padding-bottom: 10px;outline: 0px;text-align: center;"><section mpa-from-tpl="t" style="outline: 0px;display: inline-block;"><section data-bgless="spin" data-bglessp="280" mpa-from-tpl="t" style="margin-bottom: -22px;outline: 0px;height: 8px;background: rgb(238, 92, 47);border-radius: 6px;overflow: hidden;"><span leaf=""><br/></span></section><section mpa-from-tpl="t" style="margin-right: auto;margin-left: auto;padding-right: 10px;padding-left: 10px;outline: 0px;display: inline-block;height: 35px;color: rgb(63, 63, 63);line-height: 35px;font-size: 30px;transform: rotate(0deg);"><strong mpa-from-tpl="t" style="outline: 0px;" mpa-is-content="t"><span leaf="">04</span><span leaf=""><br/></span></strong></section></section></section><h4 style="outline: 0px;font-weight: 400;font-size: 16px;text-align: center;visibility: visible;letter-spacing: 0.544px;line-height: 1.6em;"><strong mpa-from-tpl="t" style="outline: 0px;visibility: visible;"><span style="outline: 0px;color: #EE5B2E;visibility: visible;" mpa-is-content="t"><span leaf="">神玑今年预计可以产生几个亿的外部收入</span></span><span leaf=""><br/></span></strong></h4><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：蔚来提出AI原生组织，具体意味着什么？未来AI会不会改变蔚来的组织层级和管理方式？</span></span></strong></span></p></section></section></section></section></section></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks22ea" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">我们最开始做CBU，并不是从“AI原生组织”这个概念出发，而是想把公司经营最基本的逻辑搞清楚：我们到底围绕哪些经营对象做经营。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1jkj" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">后来我们发现，这和AI里的本体论、软件工程的逻辑其实是一回事。把经营对象拆清楚以后，组织结构、流程、考核和激励都会发生变化。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksu2n" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">以前的组织更多是自上而下做目标拆解，现在我们更强调自下而上。比如一线FL（Fellow）需要什么样的赋能和支持，区域公司的费用也开始从一线经营结果出发，这套逻辑正在发生变化。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks21tx" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">AI也是一样，本质上是把知识拆解到最小单元。我们现在甚至在做单零件级别的CBU，把一辆车拆解成一万七八千个零件，再用AI去寻找提升效率、降低成本的机会。方向已经清楚，但能力还在建设，我们估计还需要大约一年时间。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：现在资本大量涌向AI，汽车行业反而受到资本冷落，车企怎么保证自己仍然站在AI前沿？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks1qfe" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">上周上海有一个很重要的集成电路产业高峰论坛，两年前我去讲过一次，今年又邀请我参加。为什么汽车行业会被邀请？因为汽车本身就是一个非常大的AI载体。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1drn" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">现在一辆车里，半导体的价值已经非常高。以ET9为例，把车上所有半导体放在一起计算，大概是10.5万元，已经超过电池。汽车本身就是一个高价值的边缘计算终端，也是一个具身智能体。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksbh" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">所以我们不要再用以前的眼光看汽车。汽车本身就是AI行业的一部分，甚至是目前价值最高的产品之一。资本市场短期有风口、有起伏，但最终还是要回到企业价值，还是要看经营结果和盈利能力。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：CBU以经营指标为核心，会不会反而扼杀长期创新？研发费用下降，怎么向外界解释蔚来仍然在持续创新？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks17yo" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">CBU不会扼杀创新，反而是在促进创新。比如一个研发项目，如果确实是为了创新，在我们公司完全可以立项，也有足够资源支持长期投入。基础研发、用户基础服务等必须做的事情，并不需要全部算短期ROI。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks83e" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">真正需要解决的是优先级问题。大家不能想一出是一出，要说清楚这个项目到底创造什么用户价值，为什么值得做。CBU能够消除很多伪创新，把资源集中到真正有价值的事情上。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks2yu" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">另外，CBU还有一个好处，就是可以把研发项目做小。原来预算制下，一个项目立项以后可能一直往前推进，现在如果中途发现账算不过来，就可以及时踩刹车、主动止损。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks1oid" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">秦力洪：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">CBU追求更高ROI，反而会逼着大家创新做事的方法。传统方法做这个项目ROI可能只有这样，但换一种方式，ROI可能发生革命性的变化。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksx0s" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">这不只是技术研发，包括营销、管理都有很多这样的例子。不是找斌哥求情，也不是去调整数据，而是找到一个创造性的方法，把事情做得更好。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks18af" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">说得简单一点，就是现在20亿元可以干别人30亿元的活。我们长本事了，钱要花在点子上，该花的花、该省的省。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks3nx" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">秦力洪：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">最近大家总说我们的研发费用下降了，但研发费用占销售收入仍然有7%多，其实并不低。更重要的是研发效率在持续提高，最后还是要看大家交出来的东西有没有技术含量。</span></span></span></p><section data-role="title" data-tools="135编辑器" data-id="94063" mpa-from-tpl="t" style="outline: 0px;"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：蔚来长期没有CTO，三大品牌和多平台的技术体系怎么管理？您自己做CTO如何提高效率？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ksbn9" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">这是我们对智能电动汽车研发的一种思考。今天智能电动汽车的产品和技术研发跨域融合非常多，涉及12个全栈领域，很难真的有一个人把所有技术细节都理解到足以做出所有判断。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489kskao" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">所以我们更希望建立一个机制，让不同团队之间能够低成本、高效率地交流，避免形成大山头、小山头。这个结构从2019—2020年开始调整，一直支撑现在多品牌、多平台的研发体系。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksjw7" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">比如萤火虫的专责研发团队只有几十个人，但效率比大家想象得高。我们主要把精力放在产品方向、投资决策和跨部门协同上，不需要所有事情都到我这里决策。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks222x" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">技术路线也有自己的机制。公司有AGI委员会、产品委员会，以及各个细分领域的NCP小组，分别负责技术路线和专业决策。整体上还是推动大家自下而上交流和决策。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：蔚来会不会自制电芯？自研电池目前是什么路线？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks17n4" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">我们这几年在电池研发上的投入一直很大，累计已经超过20亿元，目前仍然保持高强度投入。我们的核心方向很明确，就是长寿命电池。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1q9v" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">另外，我们正在积极推动电芯标准化。我认为电芯标准化可以给整个汽车行业省很多钱，不仅汽车厂商可以省，电池厂商也可以省。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksks4" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">如果电芯标准化，一款车型销量变化时，就可以迅速增加或者减少产能，而不会因为切线产生巨大的产能、料损和爬产成本。现在电池技术已经逐步收敛，我认为已经到了推动电芯标准化的时候。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks27" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们的方向是46系列大圆柱、长寿命电芯。目前蔚来有一条很小的产线，可以自己生产一些电芯，但不会简单走大规模自建电芯工厂的路线。</span></span></p><section nodeleaf="" style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f37d8f791.png" class="rich_pages wxw-img" data-ratio="0.563" data-type="png" data-w="2000" style="background-color: transparent;width: 100%;" data-width="2000" data-height="1126" data-backw="578" data-backh="325" data-imgfileid="504272726" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f37d8f791.png?imageMogr2/quality/90"/></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1ey4" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">未来更可能采用“自研+代工”的方式：原材料采购、研发和相关管理由我们自己掌握，制造环节则和行业电池企业合作。具体合作伙伴目前还在谈，现阶段外界的各种猜测都不准确。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：蔚来自研芯片后续还有没有新的合作？神玑有没有对外商业化的计划？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks22zz" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">我们现在对外合作其实挺多的，神玑今年预计可以产生几个亿的外部收入。具体合作伙伴和金额我们不会全部披露，但这块业务已经开始产生实际收入。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks31e" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们会和投资人进行更多交流，把公司现阶段正在做的事情、战略和业务情况坦诚讲清楚。当然，有些事情最终可能实现，有些也可能没有完成，但我们保证每一次交流的时候，讲的都是当下真实的判断。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：下半年单车成本增加1.6万—1.7万元，主要来自哪些方面？二手车用户的智驾订阅还有多大提升空间？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489kskoj" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">单车成本增加1.6万—1.7万元，主要还是内存涨价，平均下来大约有1万元来自内存，部分车型甚至更高。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1wvi" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">另外大约3000—4000元来自电池，此外还有铜、铝等材料价格上涨带来的成本压力。整体来看，内存是这轮成本上涨最大的因素。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksmfs" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">二手车智驾订阅主要还是看产品好不好用。现在如果一天花10元钱就能请一个真正好用的司机，能够让用户开得安心、安全，用户自然会愿意订阅。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks6ya" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">目前二代车中符合订阅条件的车辆，加上三代车，相关保有量大约4万辆。其中常态订阅用户大约8000人，所以还有很大的提升空间。随着二手车保有量持续增长，这块业务也会越来越大。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section data-mpa-template="t" mpa-from-tpl="t" style="margin-bottom: 24px;outline: 0px;color: rgba(0, 0, 0, 0.9);font-size: 17px;letter-spacing: 0.544px;text-align: justify;"><section data-mpa-template="t" mpa-from-tpl="t" style="outline: 0px;"><section data-role="paragraph" mpa-from-tpl="t" style="outline: 0px;"><section data-role="title" data-tools="135编辑器" data-id="94063" mpa-from-tpl="t" style="outline: 0px;"><section hm_fix="374:463" mpa-from-tpl="t" style="padding-top: 10px;padding-bottom: 10px;outline: 0px;text-align: center;"><section mpa-from-tpl="t" style="outline: 0px;display: inline-block;"><section data-bgless="spin" data-bglessp="280" mpa-from-tpl="t" style="margin-bottom: -22px;outline: 0px;height: 8px;background: rgb(238, 92, 47);border-radius: 6px;overflow: hidden;"><span leaf=""><br/></span></section><section mpa-from-tpl="t" style="margin-right: auto;margin-left: auto;padding-right: 10px;padding-left: 10px;outline: 0px;display: inline-block;height: 35px;color: rgb(63, 63, 63);line-height: 35px;font-size: 30px;transform: rotate(0deg);"><strong mpa-from-tpl="t" style="outline: 0px;" mpa-is-content="t"><span leaf="">05</span><span leaf=""><br/></span></strong></section></section></section><h4 style="outline: 0px;font-weight: 400;font-size: 16px;text-align: center;visibility: visible;letter-spacing: 0.544px;line-height: 1.6em;"><strong mpa-from-tpl="t" style="outline: 0px;visibility: visible;"><span style="outline: 0px;color: #EE5B2E;visibility: visible;" mpa-is-content="t"><span leaf="">到年底纯电渗透率预计将达50%</span></span><span leaf=""><br/></span></strong></h4></section></section></section></section><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：蔚来工厂成为灯塔工厂的核心原因是什么？智能制造又能给蔚来的经营和产品开发带来什么帮助？</span></span></strong></span></p></section></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks214e" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">世界经济论坛评价我们的时候，除了智能化、精益制造和先进性，还特别强调了以用户为核心。比如我们如何高效率地满足用户个性化、定制化的需求，以及如何让一个工厂同时具备制造和用户参观体验的能力。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksf5h" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">一个封闭的工厂和一个开放的工厂，对管理能力的要求完全不同。我们每年有十几万人参观工厂，所以从设计、制造到运营，都需要更高的管理水平。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksefq" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">另外，我们也是绿色工厂，光伏发电可以满足工厂四分之一的用电需求。灯塔工厂本身也是对蔚来智能制造能力的一种认可。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：AIDC目前对汽车产业链的成本和人才都带来了压力，这种影响什么时候可能缓解？另外，今年汽车行业如果用一个关键词来概括，您会怎么定义？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks1x3x" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">AIDC未来的发展很难准确预测，但这里面有一个值得警惕的问题，就是后发优势。现在大家在高成本的时候投入大量资金，两三年以后内存等资源价格可能下降，同样的算力可能只需要更低的成本获得。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1wsw" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">如果今天花一万亿美元做的事情，三年后只需要三千亿美元就能完成，那么前期多投入的七千亿美元，未必能够创造相应的价值。这是整个AIDC投资里面值得关注的风险。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks209x" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">从汽车行业来看，我认为这种成本压力可能还要持续两年左右。如果现在的供需变化持续下去，到2028年内存和部分大宗材料可能会出现更充足的供应。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks147j" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">秦力洪：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">我觉得有一点是肯定的，就是纯电正在成为主流。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489kshgy" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">对，关键词可以叫纯电成主流。到年底看看纯电渗透率能不能达到50%。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks1o5f" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">秦力洪：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">很多用户过去还有一个惯性思维，觉得选择纯电的是少数新锐人群。实际上今天纯电已经正在成为大多数人的选择。</span></span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：蔚来什么时候会真正进入机器人业务？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks14eu" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">机器人的产业链现在还处于非常早期，我们也投资了里面很多公司。汽车行业本身就是一个非常大的市场，所以不能指望所有事情都由蔚来第一个去做。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksf2u" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们现在还是先把车卖好，把公司变成一个能够持续盈利的公司。汽车公司做机器人也不是什么新鲜事，大部分车企都在做，我们会保持关注，也会有很多选择，但现阶段还是先把汽车这个事情做好。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：宁德时代等企业加速布局换电，未来如果出现十几家换电核心企业，对蔚来有什么影响？联盟合作还有哪些进展？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks7nk" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">我们非常乐于看到宁德时代这样的公司投资换电网络，也欢迎更多汽车公司选择换电路线。过去我们已经和几家公司签署了战略合作协议，现在也确实有一些合作伙伴比以前更加积极、主动地推动具体落地。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks21ta" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们现在的优先任务还是服务好自己的用户，所以不会把换电联盟当成最高优先级。但如果有人愿意加入，我们非常开放，也非常欢迎。现在五代站的兼容性也更好，如果合作伙伴真正上车，大概十几个月就可以实现。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks2359" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">蔚来现在最大的换电网络、最成熟的换电网络，也是体验最好的换电网络。我们先把自己的事情做好，其他合作顺其自然、水到渠成。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：未来蔚来的换电站建设规模会达到什么水平？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr489ks3rp" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">换电站其实很好算账。蔚来基本上每500辆车对应一座换电站，这样一座站就基本能够赚钱。</span></span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ksoed" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">如果一年卖50万辆车，1000座换电站其实是必须的；如果一年卖到100万辆，就需要大约2000座，才能保证用户体验不下降。所以未来换电站增加的速度，可能不会简单理解成一年新增1000座。</span></span></p><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span leaf="" mpa-font-style="mtr489ks1l6e" style="font-size: 15px;font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><span textstyle="" style="letter-spacing: 0.5px;">我们接下来更多会按照区域去建设，本来就应该建的站就去建，不太会再强调所谓提前建站。</span></span></p><section data-mpa-template="t" mpa-from-tpl="t"><section style="-webkit-tap-highlight-color: transparent;outline: 0px;visibility: visible;" data-mpa-action-id="mr4k8p3w210p" data-pm-slice="5 5 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-powered-by&quot;:&quot;yiban.io&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;,&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 0px 24px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px;padding: 0px;outline: 0px;max-width: 100%;box-sizing: border-box !important;overflow-wrap: break-word !important;visibility: visible;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" mpa-from-tpl="t"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mti9tap9bwj" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;text-align: justify;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 40px 0em 32px;outline: 0px;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 10px 0em 20px;outline: 0px;text-align: left;justify-content: flex-start;display: flex;flex-flow: row;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;padding: 0px 0px 0px 5px;outline: 0px;display: inline-block;width: auto;vertical-align: top;border-left: 5px solid rgb(255, 83, 83);border-bottom-left-radius: 0px;flex: 100 100 0%;height: auto;align-self: flex-start;"><section powered-by="xiumi.us" mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: -2px 0em -3px;outline: 0px;"><section mpa-from-tpl="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;line-height: 1.3;text-align: justify;"><p data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);margin: 0px 0em;outline: 0px;clear: both;min-height: 1em;line-height: 1.75em;"><span data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: ;outline: 0px;"><strong mpa-from-tpl="t" mpa-is-content="t" data-doubao-translate-traverse-mark="1" style="-webkit-tap-highlight-color: rgba(0, 0, 0, 0);outline: 0px;"><span leaf="" style="visibility: visible;justify-content: flex-start;flex-flow: row;vertical-align: top;border-bottom-left-radius: 0px;flex: 100 100 0%;align-self: flex-start;clear: both;min-height: 1em;line-height: 2em;-webkit-tap-highlight-color: ;outline: 0px;" mpa-font-style="mtjy2cz18bk" data-mpa-action-id="mtjy2cz95az" data-pm-slice="0 0 []"><span textstyle="" style="font-size: 15px;letter-spacing: 1px;color: #000000;">问：汽车产业在整个产业中的地位会不会重新被认识？</span></span></strong></span></p></section></section></section></section></section></section></section></section><p style="text-align: justify;margin-bottom: 24px;line-height: 1.75em;"><span mpa-font-style="mtr486le1c82" style="font-size: 15px;"><span mpa-font-style="mtr489ksn8v" style="font-family: mp-quote, -apple-system-font, BlinkMacSystemFont, &quot;Helvetica Neue&quot;, &quot;PingFang SC&quot;, &quot;Hiragino Sans GB&quot;, &quot;Microsoft YaHei UI&quot;, &quot;Microsoft YaHei&quot;, Arial, sans-serif;"><strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">李斌：</span></span></strong><span leaf=""><span textstyle="" style="letter-spacing: 0.5px;">绝对不可撼动。中国汽车产业规模大约11万亿元，影响的就业人数也是非常巨大的，这个产业的地位不可撼动。</span></span></span></span></p><section style="text-align: center;margin-bottom: 0px;margin-top: 32px;" nodeleaf=""><img  data-src="https://static.leiphone.com/uploads/new/images/20261010/6ac9f37defa5b.png" class="rich_pages wxw-img" data-ratio="1.228" data-s="300,640" data-type="png" data-w="1000" style="width: 100%;background-color: transparent;" data-croporisrc="