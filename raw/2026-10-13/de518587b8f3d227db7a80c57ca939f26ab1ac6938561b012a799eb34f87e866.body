quot;:false}" data-lark-record-format="docx/text"></span><span data-mpa-action-id="mottit0p1adr"></span><span data-lark-record-data="{&quot;rootId&quot;:&quot;HiT6dR6bqoegBFxS6Ztci0eLn5e&quot;,&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;前Covariant AI 副总裁、舟谱数据CTO慕巍博士出任「枢途科技」CTO。&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+15&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7538706056718925852&quot;]},&quot;nextNum&quot;:1}},&quot;type&quot;:&quot;text&quot;,&quot;referenceRecordMap&quot;:{},&quot;extra&quot;:{&quot;channel&quot;:&quot;saas&quot;,&quot;isEqualBlockSelection&quot;:false,&quot;pasteRandomId&quot;:&quot;dfd888fd-3d05-41de-99ef-9e50f4d1eda1&quot;,&quot;mention_page_title&quot;:{},&quot;external_mention_url&quot;:{}},&quot;isKeepQuoteContainer&quot;:false,&quot;isFromCode&quot;:false,&quot;selection&quot;:[{&quot;id&quot;:37,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:3,&quot;end&quot;:44},&quot;recordId&quot;:&quot;HCUjdyERwog1txxNzqYcmirnnBh&quot;}],&quot;payloadMap&quot;:{},&quot;isCut&quot;:false}" data-lark-record-format="docx/text"></span><span data-mpa-action-id="mnzfe1dlmiz"></span><span data-mpa-action-id="mn32l2a062f"></span><span data-mpa-action-id="mmos90171jtf"></span><span data-lark-record-data="{&quot;rootId&quot;:&quot;AzjmduHCvoPVEexzmhKc7S4Enkg&quot;,&quot;text&quot;:{&quot;initialAttributedTexts&quot;:{&quot;text&quot;:{&quot;0&quot;:&quot;联创团队刚刚亮相，这家物理AI创业公司的融资与股东阵容也随之浮出水面。&quot;},&quot;attribs&quot;:{&quot;0&quot;:&quot;*0+z&quot;}},&quot;apool&quot;:{&quot;numToAttrib&quot;:{&quot;0&quot;:[&quot;author&quot;,&quot;7536161670281445404&quot;]},&quot;nextNum&quot;:1}},&quot;type&quot;:&quot;text&quot;,&quot;referenceRecordMap&quot;:{},&quot;extra&quot;:{&quot;channel&quot;:&quot;saas&quot;,&quot;isEqualBlockSelection&quot;:true,&quot;pasteRandomId&quot;:&quot;3ca65e27-5613-4c71-bec7-02bc36dcc7df&quot;,&quot;mention_page_title&quot;:{},&quot;external_mention_url&quot;:{}},&quot;isKeepQuoteContainer&quot;:false,&quot;isFromCode&quot;:false,&quot;selection&quot;:[{&quot;id&quot;:5,&quot;type&quot;:&quot;text&quot;,&quot;selection&quot;:{&quot;start&quot;:0,&quot;end&quot;:35},&quot;recordId&quot;:&quot;CuIcdfeCnoYDRFxT9eIcwHljn3Q&quot;}],&quot;payloadMap&quot;:{},&quot;isCut&quot;:false}" data-lark-record-format="docx/text"></span><section style="text-align: left;margin-bottom: 0px;margin-top: 0px;"><span leaf=""><br/></span></section></section></section><p yb-mpa-mark="mark-main-text" style="font-size: 14px;color: rgb(0, 0, 0);line-height: 25px;word-break: break-word;margin-bottom: 0px;margin-top: 0px;" data-mid=""><span style="font-family: Optima-Regular, PingFangTC-light;" data-pm-slice="1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-template&quot;:&quot;t&quot;,&quot;mpa-data-temp-power-by&quot;:&quot;yiban.io&quot;,&quot;mpa-data-temp-type&quot;:&quot;image&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;,&quot;data-mpa-action-id&quot;:&quot;mbgaxk84ewm&quot;,&quot;data-pm-slice&quot;:&quot;5 1 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;width: 100%;display: flex;justify-content: center;align-items: center;padding: 0px 14px 0px 14px;&quot;,&quot;data-mid&quot;:&quot;&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;width: 100%;&quot;,&quot;data-mid&quot;:&quot;&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;width: 100%;background: #F6F8FF;padding: 20px 12px 12px 12px;&quot;,&quot;data-mid&quot;:&quot;&quot;,&quot;mpa-from-tpl&quot;:&quot;t&quot;,&quot;data-mpa-action-id&quot;:&quot;mbgdp4b11wn2&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;yb-mpa-mark&quot;:&quot;mark-main-text&quot;,&quot;style&quot;:&quot;font-size: 14px;color: #000000;line-height: 25px;word-break: break-word;&quot;,&quot;data-mid&quot;:&quot;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]"><span style="color: #888888;font-weight: normal;font-family: Arial, Helvetica, sans-serif;" mpa-font-style="mm0fhbt510oy"><span leaf="">&nbsp; &nbsp; 编辑丨李希</span></span></span></p><p yb-mpa-mark="mark-main-text" style="font-size: 14px;color: rgb(0, 0, 0);line-height: 25px;word-break: break-word;text-align: right;margin: 0px 16px;" data-mid=""><strong style="-webkit-tap-highlight-color: transparent;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;font-family: Optima-Regular, PingFangTC-light;box-sizing: border-box !important;overflow-wrap: break-word !important;" mpa-from-tpl="t" data-mpa-action-id="mc1ad7ht254l"><strong style="-webkit-tap-highlight-color: transparent;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;" mpa-from-tpl="t"><span data-pm-slice="2 2 [&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin: 0px 16px;padding: 0px;outline: 0px;max-width: 100%;clear: both;min-height: 1em;color: rgba(0, 0, 0, 0.9);font-family: \&quot;PingFang SC\&quot;, system-ui, -apple-system, BlinkMacSystemFont, \&quot;Helvetica Neue\&quot;, \&quot;Hiragino Sans GB\&quot;, \&quot;Microsoft YaHei UI\&quot;, \&quot;Microsoft YaHei\&quot;, Arial, sans-serif;font-size: 17px;font-style: normal;font-variant-ligatures: normal;font-variant-caps: normal;font-weight: 400;letter-spacing: 0.544px;orphans: 2;text-align: justify;text-indent: 0px;text-transform: none;widows: 2;word-spacing: 0px;-webkit-text-stroke-width: 0px;white-space: normal;text-decoration-thickness: initial;text-decoration-style: initial;text-decoration-color: initial;background-color: rgb(255, 255, 255);line-height: normal;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;node&quot;,{&quot;tagName&quot;:&quot;strong&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;-webkit-tap-highlight-color: transparent;margin-top: 0px;margin-bottom: 0px;padding: 0px;outline: 0px;font-weight: bolder;max-width: 100%;letter-spacing: 0.544px;font-size: 14px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]" style="-webkit-tap-highlight-color: transparent;padding: 0px;outline: 0px;max-width: 100%;letter-spacing: 0.5px;visibility: visible;box-sizing: border-box !important;overflow-wrap: break-word !important;"><span leaf="">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;</span></span></strong></strong></p></section></section></section></section><section data-mpa-action-id="mv1wly5m879" data-pm-slice="0 0 []"><section style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">为深入贯彻落实工业和信息化部、国务院国资委《</span><span class="js_darkmode__text__10"><span leaf="" class="js_darkmode__text__11" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">2026年度人形机器人与具身智能实景实训专项行动》部署，加快推动我国机器人与具身智能技术创新突破与规模化落地，国际具身智能技能大赛检阅赛将于2026年10月23日至25日在上海举行。大赛以「劳动最光荣，选最能干活的机器劳模」为口号，坚持产业出题、科技答题，着力打造全国具身智能领域实景实战示范平台，形成可复制、可推广的上海实景实训示范样板。</span></span></section><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" class="js_darkmode__text__13"><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__15"><span leaf="" class="js_darkmode__text__16" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">本次</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__19"><span leaf="" class="js_darkmode__text__20" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">大会</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__23"><span leaf="" class="js_darkmode__text__24" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">坚持以赛带会、</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__27"><span leaf="" class="js_darkmode__text__28" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">以会促</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__31"><span leaf="" class="js_darkmode__text__32" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">研</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__35"><span leaf="" class="js_darkmode__text__36" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">、</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__39"><span leaf="" class="js_darkmode__text__40" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">以会促产，突出实景实训、真抓实干定位，构建「训</span></span></span><span class="js_darkmode__text__42"><span leaf="" class="js_darkmode__text__43" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">—赛—产—融」产业闭环。基于工信部面向全国征集的千余条具身智能应用场景数据，大赛设置<span textstyle="" style="color: #4499E7; font-weight: bold">生产制造、检测分析、维修维护、仓储物流、餐饮零售、医疗康养、安全生产、应急救援、文旅宣教</span>9大赛道、23个赛项，</span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__46"><span leaf="" class="js_darkmode__text__47" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">计划</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__50"><span leaf="" class="js_darkmode__text__51" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">汇聚竞赛队伍</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__54"><span leaf="" class="js_darkmode__text__55" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">千</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__58"><span leaf="" class="js_darkmode__text__59" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">余支。</span></span></span><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><br/></span></p><section style="text-align: center;margin: 16px 16px 24px;line-height: 1.75em;" nodeleaf="" data-mpa-action-id="mv3wl1bk1e6w"><img  data-src="https://static.leiphone.com/uploads/new/images/20261012/6accea8c517aa.png" alt="图片" class="rich_pages wxw-img" data-ratio="0.5625" data-s="300,640" data-type="png" data-w="576" style="border-radius: 3px;background-color: transparent;width: 100%;visibility: visible !important;" type="block" data-backw="546" data-backh="307" data-imgfileid="100199121" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261012/6accea8c517aa.png?imageMogr2/quality/90"/></section><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" class="js_darkmode__text__61"><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__63"><span leaf="" class="js_darkmode__text__64" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">大赛坚持「真实场景为赛场、真实岗位任务为赛题、真实作业数据为成绩依据」，统一采用「任务执行、具身数据采集与回流、自主智能、创新能力」四模块百分制测评框架，按人形、四足、轮式</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__67"><span leaf="" class="js_darkmode__text__68" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">等</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__71"><span leaf="" class="js_darkmode__text__72" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">本体形态及自主、遥操两种作业模式设置差异化折算系数，确保不同技术路线队伍横向可比、公平竞技。评审方面，组建具身智能科学家评审团、人工智能技术专家团、技能大师</span></span></span><span class="js_darkmode__text__74"><span leaf="" class="js_darkmode__text__75" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">/实景场景代表</span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__78"><span leaf="" class="js_darkmode__text__79" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">评审团三元交叉评审体系，从严守牢安全底线，确保评审权威公正。</span></span></span></p><section style="text-align: center;margin: 16px 16px 24px;line-height: 1.75em;" nodeleaf="" data-mpa-action-id="mv3wl3nj1mdo"><img  data-src="https://static.leiphone.com/uploads/new/images/20261012/6accea8c9b5c2.png" alt="图片" class="rich_pages wxw-img" data-ratio="0.6666666666666666" data-s="300,640" data-type="png" data-w="576" style="border-radius: 3px;background-color: transparent;width: 100%;visibility: visible !important;" type="block" data-backw="546" data-backh="364" data-imgfileid="100199122" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261012/6accea8c9b5c2.png?imageMogr2/quality/90"/></section><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" class="js_darkmode__text__81"><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__83"><span leaf="" class="js_darkmode__text__84" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">大赛设置一、二、三等奖及单项奖。</span></span></span><span class="js_darkmode__text__86"><span leaf="" class="js_darkmode__text__87" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">23个赛项每项设<span textstyle="" style="color: #4499E7; font-weight: bold">一等奖1名（奖金10000元）、二等奖2名（奖金各5000元）、三等奖3名（奖金各3000元）</span>，另设单项奖若干，重点奖励在技术创新、场景落地等方面表现突出的赛队。大赛同步强化产融联动，重点邀请世界知名学府研究团队及海外具身智能创新创业团队参赛，获奖团队可获千万级意向投资额及全程专业融资辅导，实现「以赛促产、以赛促融、以赛促引」。赛队一次参赛即可贯通10月GDPS秋季大会、12月迪拜中东人工智能展、2027年7月世界人工智能大会（WAIC）三大节点，形成「亮相—出海—落地」完整闭环。</span></span></p><section style="text-align: center;margin: 16px 16px 24px;line-height: 1.75em;" nodeleaf="" data-mpa-action-id="mv3wl67e1ljm"><img  data-src="https://static.leiphone.com/uploads/new/images/20261012/6accea8cf2252.png" alt="图片" class="rich_pages wxw-img" data-ratio="0.6666666666666666" data-s="300,640" data-type="png" data-w="576" style="border-radius: 3px;background-color: transparent;width: 100%;visibility: visible !important;" type="block" data-backw="546" data-backh="364" data-imgfileid="100199123" data-aistatus="1"  src="https://static.leiphone.com/uploads/new/images/20261012/6accea8cf2252.png?imageMogr2/quality/90"/></section><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" class="js_darkmode__text__89"><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__91"><span leaf="" class="js_darkmode__text__92" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">赛事采用分阶段推进机制：</span></span></span></p><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" class="js_darkmode__text__89"><span class="js_darkmode__text__94"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">▪&nbsp;</span></span><span leaf="" class="js_darkmode__text__95" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">9月30日</span></span><span leaf="" class="js_darkmode__text__95" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">前（</span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__91"><span leaf="" class="js_darkmode__text__92" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;" data-pm-slice="1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-action-id&quot;:&quot;mv1wly5m879&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null},&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;&quot;,&quot;class&quot;:&quot;js_darkmode__text__89&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null},&quot;node&quot;,{&quot;tagName&quot;:&quot;font&quot;,&quot;attributes&quot;:{&quot;face&quot;:&quot;方正仿宋_GB2312&quot;,&quot;class&quot;:&quot;js_darkmode__text__90&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;node&quot;,{&quot;tagName&quot;:&quot;span&quot;,&quot;attributes&quot;:{&quot;class&quot;:&quot;js_darkmode__text__91&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]"><span textstyle="" style="color: #4499E7; font-weight: bold">第一阶段</span></span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__91"><span leaf="" class="js_darkmode__text__92" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;" data-pm-slice="1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-action-id&quot;:&quot;mv1wly5m879&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null},&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;&quot;,&quot;class&quot;:&quot;js_darkmode__text__89&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null},&quot;node&quot;,{&quot;tagName&quot;:&quot;font&quot;,&quot;attributes&quot;:{&quot;face&quot;:&quot;方正仿宋_GB2312&quot;,&quot;class&quot;:&quot;js_darkmode__text__90&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;node&quot;,{&quot;tagName&quot;:&quot;span&quot;,&quot;attributes&quot;:{&quot;class&quot;:&quot;js_darkmode__text__91&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]"><span textstyle="" style="color: #4499E7; font-weight: bold">）：</span>完成场景赛题共建，推动企业真实痛点转化为赛题方向；</span></span></span></span></p><section data-mpa-action-id="mv1wly5m879" data-pm-slice="0 0 []"><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" class="js_darkmode__text__89" data-pm-slice="5 4 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-action-id&quot;:&quot;mv1wly5m879&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null}]"><span class="js_darkmode__text__94"><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__91"><span class="js_darkmode__text__94"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;" data-pm-slice="1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-action-id&quot;:&quot;mv1wly5m879&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null},&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;&quot;,&quot;class&quot;:&quot;js_darkmode__text__89&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null},&quot;node&quot;,{&quot;tagName&quot;:&quot;span&quot;,&quot;attributes&quot;:{&quot;class&quot;:&quot;js_darkmode__text__94&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]"><span textstyle="" style="color: #4499E7; font-weight: bold">▪&nbsp;</span></span></span><span leaf="" class="js_darkmode__text__92" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;" data-pm-slice="1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-action-id&quot;:&quot;mv1wly5m879&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null},&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;&quot;,&quot;class&quot;:&quot;js_darkmode__text__89&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null},&quot;node&quot;,{&quot;tagName&quot;:&quot;font&quot;,&quot;attributes&quot;:{&quot;face&quot;:&quot;方正仿宋_GB2312&quot;,&quot;class&quot;:&quot;js_darkmode__text__90&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;},&quot;node&quot;,{&quot;tagName&quot;:&quot;span&quot;,&quot;attributes&quot;:{&quot;class&quot;:&quot;js_darkmode__text__91&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]"><span textstyle="" style="color: #4499E7; font-weight: bold">10月1</span></span></span></span></span><span class="js_darkmode__text__97"><span leaf="" class="js_darkmode__text__98" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">0</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__101"><span leaf="" class="js_darkmode__text__102" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">日前（第二阶段）：</span>模拟产线落地搭建，并开展场景测试与训练；</span></span></span></p><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" class="js_darkmode__text__89" data-pm-slice="5 4 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-action-id&quot;:&quot;mv1wly5m879&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null}]"><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__101"><span class="js_darkmode__text__94"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;" data-pm-slice="1 1 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-action-id&quot;:&quot;mv1wly5m879&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null},&quot;para&quot;,{&quot;tagName&quot;:&quot;p&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;&quot;,&quot;class&quot;:&quot;js_darkmode__text__89&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null},&quot;node&quot;,{&quot;tagName&quot;:&quot;span&quot;,&quot;attributes&quot;:{&quot;class&quot;:&quot;js_darkmode__text__94&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;}]"><span textstyle="" style="color: #4499E7; font-weight: bold">▪&nbsp;</span></span></span><span leaf="" class="js_darkmode__text__102" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #4499E7; font-weight: bold">10月23至10月25日（第三阶段）：</span>正式比赛期，真实检验机器人泛化能力与场景解决方案落地价值。</span></span></span></p><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" class="js_darkmode__text__89" data-pm-slice="5 4 [&quot;para&quot;,{&quot;tagName&quot;:&quot;section&quot;,&quot;attributes&quot;:{&quot;data-mpa-action-id&quot;:&quot;mv1wly5m879&quot;,&quot;data-pm-slice&quot;:&quot;0 0 []&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;data-layout-id&quot;:null}]"><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__101"><span leaf="" class="js_darkmode__text__102" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">赛后，赛事将转入常态化运营，陆续开展实景实训全国仿真赛（2026年11月—2027年2月）、全国实景实训赛（2027年3月—6月），遴选优秀赛队及解决方案推荐至2027年7月WAIC具身展，形成「线上仿真校验、线</span></span></span><span leaf="" class="js_darkmode__text__176" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">下实训</span><span leaf="" class="js_darkmode__text__176" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">转化、订单落地见效、展览展示推广」的长效机制。</span></p></section><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;" class="js_darkmode__text__178"><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__180"><span leaf="" class="js_darkmode__text__181" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">大赛由世界人工智能大会组委会</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__184"><span leaf="" class="js_darkmode__text__185" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">指导</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__188"><span leaf="" class="js_darkmode__text__189" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">，上海市人工智能行业协会、中国电子技术标准化研究院主办，上海张江（集团）有限公司、上海陆家嘴（集团）有限公司联合主办。目前，大赛报名</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__192"><span leaf="" class="js_darkmode__text__193" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">仍</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__196"><span leaf="" class="js_darkmode__text__197" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">在</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__200"><span leaf="" class="js_darkmode__text__201" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">进行中</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__204"><span leaf="" class="js_darkmode__text__205" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">，</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__208"><span leaf="" class="js_darkmode__text__209" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">欢迎</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__212"><span leaf="" class="js_darkmode__text__213" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">全球</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__216"><span leaf="" class="js_darkmode__text__217" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">赛队</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__220"><span leaf="" class="js_darkmode__text__221" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">踊跃</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__224"><span leaf="" class="js_darkmode__text__225" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">报名</span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__228"><span leaf="" class="js_darkmode__text__229" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;">。</span></span></span></p><p style="text-align: justify;margin: 16px;line-height: 1.75em;" class="js_darkmode__text__231" data-mpa-action-id="mv4ojj4l18qz" data-pm-slice="0 0 []"><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__233"><span class="js_darkmode__text__234"><span mpa-font-style="mv4ojj4838l"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888">官方</span></span></span></span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__237" mpa-font-style="mv4ojj488jv"><span leaf="" class="js_darkmode__text__238" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888">报名</span></span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__241" mpa-font-style="mv4ojj481hs3"><span leaf="" class="js_darkmode__text__242" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888">网站</span></span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__245" mpa-font-style="mv4ojj4811my"><span leaf="" class="js_darkmode__text__246" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888">：</span></span></span></span><span class="js_darkmode__text__248"><span class="js_darkmode__text__249"><span class="js_darkmode__text__250"><span mpa-font-style="mv4ojj481mz0"><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888">https://ieic.gdps.org.cn/</span></span></span></span></span></span></p><p style="text-align: justify;margin: 16px;line-height: 1.75em;" class="js_darkmode__text__252"><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__254"><span leaf="" class="js_darkmode__text__255" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888">公众号：</span></span></span></span><span style="font-family:方正仿宋_GB2312"><span class="js_darkmode__text__258"><span leaf="" class="js_darkmode__text__259" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888">全球开发者先锋大会（</span></span></span></span><span class="js_darkmode__text__261"><span leaf="" class="js_darkmode__text__262" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="color: #888888">GDPS）</span></span></span></p><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mv4obg5h13ha"><section data-mpa-template="t" mpa-data-temp-power-by="yiban.io" mpa-from-tpl="t" data-mpa-action-id="mqggjy08r8x"><p style="text-align: justify;margin: 16px 16px 24px;line-height: 1.75em;"><span style="font-family:等线"><strong mpa-from-tpl="t"><span leaf="" data-pm-slice="1 1 [&quot;heading&quot;,{&quot;tagName&quot;:&quot;h3&quot;,&quot;attributes&quot;:{&quot;style&quot;:&quot;text-align: justify; margin: 16px 16px 24px; line-height: 1.75em;&quot;},&quot;namespaceURI&quot;:&quot;http://www.w3.org/1999/xhtml&quot;,&quot;level&quot;:3}]"><span textstyle="" style="letter-spacing: 1px; color: #4499E7; font-weight: bold">▎</span></span><span leaf="" style="text-align: justify;line-height: 1.75em;font-size: 15px;letter-spacing: 0.5px;font-family: Arial, Helvetica, sans-serif;"><span textstyle="" style="letter-spacing: 1px; color: #4499E7">请意向报名赛队的精英们快速浏览详细赛题！</span></span></strong></span></p></section></section><section data-mpa-dynamic-material="t" data-mpa-dynamic-enable-color-list="t" data-mpa-dynamic-zoom="0.85" data-mpa-template="t" data-mpa-dynamic-material-category="clickToExpandSlideSvg" data-mpa-category="动态" mpa-from-tpl="t" style="zoom:0.85;overflow-y:auto;" mpa-data-temp-power-by="yiban.io" mpa-data-temp-type="svg" data-mpa-action-id="mv4o1os31n8o"><span leaf=""><br/></span><section data-mpa-main="" data-mpa-scale="origin" data-mpa-expand-speed="1" data-mpa-image-with-margin="false" data-mpa-button-position="center" data-mpa-button-text="点击查看" style="overflow: hidden;font-size: 1.5em;line-height: 0;pointer-events: auto;user-select: none;-webkit-tap-highlight-color: transparent;visibility: visible;margin: 0px aut